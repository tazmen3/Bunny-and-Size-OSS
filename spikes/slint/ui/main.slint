    close-cache-panel => { root.cache-action(7,root.cache-choice,root.cache-token); root.cache-visible=false; root.ribbon-tab=1; saved-measures-button.focus(); }
    function toggle-cache-panel() {
        if root.cache-visible { root.close-cache-panel(); }
        else { root.cache-visible = true; root.cache-action(0, root.cache-choice, root.cache-token); }
    }
