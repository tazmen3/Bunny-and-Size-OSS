    in-out property <int> ribbon-tab: 0;
    // -1 is an intentionally collapsed command ribbon. Keep a real item
    // around each row: visibility on a layout alone does not clip its children.
    callback activate-ribbon(int);
    activate-ribbon(index) => {
        root.preferences-open = false;
        root.owner-options = false;
        root.ribbon-tab = root.ribbon-tab == index ? -1 : index;
        if index == 0 { navigation-tab.focus(); }
        if index == 1 { analysis-tab.focus(); }
        if index == 2 { display-tab.focus(); }
        if index == 3 { extensions-tab.focus(); }
        if index == 4 { help-tab.focus(); }
    }
    in-out property <int> size-unit-choice: 0;
    callback set-size-unit(int);
    out property <float> size-unit-x: size-unit-picker.absolute-position.x / 1px;
