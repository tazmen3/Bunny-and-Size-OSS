                                if root.duplicate-cross: Text { text: @tr("ui" => "Review"); color: WorkshopTheme.ink; font-weight: 600; width: 50px; overflow: elide; vertical-alignment: center; }
                                Text { text: @tr("ui" => "Group"); color: WorkshopTheme.ink; font-weight: 600; width: 70px; vertical-alignment: center; }
                                if root.duplicate-cross: Text { text: @tr("ui" => "Side"); color: WorkshopTheme.ink; font-weight: 600; width: root.duplicate-mode == 2 ? 66px : 40px; vertical-alignment: center; }
                                if root.duplicate-single: Text { text: @tr("ui" => "File name"); color: WorkshopTheme.ink; font-weight: 600; width: 220px; vertical-alignment: center; }
                                if root.duplicate-cross: ComboBox {
                                    width: 220px;
                                    model: [@tr("ui" => "Identical folders") + " (" + root.duplicate-folder-count + ")", @tr("ui" => "Identical files") + " (" + root.duplicate-file-count + ")"];
