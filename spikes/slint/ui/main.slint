                                        sources: root.duplicate-source-labels; selected-source <=> root.duplicate-source-a; folder <=> root.duplicate-scope-a;
                                        busy: root.search-busy; choosing-folder: root.choosing-folder; browse-enabled: root.folder-picker-enabled;
