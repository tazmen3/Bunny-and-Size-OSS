                                Text { text: @tr("ui" => "Logical size"); color: WorkshopTheme.ink; font-weight: 600; width: 100px; vertical-alignment: center; }
                                Text { text: @tr("ui" => "Verification"); color: WorkshopTheme.ink; font-weight: 600; width: 180px; vertical-alignment: center; }
