    callback workshop-gesture(bool);
    callback workshop-retry();
    callback workshop-ready();
    in property <string> product-version;
    title: "Bunny and Size";
    preferred-width: 1200px; preferred-height: 760px;
    min-width: 780px; min-height: 520px;
    background: WorkshopTheme.alternate;
    in-out property <int> theme-choice: 0;
