                                    root.duplicate-entry-menu(root.duplicate-menu-token, root.search-selected, (live-search-focus.absolute-position.x + 8px) / 1px, (live-search-focus.absolute-position.y + y) / 1px);
                                    return accept;
                                }
                                if event.text == " " && root.duplicate-cross && root.search-selected >= 0 && root.search-selected < root.duplicate-rows.length {
                                    if root.duplicate-rows[root.search-selected].selectable { root.duplicate-toggle-copy(root.search-selected, !root.duplicate-rows[root.search-selected].selected || root.duplicate-rows[root.search-selected].partial); }
                                    return accept;
                                }
                                if event.text == Key.Return {
                                    if root.duplicate-mode > 0 && ((root.duplicate-folder-view && !root.duplicate-folder-detail) || root.duplicate-reference-available) { root.duplicate-open-folder(root.search-selected); }
                                    else { root.search-select(root.search-token,root.search-selected,true); }
                                    return accept;
                                }
                                if event.text == Key.LeftArrow && root.duplicate-mode > 0 && root.duplicate-folder-detail { root.duplicate-category-changed(0); return accept; }
                                if event.text == Key.Escape { root.search-cancel(); return accept; }
                                return reject;
                            }
                            live-search-list := ListView {
                                width: 100%; height: 100%; content-y <=> root.search-scroll-y; content-height: root.search-results.length * root.search-result-row-height;
                                content-width: root.duplicate-mode > 0 ? max(self.visible-width - root.scrollbar-gutter, root.duplicate-single ? 750px : 880px) : max(0px, self.visible-width - root.scrollbar-gutter);
                                horizontal-scrollbar-policy: root.duplicate-mode > 0 ? as-needed : always-off;
                                for item[index] in root.search-results: result-row := Rectangle {
                                    property <DuplicateRow> result: root.duplicate-mode > 0 ? root.duplicate-rows[index] : { };
                                    property <bool> first-file: root.duplicate-mode > 0 ? result.group-first-file
                                        : root.search-duplicates-visible && root.search-group-first[index];
                                    property <int> file-weight: first-file ? 700 : 400;
                                    height: root.search-result-row-height; width: live-search-list.content-width;
                                    background: root.duplicate-mode == 0 && root.search-selected == index ? WorkshopTheme.alternate
                                        : first-file ? WorkshopTheme.duplicate-group-background(result.side)
                                        : WorkshopTheme.duplicate-side-background(result.side);
                                    border-width: root.search-selected == index ? (root.duplicate-mode > 0 && live-search-focus.has-focus ? 2px : 1px) : 0px;
                                    border-color: WorkshopTheme.focus;
                                    accessible-role: button;
                                    accessible-label: root.duplicate-mode > 0
                                        ? self.result.role-label + ", " + self.result.group + ", " + self.result.name + ", " + self.result.name-detail + ", " + self.result.side
                                            + ", " + self.result.scope-label + ", " + self.result.protected-location + ", " + self.result.location
                                            + ", " + self.result.size + ", " + self.result.verification + ", " + self.result.group-note + ", " + self.result.selection-label
                                        : item.label + ", " + item.size;
                                    accessible-action-default => {
                                        root.search-select(root.search-token,index,false);
                                        if root.duplicate-mode > 0 && root.duplicate-folder-view && !root.duplicate-folder-detail { root.duplicate-open-folder(index); }
                                    }
                                    // Keep the location tooltip above the row's input surface so it can observe hover.
                                    TouchArea {
                                        property <bool> left-press: false;
                                        property <bool> menu-press: false;
                                        property <int> menu-token;
                                        x: root.duplicate-cross ? 56px : 0px;
                                        width: parent.width - self.x;
                                        clicked => {
                                            if self.left-press {
                                                root.search-select(root.search-token,index,false); live-search-focus.focus();
                                                if root.duplicate-mode > 0 && root.duplicate-folder-view && !root.duplicate-folder-detail { root.duplicate-open-folder(index); }
                                            }
                                        }
                                        pointer-event(event) => {
                                            if event.kind == PointerEventKind.down {
                                                self.left-press = event.button == PointerEventButton.left;
                                                if root.desktop-entry-menu && root.search-duplicates-visible && (!root.duplicate-folder-view || root.duplicate-folder-detail) && event.button == PointerEventButton.right {
                                                    self.menu-press = true;
                                                    self.menu-token = root.duplicate-menu-token;
                                                }
                                            }
                                            if event.button == PointerEventButton.left {
                                                if event.kind == PointerEventKind.down { root.workshop-gesture(true); }
                                                else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.workshop-gesture(false); }
                                            }
                                            if self.menu-press && (event.kind == PointerEventKind.cancel || (event.button == PointerEventButton.right && event.kind == PointerEventKind.up)) {
                                                self.menu-press = false;
                                                if event.kind == PointerEventKind.up && self.menu-token == root.duplicate-menu-token && self.mouse-x >= 0px && self.mouse-x < self.width && self.mouse-y >= 0px && self.mouse-y < self.height {
                                                    live-search-focus.focus();
                                                    root.duplicate-entry-menu(self.menu-token, index, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
                                                }
                                            }
                                        }
                                    }
                                    if root.duplicate-mode > 0: HorizontalLayout {
                                        spacing: 6px;
                                        if root.duplicate-cross: Rectangle {
                                            width: 50px;
                                            if result.protected: Rectangle {
                                                x: 12px; y: (parent.height - self.height) / 2;
                                                width: 25px; height: 23px; border-radius: 4px;
                                                background: WorkshopTheme.protected-reference;
                                                DuplicateLock { x: 6.5px; y: 5px; }
                                            }
                                            if result.selectable: CheckBox {
                                                width: 100%; height: 100%;
                                                text: result.partial ? "−" : "";
                                                checked: result.selected;
                                                enabled: root.duplicate-selection-ready && !root.search-busy;
                                                accessible-label: result.selection-label + (result.partial ? " · " + @tr("ui" => "Partly selected") : "");
                                                toggled => { root.search-select(root.search-token, index, false); live-search-focus.focus(); root.duplicate-toggle-copy(index, self.checked || result.partial); }
                                            }
                                        }
                                        Text { text: result.group; color: WorkshopTheme.ink; width: 70px; font-weight: result-row.first-file ? result-row.file-weight : result.group-start ? 600 : 400; overflow: elide; vertical-alignment: center; }
                                        if root.duplicate-cross: Text { text: result.side; color: WorkshopTheme.ink; width: root.duplicate-mode == 2 ? 66px : 40px; font-size: 12px; font-weight: result-row.file-weight; vertical-alignment: center; }
                                        VerticalLayout {
                                            width: 220px; alignment: center; padding-left: result.copy ? 12px : 0px;
                                            if result.role-label != "": Text {
                                                text: result.role-label; color: WorkshopTheme.ink; font-size: 12px;
                                                font-weight: result.protected ? 700 : result-row.file-weight; overflow: elide;
                                            }
                                            Text { text: result.name; color: WorkshopTheme.ink; font-weight: result-row.file-weight; overflow: elide; }
                                            if result.name-detail != "": Text {
                                                text: result.name-detail; color: WorkshopTheme.ink; font-size: 12px; font-weight: result-row.file-weight; overflow: elide;
                                            }
                                        }
                                        Rectangle {
                                            min-width: 0px; horizontal-stretch: 1; vertical-stretch: 1;
                                            Tooltip {
                                                VerticalLayout {
                                                    property <length> tooltip-width: min(600px, root.width - 32px);
                                                    width: tooltip-width;
                                                    height: location-tooltip-text.preferred-height + 16px;
                                                    padding: 8px;
                                                    location-tooltip-text := Text {
                                                        text: result.protected-location == "" ? result.location
                                                            : result.protected-location + "\n" + result.location;
                                                        color: WorkshopTheme.ink;
                                                        wrap: char-wrap;
                                                        // Size the popup for the wrapped text, not its unwrapped line.
                                                        preferred-width: parent.tooltip-width - 16px;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                width: 100%; height: 100%; alignment: center;
                                                if result.protected-location != "": Rectangle {
                                                    height: 17px; background: WorkshopTheme.protected-reference; border-radius: 3px;
                                                    DuplicateLock { x: 4px; y: 2px; }
                                                    Text {
                                                        x: 21px; width: parent.width - self.x - 3px; height: 100%;
                                                        text: result.protected-location; color: white; font-size: 12px; font-weight: result-row.file-weight; overflow: elide; vertical-alignment: center;
                                                    }
                                                }
                                                if result.scope-label != "": Text { text: result.scope-label; color: WorkshopTheme.ink; font-size: 12px; font-weight: result-row.file-weight; overflow: elide; }
                                                Text { text: result.location; color: WorkshopTheme.ink; overflow: elide; font-size: 13px; font-weight: result-row.file-weight; }
                                            }
                                        }
                                        Text { text: result.size; color: WorkshopTheme.ink; width: 100px; font-weight: result-row.file-weight; vertical-alignment: center; }
                                        VerticalLayout {
                                            width: 180px; alignment: center;
                                            Text { text: (result.partial ? @tr("ui" => "Partly selected") + " · " : "") + result.verification; color: WorkshopTheme.ink; font-size: 12px; font-weight: result-row.file-weight; overflow: elide; }
                                            if result.group-note != "": Text {
                                                text: result.group-note; color: WorkshopTheme.ink; font-size: 11px;
                                                wrap: word-wrap; overflow: elide; font-weight: result-row.first-file ? result-row.file-weight : 600;
                                            }
                                        }
                                    }
                                    if root.duplicate-mode > 0 && result.group-start: Rectangle {
                                        x: 0px; y: 0px; width: 100%; height: 1px;
                                        background: WorkshopTheme.border;
                                    }
                                    if root.duplicate-mode == 0: HorizontalLayout {
                                        spacing: 5px;
                                        Text { text: item.label; color: WorkshopTheme.ink; font-weight: result-row.file-weight; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                        Text { text: item.size; color: WorkshopTheme.ink; width: 100px; font-weight: result-row.file-weight; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        if !root.search-statistics-visible && root.duplicate-mode == 0: LineEdit { text: root.search-full-path; read-only: true; accessible-label: @tr("ui" => "Full path"); }
                        live-search-pagination := HorizontalLayout {
                            visible: !root.search-statistics-visible;
                            min-height: root.search-statistics-visible ? 0px : 32px;
                            preferred-height: 32px;
                            max-height: root.search-statistics-visible ? 0px : self.preferred-height;
                            vertical-stretch: 0; spacing: 6px;
                            LineEdit { visible: root.duplicate-mode > 0; min-width: root.duplicate-mode > 0 ? 60px : 0px; max-width: root.duplicate-mode > 0 ? 100000px : 0px; horizontal-stretch: 1; text: root.search-full-path; read-only: true; accessible-label: @tr("ui" => "Full path"); }
                            Button { horizontal-stretch: 0; text: @tr("ui" => "Previous"); enabled: root.search-previous; clicked => { root.search-page(root.search-token,false); } }
                            Button { horizontal-stretch: 0; text: @tr("ui" => "Next"); enabled: root.search-next; clicked => { root.search-page(root.search-token,true); } }
                            if root.duplicate-cross && (root.duplicate-folder-view || root.duplicate-reference-available): Button {
                                horizontal-stretch: 0;
                                text: root.duplicate-folder-detail ? @tr("ui" => "Collapse folder") : root.duplicate-folder-view ? @tr("ui" => "Expand folder") : root.duplicate-reference-label;
                                enabled: root.duplicate-folder-detail || root.search-selected >= 0;
                                clicked => {
                                    if root.duplicate-folder-detail { root.duplicate-category-changed(0); }
                                    else { root.duplicate-open-folder(root.search-selected); }
                                }
                            }
                            if root.duplicate-mode == 0: Button { horizontal-stretch: 0; text: @tr("ui" => "Reveal in table"); enabled: root.search-selected >= 0 && root.duplicate-reveal-allowed; clicked => { root.search-select(root.search-token,root.search-selected,true); } }
                        }
                    }
                    VerticalLayout {
                        padding: root.compact-view ? 6px : 8px; spacing: root.compact-view ? 2px : 6px;
                        visible: !root.search-visible && !root.smb-server-visible;
                        HorizontalLayout {
                        Text { horizontal-stretch:1; overflow:elide; text: @tr("ui" => "FOLDER CONTENTS · ") + (root.sort-order < 0 ? root.view-warning : @tr("ui" => "Sort: ") + [@tr("ui" => "Size ↓"), @tr("ui" => "Size ↑"), @tr("ui" => "Name ↑"), @tr("ui" => "Name ↓"), @tr("ui" => "Allocated ↓"), @tr("ui" => "Allocated ↑"), @tr("ui" => "Owner ↑"), @tr("ui" => "Owner ↓"), @tr("ui" => "Modified newest"), @tr("ui" => "Modified oldest"), @tr("ui" => "Accessed newest"), @tr("ui" => "Accessed oldest")][max(0, root.sort-order)]); color: WorkshopTheme.ink; font-size: 11px; font-weight: 600; }
                        // Code-drawn icons remain sharp at every scale and follow the theme.
                        Rectangle {
                            min-width:20px;max-width:20px;
                            Rectangle {
                                width:20px;height:20px;y:(parent.height - self.height)/2;
                                if root.treemap-mode==0:Rectangle {
                                    Rectangle{x:1px;y:1px;width:8px;height:11px;background:WorkshopTheme.ink;}
                                    Rectangle{x:1px;y:14px;width:8px;height:5px;background:WorkshopTheme.ink;}
                                    Rectangle{x:11px;y:1px;width:8px;height:6px;background:WorkshopTheme.ink;}
                                    Rectangle{x:11px;y:9px;width:8px;height:10px;background:WorkshopTheme.ink;}
                                }
                                if root.treemap-mode==1:Rectangle {
                                    for i in 3:Rectangle{x:1px;y:1px+i*7px;width:18px;height:4px;background:WorkshopTheme.ink;}
                                }
                            }
                        }
                        treemap-selector := ComboBox {
                            // Keep the native text/arrow size; the heading owns spare width.
                            horizontal-stretch: 0; max-width: self.preferred-width;
                            model: [@tr("ui" => "Mosaic"), @tr("ui" => "Bands")];
                            current-index <=> root.treemap-mode;
                            accessible-label: @tr("ui" => "Folder contents view");
                            selected => { root.set-treemap-mode(self.current-index); }
                            Tooltip { Rectangle {width:400px;background:WorkshopTheme.surface;border-width:1px;border-color:WorkshopTheme.border;VerticalLayout{padding:8px;Text{text:@tr("ui"=>"Change the view without scanning again");color:WorkshopTheme.ink;wrap:word-wrap;}}}}
                        }
                        }
                        if root.current-folder-summary-text != "": Text {
                            text: root.current-folder-summary-text;
                            color: WorkshopTheme.ink; font-size: 13px; wrap: word-wrap;
                        }
                        if root.workshop-live && root.workshop-scope-detail != "": LineEdit {
                            text: root.workshop-scope-detail;
                            read-only: true;
                            accessible-label: root.workshop-scope-detail;
                        }
                        Text { visible:!root.compact-view;min-height:0px;max-height:root.compact-view ? 0px : 100000px; text: root.selection-summary == "" ? @tr("ui" => "No folder selected") : root.selection-summary; color: WorkshopTheme.ink; font-size: 13px; wrap: word-wrap; }
                        HorizontalLayout {
                            visible:!root.compact-view;min-height:0px;max-height:root.compact-view ? 0px : 24px;
                            Text { text: @tr("ui" => "TREEMAP · LOGICAL SIZE"); color: WorkshopTheme.ink; font-size: 11px; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: @tr("ui" => "Arrows · Enter · Backspace"); color: WorkshopTheme.ink; font-size: 10px; }
                        }
                        map-area := Rectangle {
                            changed visible => { root.refresh-map-hover(); }
                            visible: !root.compact-view || root.treemap-expanded;
                            min-height: root.compact-view && !root.treemap-expanded ? 0px : 80px;
                            preferred-height: !self.visible ? 0px : root.treemap-height-choice > 0
                                ? root.treemap-height-choice * 1px : root.compact-view ? 80px : root.automatic-treemap-height;
                            max-height: root.treemap-height-choice > 0 || root.compact-view ? self.preferred-height : 230px;
                            vertical-stretch: 0; background: WorkshopTheme.alternate; clip: true;
                            accessible-role: groupbox; accessible-label: @tr("ui" => "Treemap of observed logical sizes");
                            map-focus := FocusScope {
                                width: 100%; height: 100%;
                                accessible-role: groupbox;
                                accessible-label: root.tiles.length > 0 ? root.tiles[root.map-cursor].name + ", " + root.tiles[root.map-cursor].size : @tr("ui" => "No measured area");
                                key-pressed(event) => {
                                    if event.text == Key.RightArrow || event.text == Key.DownArrow {
                                        root.map-cursor = mod(root.map-cursor + 1, max(1, root.tiles.length));
                                        return accept;
                                    }
                                    if event.text == Key.LeftArrow || event.text == Key.UpArrow {
                                        root.map-cursor = mod(root.map-cursor + max(1, root.tiles.length) - 1, max(1, root.tiles.length));
                                        return accept;
                                    }
                                    if event.text == Key.Return || event.text == Key.Space {
                                        root.activate-tile(root.map-cursor); return accept;
                                    }
                                    if event.text == Key.Backspace { root.go-parent(); return accept; }
                                    return reject;
                                }
                                for tile[index] in root.tiles: TreemapTile {
                                    x: parent.width * (root.treemap-mode==0 ? tile.x : tile.band-x); y: root.treemap-mode==0 ? parent.height*tile.y : 0px;
                                    width: parent.width*(root.treemap-mode==0 ? tile.w : tile.band-w); height: root.treemap-mode==0 ? parent.height*tile.h : parent.height;
                                    tile: tile; inspected: tile.node-id >= 0 && tile.node-id == root.inspected-node;
                                    focused: map-focus.has-focus && root.map-cursor == index;
                                    activate => { root.map-cursor = index; map-focus.focus(); root.activate-tile(index); }
                                }
                                if root.tiles.length == 0: Text {
                                    text: @tr("ui" => "No measured area"); color: WorkshopTheme.ink; horizontal-alignment: center; vertical-alignment: center;
                                }
                                // One exact hit surface covers all rendered tiles, including 1px
                                // strips. Moving only updates hover state, never the layout.
                                map-pointer := TouchArea {
                                    width: 100%; height: 100%;
                                    mouse-cursor: root.map-hover-index >= 0 ? pointer : default;
                                    // moved() is a drag callback in Slint. Coordinate
                                    // notifications also cover motion with no button held.
                                    changed mouse-x => { root.update-map-pointer(); }
                                    changed mouse-y => { root.update-map-pointer(); }
                                    changed has-hover => { root.update-map-pointer(); }
                                    clicked => {
                                        root.map-hover(self.mouse-x / 1px, self.mouse-y / 1px, self.has-hover);
                                        if root.map-hover-index >= 0 {
                                            root.map-cursor = root.map-hover-index;
                                            map-focus.focus();
                                            root.activate-tile(root.map-hover-index);
                                        }
                                    }
                                }
                            }
                        }
                        if map-focus.has-focus && root.tiles.length > 0: Text {
                            text: root.tiles[root.map-cursor].name + " · " + root.tiles[root.map-cursor].size;
                            color: WorkshopTheme.ink; font-size: 12px; overflow: elide;
                        }
                        if !root.compact-view || root.treemap-expanded: Text { text: root.treemap-note; color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap; }
                        treemap-divider := Rectangle {
                            visible: map-area.visible;
                            height: self.visible ? 12px : 0px;
                            // Limit input with the space already allocated to the map and table.
                            // Layout itself enforces both minima when the window shrinks.
                            property <length> maximum: max(80px, map-area.height + detail-columns.height - detail-columns.min-height);
                            function resize(height: length) {
                                root.set-treemap-height(round(clamp(height, 80px, self.maximum) / 1px));
                            }
                            background: map-divider-touch.has-hover || map-divider-focus.has-focus ? WorkshopTheme.alternate : WorkshopTheme.surface;
                            border-color: WorkshopTheme.focus;
                            border-width: map-divider-focus.has-focus ? 1px : 0px;
                            accessible-role: slider;
                            accessible-label: @tr("ui" => "Resize the treemap and file list. Use Up and Down arrows or Enter to reset.");
                            accessible-orientation: vertical;
                            accessible-value: root.map-height;
                            accessible-value-minimum: 80;
                            accessible-value-maximum: self.maximum / 1px;
                            accessible-value-step: 20;
                            accessible-action-set-value(value) => { if value.is-float() { self.resize(value.to-float() * 1px); } }
                            accessible-action-increment => { self.resize(map-area.height + 20px); }
                            accessible-action-decrement => { self.resize(map-area.height - 20px); }
                            forward-focus: map-divider-focus;
                            Rectangle { x: parent.width * 0.35; y: 5px; width: 30%; height: 2px; background: #708ba2; }
                            map-divider-focus := FocusScope {
                                width: 100%; height: 100%; enabled: treemap-divider.visible;
                                key-pressed(event) => {
                                    if event.text == Key.UpArrow { treemap-divider.resize(map-area.height - 20px); return accept; }
                                    if event.text == Key.DownArrow { treemap-divider.resize(map-area.height + 20px); return accept; }
                                    if event.text == Key.Home { treemap-divider.resize(80px); return accept; }
                                    if event.text == Key.End { treemap-divider.resize(treemap-divider.maximum); return accept; }
                                    if event.text == Key.Return { root.set-treemap-height(0); return accept; }
                                    return reject;
                                }
                            }
                            map-divider-touch := TouchArea {
                                mouse-cursor: ns-resize;
                                property <length> start-height;
                                property <length> start-y;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        self.start-height = map-area.height;
                                        self.start-y = self.absolute-position.y + self.mouse-y;
                                        map-divider-focus.focus();
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        treemap-divider.resize(self.start-height + self.absolute-position.y + self.mouse-y - self.start-y);
                                    }
                                }
                            }
                        }
                        // One horizontal viewport owns both header and rows. The inner
                        // ListView retains vertical virtualization and 34px reveal offsets.
                        detail-columns := ScrollView {
                            min-width: 0px;
                            // Reserve the header, its gap, and one full row above the scrollbar.
                            min-height: 34px + 6px + 34px + root.scrollbar-gutter;
                            preferred-height: self.min-height; vertical-stretch: 1;
                            content-width: max(self.visible-width, root.table-width + root.scrollbar-gutter);
                            content-height: self.visible-height;
                            vertical-scrollbar-policy: always-off;
                            Rectangle {
                                width: detail-columns.content-width;
                                height: max(0px, detail-columns.visible-height - root.scrollbar-gutter);
                                VerticalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        height: 34px;
                                        HorizontalLayout {
                                            x: 0px; height: 34px; width: root.table-width; padding-left: 2px; padding-right: 0px; spacing: 6px;
                                            Button { text: @tr("ui" => "Name") + (root.sort-order == 2 ? " ↑" : root.sort-order == 3 ? " ↓" : ""); width: root.column-settings[0].pixels * 1px; enabled: !root.busy && root.sort-order >= 0; clicked => { root.sort-details(true); } }
                                            if root.column-settings[1].shown: Button { text: @tr("ui" => "Size") + (root.sort-order == 0 ? " ↓" : root.sort-order == 1 ? " ↑" : ""); width: root.column-settings[1].pixels * 1px; enabled: !root.busy && root.sort-order >= 0; clicked => { root.sort-details(false); } }
                                            if root.column-settings[2].shown: Button {
                                                text: @tr("ui" => "Allocated / Per path") + (root.sort-order == 4 ? " ↓" : root.sort-order == 5 ? " ↑" : "");
                                                width: root.column-settings[2].pixels * 1px; enabled: root.allocation-sort-available && !root.busy && root.sort-order >= 0;
                                                clicked => { root.sort-allocated(); }
                                            }
                                            if root.column-settings[3].shown: Button {
                                                text: @tr("ui" => "Owner") + (root.sort-order == 6 ? " ↑" : root.sort-order == 7 ? " ↓" : "");
                                                width: root.column-settings[3].pixels * 1px; enabled: root.owner-sort-available && !root.owner-sort-preparing && !root.busy && root.sort-order >= 0;
                                                accessible-label: @tr("ui" => "Sort owners; apply names available at this time");
                                                clicked => { root.sort-owner(); }
                                            }
                                            if root.column-settings[4].shown: Text { text: @tr("ui" => "Folder share"); color: WorkshopTheme.ink; width: root.column-settings[4].pixels * 1px; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            if root.column-settings[5].shown: Text { text: @tr("ui" => "Recursive\nfiles"); color: WorkshopTheme.ink; width: root.column-settings[5].pixels * 1px; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                            if root.column-settings[6].shown: Text { text: @tr("ui" => "Recursive\nfolders"); color: WorkshopTheme.ink; width: root.column-settings[6].pixels * 1px; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                            if root.column-settings[7].shown: Text { text: @tr("ui" => "Type / status"); color: WorkshopTheme.ink; width: root.column-settings[7].pixels * 1px; font-size: 11px; vertical-alignment: center; }
                                            if root.column-settings[8].shown: Button {
                                                text: root.modified-heading; width: root.column-settings[8].pixels * 1px;
                                                accessible-label: root.modified-heading + @tr("ui" => "; sort newest to oldest, then reverse");
                                                enabled: root.sort-order >= 0; clicked => { root.sort-dates(false); }
                                            }
                                            if root.column-settings[9].shown: Button {
                                                text: root.accessed-heading; width: root.column-settings[9].pixels * 1px;
                                                accessible-label: root.accessed-heading + @tr("ui" => "; according to system policy; sort newest to oldest, then reverse");
                                                enabled: root.sort-order >= 0; clicked => { root.sort-dates(true); }
                                            }
                                            if root.column-settings[10].shown: Text { text: @tr("ui" => "Full path"); color: WorkshopTheme.ink; width: root.column-settings[10].pixels * 1px; font-size: 11px; vertical-alignment: center; }
                                        }
                                    }
                                    // The table owns one persistent focus scope. Re-ranking rows
                                    // changes the selected identity's index, never the focused delegate.
                                    details-focus := FocusScope {
                                        accessible-role: groupbox;
                                        accessible-label: @tr("ui" => "Folder contents view");
                                        focus-gained => { if root.workshop-live && root.workshop-selected < 0 && root.details.length > 0 { root.workshop-action(root.workshop-token,0,false); } }
                                        key-pressed(event) => {
                                            if root.workshop-live && root.details.length > 0 {
                                                if event.text == Key.DownArrow {
                                                    let target = min(root.details.length - 1, max(0, root.workshop-selected + 1));
                                                    root.workshop-action(root.workshop-token,target,false);
                                                    root.detail-scroll-y = clamp(root.detail-scroll-y, -target * 34px, min(0px, details-focus.height - (target + 1) * 34px));
                                                    return accept;
                                                }
                                                if event.text == Key.UpArrow {
                                                    let target = max(0, root.workshop-selected - 1);
                                                    root.workshop-action(root.workshop-token,target,false);
                                                    root.detail-scroll-y = clamp(root.detail-scroll-y, -target * 34px, min(0px, details-focus.height - (target + 1) * 34px));
                                                    return accept;
                                                }
                                            }
                                            if root.workshop-live && root.workshop-selected >= 0 && root.workshop-selected < root.details.length {
                                                if root.desktop-entry-menu && (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                                                    let y = clamp((root.workshop-selected * 34px) + root.detail-scroll-y + 17px, 0px, details-focus.height);
                                                    root.workshop-entry-menu(root.workshop-token, root.workshop-selected, (details-focus.absolute-position.x + 8px) / 1px, (details-focus.absolute-position.y + y) / 1px);
                                                    return accept;
                                                }
                                                if event.text == Key.Return { root.workshop-action(root.workshop-token,root.workshop-selected,true); return accept; }
                                                if event.text == Key.Space { root.workshop-action(root.workshop-token,root.workshop-selected,false); return accept; }
                                            }
                                            return reject;
                                        }
                                        details-view := ListView {
                                            width: 100%; height: 100%;
                                            horizontal-scrollbar-policy: always-off;
                                            for entry[index] in root.details: Rectangle {
                                                height: 34px; background: entry.node-id == root.inspected-node ? WorkshopTheme.alternate : mod(index, 2) == 0 ? WorkshopTheme.alternate : WorkshopTheme.surface; border-radius: 3px;
                                                HorizontalLayout {
                                                    x: 0px; width: root.table-width; padding-left: 2px; padding-right: 0px; spacing: 6px;
                                                    if root.workshop-live: Text { text: entry.name; width: root.column-settings[0].pixels * 1px; color: WorkshopTheme.ink; overflow: elide; font-size: 12px; vertical-alignment: center; }
                                                    if !root.workshop-live: NameButton {
                                                        label: entry.name; width: root.column-settings[0].pixels * 1px;
                                                        action-label: (entry.directory ? @tr("ui" => "Open {}", entry.name) : @tr("ui" => "Show path of {}", entry.name));
                                                        clicked => { if entry.directory { root.select-node(entry.node-id); } else { root.inspect-entry(entry.node-id); } }
                                                    }
                                                    if root.column-settings[1].shown: Text { text: entry.size; color: WorkshopTheme.ink; width: root.column-settings[1].pixels * 1px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                                    if root.column-settings[2].shown: Text { text: entry.allocated; color: WorkshopTheme.ink; width: root.column-settings[2].pixels * 1px; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                                    if root.workshop-live && root.column-settings[3].shown: Text { text: entry.owner; width: root.column-settings[3].pixels * 1px; color: WorkshopTheme.ink; overflow: elide; font-size: 12px; vertical-alignment: center; }
                                                    if !root.workshop-live && root.column-settings[3].shown: NameButton {
                                                        label: entry.owner; width: root.column-settings[3].pixels * 1px;
                                                        action-label: @tr("ui" => "Owner of {}: {}", entry.name, entry.owner);
                                                        clicked => { root.inspect-entry(entry.node-id); }
                                                    }
                                                    if root.column-settings[4].shown: Rectangle {
                                                        width: root.column-settings[4].pixels * 1px; height: 24px;
                                                        background: WorkshopTheme.surface; border-radius: 3px;
                                                        accessible-role: text;
                                                        accessible-label: entry.proportion + (entry.weight-provisional ? " · " + @tr("ui" => "Provisional") : "");
                                                        // No minimum colored width: zero, unknown and tiny
                                                        // shares retain their actual measured geometry.
                                                        Rectangle {
                                                            x: 0px; y: 0px;
                                                            width: entry.has-weight ? parent.width * entry.fraction : 0px;
                                                            height: parent.height;
                                                            background: TilePalette.color(entry.color-index);
                                                        }
                                                        // A compact opaque label keeps contrast independent
                                                        // of the fill position and of the selected theme.
                                                        Rectangle {
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            width: min(parent.width - 4px, share-label.preferred-width + 8px);
                                                            height: 17px; background: WorkshopTheme.surface; border-radius: 2px;
                                                            share-label := Text {
                                                                width: parent.width; height: parent.height;
                                                                text: entry.proportion; color: WorkshopTheme.ink;
                                                                font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    if root.column-settings[5].shown: Text { text: entry.files; color: WorkshopTheme.ink; width: root.column-settings[5].pixels * 1px; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                                    if root.column-settings[6].shown: Text { text: entry.directories; color: WorkshopTheme.ink; width: root.column-settings[6].pixels * 1px; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                                    if root.column-settings[7].shown: Text { text: entry.note; color: WorkshopTheme.ink; width: root.column-settings[7].pixels * 1px; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                                    if root.column-settings[8].shown: Text { text: entry.modified; color: WorkshopTheme.ink; width: root.column-settings[8].pixels * 1px; font-size: 11px; vertical-alignment: center; }
                                                    if root.column-settings[9].shown: Text { text: entry.accessed; color: WorkshopTheme.ink; width: root.column-settings[9].pixels * 1px; font-size: 11px; vertical-alignment: center; }
                                                    if root.workshop-live && root.column-settings[10].shown: Text { text: entry.path; width: root.column-settings[10].pixels * 1px; color: WorkshopTheme.ink; overflow: elide; font-size: 12px; vertical-alignment: center; }
                                                    if !root.workshop-live && root.column-settings[10].shown: NameButton {
                                                        label: entry.path; width: root.column-settings[10].pixels * 1px;
                                                        action-label: @tr("ui" => "Show full path: {}", entry.path);
                                                        clicked => { root.inspect-entry(entry.node-id); }
                                                    }
                                                }
                                                accessible-role: button;
                                                accessible-label: entry.name + ", " + entry.size;
                                                accessible-item-selectable: root.workshop-live;
                                                accessible-item-selected: root.workshop-live && root.workshop-selected == index;
                                                accessible-action-default => { if root.workshop-live { details-focus.focus(); root.workshop-action(root.workshop-token,index,false); } }
                                                if root.workshop-live && details-focus.has-focus && root.workshop-selected == index: Rectangle {
                                                    width: 100%; height: 100%; background: transparent;
                                                    border-width: 1px; border-color: WorkshopTheme.focus; border-radius: 3px;
                                                }
                                                if root.workshop-live: TouchArea {
                                                    property <bool> left-press: false;
                                                    property <int> menu-token: -1;
                                                    clicked => { if self.left-press { details-focus.focus(); root.workshop-action(root.workshop-token,index,false); } }
                                                    double-clicked => { if self.left-press { details-focus.focus(); root.workshop-action(root.workshop-token,index,true); } }
                                                    pointer-event(event) => {
                                                        if event.kind == PointerEventKind.down {
                                                            self.left-press = event.button == PointerEventButton.left;
                                                            if root.desktop-entry-menu && event.button == PointerEventButton.right {
                                                                self.menu-token = root.workshop-token;
                                                                root.workshop-gesture(true);
                                                            }
                                                        }
                                                        if event.button == PointerEventButton.left {
                                                            if event.kind == PointerEventKind.down { root.workshop-gesture(true); }
                                                            else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.workshop-gesture(false); }
                                                        }
                                                        if self.menu-token >= 0 && (event.kind == PointerEventKind.cancel || (event.button == PointerEventButton.right && event.kind == PointerEventKind.up)) {
                                                            let token = self.menu-token;
                                                            self.menu-token = -1;
                                                            root.workshop-gesture(false);
                                                            if event.kind == PointerEventKind.up && self.mouse-x >= 0px && self.mouse-x < self.width && self.mouse-y >= 0px && self.mouse-y < self.height {
                                                                details-focus.focus();
                                                                root.workshop-entry-menu(token, index, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.details.length == 0: Text { text: root.empty-message; color: WorkshopTheme.ink; wrap: word-wrap; }
                        if root.has-previous-detail-page || root.has-next-detail-page: HorizontalLayout {
                            spacing: 8px;
                            Button { text: @tr("ui" => "Previous"); enabled: root.has-previous-detail-page; clicked => { root.change-page(true, false); } }
                            Text { text: root.detail-page; color: WorkshopTheme.ink; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            Button { text: @tr("ui" => "Next"); enabled: root.has-next-detail-page; clicked => { root.change-page(true, true); } }
                        }
                        LineEdit { text: root.entry-path; placeholder-text: @tr("ui" => "Select a path to read it in full"); read-only: true; accessible-label: @tr("ui" => "Full entry path"); }
                    }
                }
            }
            Rectangle {
                width: 100%; height: 100%; visible: root.top-visible && !(root.workshop-live && root.cache-visible);
                background: white; border-width: 1px; border-color: WorkshopTheme.border; border-radius: 5px;
                VerticalLayout {
                    padding: 8px; spacing: 6px;
                    Text { text: @tr("ui" => "TOP 100 · LARGEST FILES"); color: WorkshopTheme.ink; font-size: 15px; font-weight: 600; }
                    if root.top-scope != "": LineEdit { text: root.top-scope; read-only: true; accessible-label: @tr("ui" => "Analysis source"); }
                    Text { text: root.top-note; color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        Text { text: @tr("ui" => "Rank"); width: 42px; color: WorkshopTheme.ink; }
                        Text { text: @tr("ui" => "Name"); width: 200px; color: WorkshopTheme.ink; }
                        Text { text: @tr("ui" => "Logical size"); width: 110px; color: WorkshopTheme.ink; }
                        Text { text: @tr("ui" => "Full path"); horizontal-stretch: 1; color: WorkshopTheme.ink; }
                    }
                    top-focus := FocusScope {
                        accessible-role: groupbox;
                        accessible-label: root.top-selected >= 0 ? @tr("ui" => "Top 100, rank {}, {}", root.top-rows[root.top-selected].rank, root.top-rows[root.top-selected].name) : @tr("ui" => "Top 100, no file selected");
                        key-pressed(event) => {
                            if root.top-rows.length > 0 {
                                if event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Home || event.text == Key.End {
                                    root.select-top(event.text == Key.Home ? 0 : event.text == Key.End ? root.top-rows.length - 1 : clamp(root.top-selected + (event.text == Key.UpArrow ? -1 : 1), 0, root.top-rows.length - 1));
                                    root.top-scroll-y = min(0px, max(top-view.visible-height - top-view.content-height, -max(0, root.top-selected - 2) * 34px));
                                    return accept;
                                }
                                if root.linux-entry-menu && root.top-selected >= 0 && root.top-selected < root.top-rows.length
                                    && (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                                    let y = clamp(root.top-selected * 34px + root.top-scroll-y + 17px, 0px, top-focus.height);
                                    root.top-entry-menu(root.workshop-token, root.top-selected, (top-focus.absolute-position.x + 8px) / 1px, (top-focus.absolute-position.y + y) / 1px);
                                    return accept;
                                }
                                if event.text == Key.Return { root.reveal-top(); if !root.top-visible { map-focus.focus(); } return accept; }
                            }
                            return reject;
                        }
                        top-view := ListView {
                            width: 100%; height: 100%;
                            // Fixed-height rows: avoid a virtualized content-height
                            // estimate leaving the final row clipped on Windows.
                            content-height: root.top-rows.length * 34px;
                            for item[index] in root.top-rows: Rectangle {
                                width: max(0px, top-view.visible-width - root.scrollbar-gutter);
                                height: 34px;
                                background: root.top-selected == index ? WorkshopTheme.alternate : mod(index, 2) == 0 ? WorkshopTheme.alternate : white;
                                border-width: top-focus.has-focus && root.top-selected == index ? 1px : 0px;
                                border-color: WorkshopTheme.focus;
                                accessible-role: button; accessible-label: item.rank + ", " + item.name + ", " + item.size + ", " + item.path;
                                accessible-action-default => { root.select-top(index); }
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 4px; padding-right: 4px;
                                    Text { text: item.rank; width: 38px; color: WorkshopTheme.ink; vertical-alignment: center; }
                                    Text { text: item.name; width: 192px; color: WorkshopTheme.ink; vertical-alignment: center; overflow: elide; }
                                    Text { text: item.size; width: 102px; color: WorkshopTheme.ink; vertical-alignment: center; }
                                    Text { text: item.path; horizontal-stretch: 1; color: WorkshopTheme.ink; vertical-alignment: center; overflow: elide; }
                                }
                                TouchArea {
                                    property <bool> menu-press: false;
                                    property <int> menu-token;
                                    clicked => { root.select-top(index); top-focus.focus(); }
                                    pointer-event(event) => {
                                        if root.workshop-live && event.button == PointerEventButton.left {
                                            if event.kind == PointerEventKind.down { root.workshop-gesture(true); }
                                            else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.workshop-gesture(false); }
                                        }
                                        if event.kind == PointerEventKind.cancel { self.menu-press = false; }
                                        if root.desktop-entry-menu && event.button == PointerEventButton.right {
                                            if event.kind == PointerEventKind.down {
                                                self.menu-press = true;
                                                self.menu-token = root.workshop-token;
                                            } else if event.kind == PointerEventKind.up && self.menu-press {
                                                self.menu-press = false;
                                                if self.menu-token == root.workshop-token && self.mouse-x >= 0px && self.mouse-x < self.width && self.mouse-y >= 0px && self.mouse-y < self.height {
                                                    top-focus.focus();
                                                    root.top-entry-menu(self.menu-token, index, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.top-rows.length == 0 && !root.top-loading: Text { text: @tr("ui" => "No file observed in this scope."); color: WorkshopTheme.ink; }
                    Text { text: @tr("ui" => "↑ ↓ · Home / End: select · Enter: reveal in table"); color: WorkshopTheme.ink; font-size: 11px; }
                    LineEdit { text: root.top-path; read-only: true; accessible-label: @tr("ui" => "Full native path of the ranked file, non-Unicode units escaped"); }
                    HorizontalLayout {
                        Button { text: @tr("ui" => "Reveal in table"); enabled: root.top-retained; clicked => { root.reveal-top(); if !root.top-visible { map-focus.focus(); } } }
                        Text { text: root.top-selected < 0 ? @tr("ui" => "Select a file.") : root.top-retained ? @tr("ui" => "File retained in the inventory.") : @tr("ui" => "Path absent from retained inventory; no node to reveal."); color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
                    }
                }
            }
            // Saved measures share the content area with browsing and search.
            // The ribbon remains outside this panel and can still receive input.
            cache-panel := FocusScope {
                visible: root.workshop-live && root.cache-visible;
                enabled: !root.preferences-open;
                focus-on-tab-navigation: false;
                width: 100%; height: 100%;
                key-pressed(event) => {
                    if event.text == Key.Escape && root.cache-confirm {
                        root.cache-confirm = false;
                        cache-choice-control.focus();
                        return accept;
                    }
                    if event.text == Key.Escape { root.close-cache-panel(); return accept; }
                    return reject;
                }
                Rectangle {
                    width: 100%; height: 100%;
                    background: WorkshopTheme.surface; border-width: 1px; border-color: WorkshopTheme.border;
                    VerticalLayout {
                        padding: 10px; spacing: 6px;
                        HorizontalLayout {
                            vertical-stretch: 0; spacing: 8px;
                            Text { text: @tr("ui" => "Saved measures"); color: WorkshopTheme.ink; font-size: 16px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: @tr("ui" => "Refresh"); horizontal-stretch: 0; clicked => { root.cache-action(0,root.cache-choice,root.cache-token); } }
                            cache-close-button := Button { text: @tr("ui" => "Close"); horizontal-stretch: 0; clicked => { root.close-cache-panel(); } }
                        }
                        cache-scroll := ScrollView {
                            vertical-stretch: 1; min-height: 0px;
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                width: cache-scroll.visible-width - root.scrollbar-gutter;
                                padding-right: 2px; spacing: 8px; alignment: start;
                                cache-choice-control := FocusScope {
                                    height: clamp(cache-inventory-rows.preferred-height, 64px, min(148px, max(80px, cache-panel.height - 230px)));
                                    accessible-role: groupbox; accessible-label: @tr("ui" => "Saved measures");
                                    function show-measure-menu(index: int, token: int, x: length, y: length) {
                                        if root.can-delete-cache-measure(index, token) {
                                            cache-measure-menu.measure-index = index;
                                            cache-measure-menu.measure-token = token;
                                            root.cache-choice = index;
                                            root.cache-confirm = false;
                                            self.focus();
                                            cache-measure-menu.show({x: x, y: y});
                                        }
                                    }
                                    key-pressed(event) => {
                                        if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) && root.can-delete-cache-measure(root.cache-choice, root.cache-token) {
                                            self.show-measure-menu(root.cache-choice, root.cache-token, 8px, 8px);
                                            return accept;
                                        }
                                        if root.cache-labels.length > 0 && (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Home || event.text == Key.End) {
                                            root.cache-choice = event.text == Key.Home ? 0 : event.text == Key.End ? root.cache-labels.length - 1 : clamp(root.cache-choice + (event.text == Key.UpArrow ? -1 : 1),0,root.cache-labels.length - 1);
                                            root.cache-confirm = false;
                                            return accept;
                                        }
                                        return reject;
                                    }
                                    cache-measure-menu := ContextMenuArea {
                                        x: 0px; y: 0px; width: 0px; height: 0px;
                                        enabled: false;
                                        property <int> measure-index: -1;
                                        property <int> measure-token: 0;
                                        Menu {
                                            MenuItem {
                                                title: @tr("ui" => "Delete selected measure…");
                                                enabled: root.can-delete-cache-measure(cache-measure-menu.measure-index, cache-measure-menu.measure-token);
                                                activated => { root.confirm-cache-deletion(cache-measure-menu.measure-index, cache-measure-menu.measure-token); }
                                            }
                                        }
                                    }
                                    cache-inventory-list := ScrollView {
                                        width: 100%; height: 100%;
                                        horizontal-scrollbar-policy: always-off;
                                        content-height: cache-inventory-rows.preferred-height;
                                        // The catalogue is bounded. Keep every row's geometry
                                        // available so keyboard selection can reveal wrapped labels.
                                        cache-inventory-rows := VerticalLayout {
                                            width: max(0px,cache-inventory-list.visible-width - root.scrollbar-gutter);
                                            height: self.preferred-height; spacing: 0px; alignment: start;
                                            for label[index] in root.cache-labels: Rectangle {
                                                property <bool> selected: root.cache-visible && root.cache-choice == index;
                                                function reveal-selection() {
                                                    if self.selected {
                                                        if self.y + cache-inventory-list.content-y < 0px {
                                                            cache-inventory-list.content-y = -self.y;
                                                        }
                                                        if self.y + self.height + cache-inventory-list.content-y > cache-inventory-list.visible-height {
                                                            cache-inventory-list.content-y = min(0px,cache-inventory-list.visible-height - self.y - self.height);
                                                        }
                                                    }
                                                }
                                                changed selected => { self.reveal-selection(); }
                                                changed y => { self.reveal-selection(); }
                                                changed height => { self.reveal-selection(); }
                                                height: max(34px,cache-inventory-label.preferred-height + 12px);
                                                background: root.cache-choice == index ? WorkshopTheme.alternate : WorkshopTheme.surface;
                                                border-color: WorkshopTheme.focus;
                                                border-width: root.cache-choice == index ? 1px : 0px;
                                                accessible-role: button; accessible-label: label;
                                                accessible-item-selectable: true; accessible-item-selected: root.cache-choice == index;
                                                accessible-action-default => { root.cache-choice = index; root.cache-confirm = false; cache-choice-control.focus(); }
                                                cache-inventory-label := Text { x: 6px; y: 6px; width: max(0px,parent.width - 12px); text: label; color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
                                                TouchArea {
                                                    property <bool> left-press: false;
                                                    property <int> right-token: 0;
                                                    pointer-event(event) => {
                                                        if event.kind == PointerEventKind.down {
                                                            self.left-press = event.button == PointerEventButton.left;
                                                            self.right-token = event.button == PointerEventButton.right ? root.cache-token : 0;
                                                        }
                                                        if event.kind == PointerEventKind.cancel {
                                                            self.left-press = false;
                                                            self.right-token = 0;
                                                        }
                                                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                                                            let token = self.right-token;
                                                            self.right-token = 0;
                                                            if self.mouse-x >= 0px && self.mouse-x < self.width && self.mouse-y >= 0px && self.mouse-y < self.height {
                                                                cache-choice-control.show-measure-menu(index, token,
                                                                    self.absolute-position.x + self.mouse-x - cache-choice-control.absolute-position.x,
                                                                    self.absolute-position.y + self.mouse-y - cache-choice-control.absolute-position.y);
                                                            }
                                                        }
                                                    }
                                                    clicked => {
                                                        if self.left-press {
                                                            root.cache-choice = index;
                                                            root.cache-confirm = false;
                                                            cache-choice-control.focus();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if cache-choice-control.has-focus: Rectangle { width: 100%; height: 100%; background: transparent; border-width: 1px; border-color: WorkshopTheme.focus; }
                                }
                                cache-actions := VerticalLayout {
                                    spacing: 4px; vertical-stretch: 0; alignment: start;
                                    cache-retention-actions := HorizontalLayout {
                                        height: max(32px,cache-keep-button.preferred-height);
                                        spacing: 6px; vertical-stretch: 0;
                                        cache-keep-button := Button { text: @tr("ui" => "Keep current scan as a dated measure"); horizontal-stretch: 0; enabled: root.cache-token != 0 && root.workshop-token != 0 && !root.busy; clicked => { root.cache-action(1,root.cache-choice,root.cache-token); } }
                                        Button { text: @tr("ui" => "Manage measures"); horizontal-stretch: 0; checked: root.cache-manage; checkable: false; clicked => { root.cache-manage = !root.cache-manage; root.cache-confirm = false; } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Text { text: @tr("ui" => "Keep each scan you want in the history. A new scan replaces the automatic entry for the same location."); color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap; }
                                    cache-selected-actions := HorizontalLayout {
                                        height: max(32px,cache-open-button.preferred-height);
                                        spacing: 6px; vertical-stretch: 0;
                                        cache-open-button := Button { text: @tr("ui" => "Open offline"); horizontal-stretch: 0; enabled: root.cache-token != 0 && root.cache-labels.length > 0; clicked => { root.cache-action(2,root.cache-choice,root.cache-token); } }
                                        Button { text: @tr("ui" => "Largest entries"); horizontal-stretch: 0; enabled: root.cache-token != 0 && root.cache-measured[root.cache-choice]; clicked => { root.cache-action(9,root.cache-choice,root.cache-token); } }
                                        Button { text: @tr("ui" => "Show trend"); horizontal-stretch: 0; enabled: root.cache-token != 0 && root.cache-retained[root.cache-choice]; clicked => { root.cache-action(11,root.cache-choice,root.cache-token); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px; vertical-stretch: 0;
                                        ComboBox {
                                            model: root.cache-archive-labels; current-index <=> root.cache-other; min-width: 0px; horizontal-stretch: 1;
                                            accessible-label: @tr("ui" => "Other retained date for comparison");
                                            enabled: root.cache-token != 0 && root.cache-retained[root.cache-choice] && root.cache-archive-labels.length > 2;
                                        }
                                        Button {
                                            text: @tr("ui" => "Compare retained dates"); horizontal-stretch: 0;
                                            enabled: root.cache-token != 0 && root.cache-retained[root.cache-choice] && root.cache-other > 0 && root.cache-archive-indices[root.cache-other] != root.cache-choice;
                                            clicked => { root.cache-action(10,root.cache-choice,root.cache-token); }
                                        }
                                    }
                                    if root.cache-token != 0 && root.cache-archive-labels.length < 3: Text {
                                        text: root.cache-archive-labels.length < 2 ? @tr("ui" => "No retained dates yet.") : @tr("ui" => "Keep another scan to compare two dates.");
                                        color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap;
                                    }
                                    if root.cache-manage: HorizontalLayout {
                                        spacing: 6px; vertical-stretch: 0;
                                        Button {
                                            text: @tr("ui" => "Delete selected measure…"); horizontal-stretch: 0;
                                            enabled: root.can-delete-cache-measure(root.cache-choice, root.cache-token) && !root.cache-confirm;
                                            clicked => { root.confirm-cache-deletion(root.cache-choice, root.cache-token); }
                                        }
                                        Button { text: @tr("ui" => "Verify source"); horizontal-stretch: 0; enabled: root.cache-token != 0 && root.cache-labels.length > 0; clicked => { root.cache-action(3,root.cache-choice,root.cache-token); } }
                                        Button { text: @tr("ui" => "Resume"); horizontal-stretch: 0; enabled: root.cache-token != 0 && root.cache-labels.length > 0; clicked => { root.cache-action(4,root.cache-choice,root.cache-token); } }
                                        Button { text: @tr("ui" => "Compare with current"); horizontal-stretch: 0; enabled: root.cache-token != 0 && root.cache-labels.length > 0 && !root.busy; clicked => { root.cache-action(5,root.cache-choice,root.cache-token); } }
                                        Button { text: @tr("ui" => "Stop retaining"); horizontal-stretch: 0; enabled: root.cache-token != 0 && root.workshop-token != 0; clicked => { root.cache-action(8,root.cache-choice,root.cache-token); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if root.cache-manage && root.cache-confirm: Rectangle {
                                        background: WorkshopTheme.alternate;
                                        border-width: 1px; border-color: WorkshopTheme.border;
                                        VerticalLayout {
                                            padding: 8px; spacing: 6px;
                                            Text { text: @tr("ui" => "Permanently delete this saved measure?"); font-weight: 600; color: WorkshopTheme.ink; wrap: word-wrap; }
                                            Text { text: root.cache-labels[root.cache-choice]; color: WorkshopTheme.ink; wrap: word-wrap; }
                                            Text { text: @tr("ui" => "Scanned files are kept."); color: WorkshopTheme.ink; wrap: word-wrap; }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Button { text: @tr("ui" => "Cancel"); init => { self.focus(); } clicked => { root.cache-confirm = false; cache-choice-control.focus(); } }
                                                Button {
                                                    text: @tr("ui" => "Delete measure");
                                                    enabled: root.can-delete-cache-measure(root.cache-choice, root.cache-token);
                                                    clicked => { root.cache-action(6,root.cache-choice,root.cache-token); }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                                Text { text: @tr("ui" => "Retention: 30 days from measurement"); color: WorkshopTheme.ink; font-size: 10px; wrap: word-wrap; }
                                if root.preview-enabled: Text { text: @tr("ui" => "Listing an inventory does not certify integrity."); color: WorkshopTheme.ink; wrap: word-wrap; font-size: 11px; }
                                if root.preview-state > 0: Text {
                                    text: root.preview-state == 1 ? @tr("ui" => "Opening recorded inventory. Integrity not verified.") : root.preview-state == 2 ? @tr("ui" => "Dated preview. Integrity not verified. Checking…") : root.preview-state == 3 ? @tr("ui" => "Integrity verified for this recorded view. Source not checked.") : root.preview-state == 4 ? @tr("ui" => "Verification failed. Preview invalidated.") : @tr("ui" => "Verification cancelled. Preview discarded.");
                                    accessible-role: text; accessible-label: self.text;
                                    color: WorkshopTheme.ink; wrap: word-wrap; font-size: 12px;
                                }
                                if root.preview-state == 2: Text { text: root.preview-descriptor; color: WorkshopTheme.ink; wrap: word-wrap; font-size: 11px; }
                                if root.preview-state == 2: Text { text: @tr("ui" => "Recorded prefix only. No completeness or current-source claim."); color: WorkshopTheme.ink; wrap: word-wrap; font-size: 11px; }
                                if root.preview-state == 2: ListView {
                                    height: clamp(cache-panel.height * 0.3,80px,200px);
                                    for row in root.preview-rows: Text { text: row; min-height: 28px; color: WorkshopTheme.ink; overflow: elide; }
                                }
                                Text { text: root.cache-status; color: WorkshopTheme.ink; wrap: word-wrap; font-size: 11px; }
                                if root.cache-diagnostic != "": HorizontalLayout {
                                    Button { text: @tr("ui" => "Read errors"); horizontal-stretch: 0; clicked => { root.cache-diagnostic-visible = !root.cache-diagnostic-visible; } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.cache-diagnostic != "" && root.cache-diagnostic-visible: TextEdit { text: root.cache-diagnostic; read-only: true; height: 100px; accessible-label: @tr("ui" => "Read errors"); }
                                if root.diff-summary != "": Text { text: @tr("ui" => "Logical sizes per path · links not followed"); color: WorkshopTheme.ink; font-size: 10px; wrap: word-wrap; }
                                if root.diff-summary != "": Text { text: root.diff-summary; color: WorkshopTheme.ink; wrap: word-wrap; font-size: 12px; }
                                if root.history-heading != "": VerticalLayout {
                                    spacing: 5px; padding: 8px;
                                    Text { text: root.history-heading; color: WorkshopTheme.ink; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                                    Text { text: root.history-scope; color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
                                    if root.history-points.length > 0: HistoryPlot {
                                        points: root.history-points; zero: root.history-zero; middle: root.history-middle; maximum: root.history-maximum;
                                        first: root.history-first; last: root.history-last;
                                    }
                                    for row[i] in root.history-rows: Rectangle {
                                        min-height: 25px;
                                        background: mod(i, 2) == 0 ? WorkshopTheme.alternate : WorkshopTheme.surface;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 8px; spacing: 10px;
                                            Text { text: row.title; color: WorkshopTheme.ink; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center; }
                                            Text { text: row.state; color: WorkshopTheme.ink; vertical-alignment: center; }
                                            Text {
                                                min-width: 106px; text: row.value; font-weight: 600;
                                                color: row.direction > 0 ? (WorkshopTheme.dark-surface ? #ffcf98 : #8b4617) : row.direction < 0 ? (WorkshopTheme.dark-surface ? #94dfb8 : #266548) : WorkshopTheme.ink;
                                                horizontal-alignment: right; vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                if root.diff-rows.length > 0: HorizontalLayout {
                                    Text { width: 120px; text: ""; }
                                    Text { text: @tr("ui" => "Previous path"); color: WorkshopTheme.ink; horizontal-stretch: 1; }
                                    Text { text: @tr("ui" => "Current path"); color: WorkshopTheme.ink; horizontal-stretch: 1; }
                                }
                                if root.diff-rows.length > 0: ListView {
                                    height: clamp(cache-panel.height * 0.35,100px,240px);
                                    for row in root.diff-rows: HorizontalLayout {
                                        height: 32px; spacing: 4px;
                                        Text { text: row.change; color: WorkshopTheme.ink; width: 120px; overflow: elide; }
                                        LineEdit { text: row.old-path; read-only: true; horizontal-stretch: 1; accessible-label: @tr("ui" => "Previous path"); }
                                        LineEdit { text: row.new-path; read-only: true; horizontal-stretch: 1; accessible-label: @tr("ui" => "Current path"); }
                                    }
                                }
                            }
                        }
                        if root.diff-rows.length > 0: HorizontalLayout {
                            vertical-stretch: 0; spacing: 6px;
                            Button { text: @tr("ui" => "Previous"); horizontal-stretch: 0; enabled: root.cache-previous; clicked => { root.cache-page(false); } }
                            Text { text: @tr("ui" => "Metadata only. Probable moves are not content proof."); color: WorkshopTheme.ink; font-size: 10px; wrap: word-wrap; horizontal-stretch: 1; }
                            Button { text: @tr("ui" => "Next"); horizontal-stretch: 0; enabled: root.cache-next; clicked => { root.cache-page(true); } }
                        }
                    }
                }
            }
        }
        if root.cancelling: Text {
            text: @tr("ui" => "Cancellation requested. A system call already in progress may delay the stop.");
            color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap;
        }
        if root.scan-progress != "" && (!root.search-visible || root.busy): Text {
            text: root.scan-progress;
            accessible-role: text; accessible-label: self.text;
            color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap;
        }
        if root.inventory-warning != "" || root.view-warning != "": Text {
            text: root.inventory-warning + (root.inventory-warning != "" && root.view-warning != "" ? "\n" : "") + root.view-warning;
            color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap;
        }
        if root.windows-entry-notice != "": Text {
            text: root.windows-entry-notice; accessible-role: text; accessible-label: self.text;
            color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap;
        }
        if root.workshop-live && root.errors != "": Button { text: @tr("ui" => "Retry"); clicked => { root.workshop-retry(); } }
        if root.workshop-live && !root.top-visible && root.workshop-selected >= 0: Button { text: @tr("ui" => "Open"); clicked => { root.workshop-action(root.workshop-token,root.workshop-selected,true); } }
        if root.errors != "": ScrollView { height: 70px; Text { text: root.errors; color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; } }
        // A completed A/B comparison already owns its summary. Acquisition and
        // cancellation retain their global status while they are active.
        if !root.search-visible || root.duplicate-mode == 0 || root.busy || root.cancelling: HorizontalLayout {
            max-height: root.search-visible ? 36px : 100000px; vertical-stretch: 0;
            spacing: 8px;
            Spinner { visible: root.busy; width: 20px; height: 20px; }
            Text { text: root.status + (root.scan-source == "" ? "" : " · " + root.scan-source); color: WorkshopTheme.ink; font-size: 12px; font-weight: 600; wrap: word-wrap; vertical-alignment: center; }
        }
        if !root.search-visible: Text { text: root.summary; color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
    }
    // Draw over the window, outside the clipped Treemap and its tiles.
    // These decorative items have no input surface, so they cannot steal hover.
    if root.map-tooltip-visible: Rectangle {
        x: root.map-origin-x * 1px + map-area.width * (root.treemap-mode == 0 ? root.hovered-tile.x : root.hovered-tile.band-x);
        y: root.map-origin-y * 1px + (root.treemap-mode == 0 ? map-area.height * root.hovered-tile.y : 0px);
        width: map-area.width * (root.treemap-mode == 0 ? root.hovered-tile.w : root.hovered-tile.band-w);
        height: root.treemap-mode == 0 ? map-area.height * root.hovered-tile.h : map-area.height;
        background: transparent; border-width: 2px; border-color: #ffdd75;
        Rectangle {
            x: 2px; y: 2px; width: max(0px, parent.width - 4px); height: max(0px, parent.height - 4px);
            background: transparent; border-width: 1px; border-color: #17202b;
        }
    }
    map-tooltip := Rectangle {
        visible: root.map-tooltip-visible;
        width: min(520px, max(0px, root.width - 16px));
        height: min(tooltip-label.preferred-height + 20px, max(0px, root.height - 16px));
        x: clamp(root.map-pointer-x * 1px + 14px + self.width <= root.width - 8px ? root.map-pointer-x * 1px + 14px : root.map-pointer-x * 1px - self.width - 14px, 8px, max(8px, root.width - self.width - 8px));
        y: clamp(root.map-pointer-y * 1px + 18px + self.height <= root.height - 8px ? root.map-pointer-y * 1px + 18px : root.map-pointer-y * 1px - self.height - 18px, 8px, max(8px, root.height - self.height - 8px));
        background: WorkshopTheme.surface; border-width: 2px; border-color: WorkshopTheme.ink;
        border-radius: 4px;
        clip: true;
        tooltip-label := Text {
            x: 10px; y: 10px; width: max(0px, parent.width - 20px);
            text: root.map-tooltip-text; color: WorkshopTheme.ink;
            font-size: 12px; wrap: char-wrap;
        }
    }
    if root.windows-rename-visible: TouchArea { width: 100%; height: 100%; }
    if root.windows-rename-visible: FocusScope {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(560px, root.width - 32px); height: rename-layout.preferred-height;
        init => { rename-name.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.windows-rename-cancel();
                root.windows-rename-close();
                return accept;
            }
            return reject;
        }
        Rectangle {
            background: WorkshopTheme.surface; border-width: 2px; border-color: WorkshopTheme.focus; border-radius: 6px;
            rename-layout := VerticalLayout {
                padding: 12px; spacing: 8px;
                Text { text: @tr("ui" => "Rename"); font-size: 18px; color: WorkshopTheme.ink; }
                LineEdit { text: root.windows-rename-path; read-only: true; accessible-label: @tr("ui" => "Full entry path"); }
                rename-name := LineEdit {
                    text <=> root.windows-rename-name;
                    accessible-label: @tr("ui" => "New name");
                    accepted(value) => { root.windows-rename-submit(value); }
                }
                if root.windows-rename-failed: Text {
                    text: @tr("ui" => "Could not rename this item. Check the name, whether it is already in use, and whether the original item still exists.");
                    color: WorkshopTheme.ink; wrap: word-wrap;
                    accessible-role: text; accessible-label: self.text;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: @tr("ui" => "Cancel"); clicked => { root.windows-rename-cancel(); root.windows-rename-close(); } }
                    Button { text: @tr("ui" => "Rename"); enabled: root.windows-rename-name != ""; clicked => { root.windows-rename-submit(root.windows-rename-name); } }
                }
            }
        }
    }
    // Preferences are modal. Saved measures are a normal content panel.
    if root.preferences-open: TouchArea {
        width: 100%; height: 100%;
    }
    if root.preferences-open: FocusScope {
        focus-on-tab-navigation: false;
        FocusScope { width:1px; height:1px; focus-gained => { preferences-close-button.focus(); } }
        x: max(16px, (root.width - self.width) / 2); y: 70px;
        width: min(620px, root.width - 32px); height: min(570px, root.height - 90px);
        init=>{language-picker.focus();}
        key-pressed(event)=>{if event.text==Key.Escape{root.close-preferences();return accept;}return reject;}
        Rectangle { width:100%;height:100%;
        background: WorkshopTheme.surface; border-width: 2px; border-color: WorkshopTheme.focus; border-radius: 6px;
        VerticalLayout {
            padding: 12px; spacing: 8px;
            Text { text: @tr("ui" => "Columns and display"); font-size: 18px; color: WorkshopTheme.ink; }
            Text { text: @tr("ui" => "The name stays visible. The active sort is preserved."); font-size: 12px; color: WorkshopTheme.ink; }
            HorizontalLayout {
                Text { text: @tr("ui" => "Language"); vertical-alignment: center; }
                language-picker := ComboBox {
                    model: [@tr("ui" => "Automatic (system)"), @tr("ui" => "English"), @tr("ui" => "Français"), @tr("ui" => "Deutsch"), @tr("ui" => "Español"), @tr("ui" => "Português (Portugal)"), @tr("ui" => "Italiano"), @tr("ui" => "Nederlands")];
                    current-index: root.language-choice;
                    accessible-label: @tr("ui" => "Interface language");
                    accessible-description: root.accessibility-description-values ? self.current-value : "";
                    selected(value) => { root.set-language(self.current-index); }
                }
            }
            Text {
                text: @tr("ui" => "Detected system locale: {}", root.detected-language) + "\n" +
                    @tr("ui" => "Active language: {}", [@tr("ui" => "English"), @tr("ui" => "Français"), @tr("ui" => "Deutsch"), @tr("ui" => "Español"), @tr("ui" => "Português (Portugal)"), @tr("ui" => "Italiano"), @tr("ui" => "Nederlands")][root.effective-language]);
                font-size: 11px; color: WorkshopTheme.ink; wrap: word-wrap;
            }
            if root.language-fallback || root.language-failed: Text {
                text: root.language-failed ? @tr("ui" => "Could not activate the language; previous language retained.") :
                    @tr("ui" => "Requested catalog ({}) unavailable; using English. Saved preference retained.", [@tr("ui" => "English"), @tr("ui" => "Français"), @tr("ui" => "Deutsch"), @tr("ui" => "Español"), @tr("ui" => "Português (Portugal)"), @tr("ui" => "Italiano"), @tr("ui" => "Nederlands")][root.unavailable-language]);
                font-size: 11px; color: WorkshopTheme.ink; wrap: word-wrap;
            }
            ListView {
                for column[index] in root.column-settings: CheckBox {
                    height: 26px; text: column.label; checked: column.shown;
                    enabled: index != 0; accessible-label: column.label;
                    toggled => { root.set-column(index, self.checked); }
                }
            }
            HorizontalLayout {
                Text { text: @tr("ui" => "Units"); vertical-alignment: center; }
                ComboBox {
                    model: [@tr("ui" => "Binary (KiB, MiB, GiB)"), @tr("ui" => "Decimal (kB, MB, GB)")];
                    current-index: root.decimal-units ? 1 : 0;
                    accessible-label: @tr("ui" => "Size unit system");
                    accessible-description: root.accessibility-description-values ? self.current-value : "";
                    selected(value) => { root.set-units(self.current-index == 1); }
                }
            }
            Text { text: root.preference-status; font-size: 11px; color: WorkshopTheme.ink; wrap: word-wrap; }
            HorizontalLayout {
                Button { text: @tr("ui" => "Reset display"); clicked => { root.reset-display(); } }
                preferences-close-button := Button { text: @tr("ui" => "Close"); clicked => { root.close-preferences(); } }
            }
        }
            }
        FocusScope { width:1px; height:1px; focus-gained => { language-picker.focus(); } }
    }

}
