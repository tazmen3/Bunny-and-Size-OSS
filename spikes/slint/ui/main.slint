import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, Spinner, TextEdit, Palette, AboutSlint } from "std-widgets.slint";

export global WorkshopTheme {
    in-out property <int> mode: 0;
    changed mode => { Palette.color-scheme = mode == 1 ? ColorScheme.light : mode == 2 ? ColorScheme.dark : ColorScheme.unknown; }
    out property <brush> surface: Palette.background;
    out property <brush> alternate: Palette.alternate-background;
    out property <brush> ink: Palette.foreground;
    out property <brush> border: Palette.border;
    out property <brush> focus: Palette.foreground;
    out property <brush> protected-reference: #205b94;

    // Follow the effective palette in Auto mode as well as explicit themes.
    out property <bool> dark-surface: Palette.background.to-oklch().lightness < 0.5;

    public pure function duplicate-side-background(side: string) -> brush {
        if (side == "B") { return dark-surface ? #233c55 : #dcebfa; }
        if (side == "C") { return dark-surface ? #422f52 : #eee3f7; }
        return surface;
    }

    public pure function duplicate-group-background(side: string) -> brush {
        return ink.mix(duplicate-side-background(side), 0.075);
    }
}

component DuplicateSideBadge inherits Rectangle {
    in property <string> side;
    in property <string> label: root.side;
    border-width: 1px; border-color: WorkshopTheme.border; border-radius: 3px;
    background: WorkshopTheme.duplicate-side-background(root.side);
    Text {
        text: root.label; color: WorkshopTheme.ink; overflow: elide;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

component DuplicateLock inherits Rectangle {
    width: 12px; height: 13px;
    Rectangle {
        x: 3px; width: 6px; height: 8px;
        border-width: 1px; border-color: white; border-radius: 3px;
    }
    Rectangle {
        x: 1px; y: 5px; width: 10px; height: 7px;
        background: white; border-radius: 1px;
    }
}


// Shared opaque palette: the same entry has the same color in the tree,
// detail percentages and both Treemap layouts.
export global TilePalette {
    public pure function color(index: int) -> color {
        return index == 0 ? #23658a : index == 1 ? #386b47 :
            index == 2 ? #704e89 : index == 3 ? #8a4b35 :
            index == 4 ? #356b72 : index == 5 ? #805d20 :
            index == 6 ? #4f5c70 : #6e532b;
    }
}

export component LegalWindow inherits Window {
    icon: @image-url("../../../assets/branding/icons/bunny-and-size-256.png");
    out property <string> localized-title: @tr("ui" => "About Bunny and Size");
    title: root.localized-title;
    preferred-width: 800px; preferred-height: 600px;
    min-width: 580px; min-height: 500px;
    in property <string> product-version;
    out property <length> notice-viewport-height: notice-area.height;
    in property <string> notices;
    in property <string> license-text;
    in-out property <bool> full-license: false;
    background: WorkshopTheme.surface;
    VerticalLayout {
        padding: 12px; spacing: 6px;
        HorizontalLayout {
            spacing: 12px; vertical-stretch: 0;
            Image {
                source: @image-url("../../../assets/branding/icons/bunny-and-size-256.png");
                width: 72px; height: 72px; image-fit: contain;
            }
            VerticalLayout {
                spacing: 2px; horizontal-stretch: 1; vertical-stretch: 0;
                HorizontalLayout {
                    spacing: 8px; vertical-stretch: 0;
                    Text { text: "Bunny and Size"; font-size: 22px; font-weight: 700; color: WorkshopTheme.ink; vertical-alignment: center; }
                    Text { text: root.product-version; font-size: 14px; color: WorkshopTheme.ink; vertical-alignment: center; horizontal-stretch: 1; }
                }
                Text { text: "TazmenWorld"; font-size: 16px; font-weight: 700; color: WorkshopTheme.ink; }
                Text { text: @tr("ui" => "Created, published and maintained by Louis Lejuez (@tazmen3)"); font-size: 11px; color: WorkshopTheme.ink; wrap: word-wrap; }
            }
        }
        Text { text: "https://github.com/tazmen3/Bunny-and-Size-OSS"; font-size: 12px; color: WorkshopTheme.ink; wrap: word-wrap; }
        Text { text: @tr("ui" => "Original code: Apache-2.0. Artwork: CC BY-SA 4.0, Louis Lejuez / TazmenWorld."); font-size: 12px; color: WorkshopTheme.ink; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 6px; vertical-stretch: 0;
            Button { text: @tr("ui" => "Notices and rights"); horizontal-stretch: 0; clicked => { root.full-license = false; } }
            Button { text: @tr("ui" => "Read the full Apache 2.0 license"); horizontal-stretch: 0; clicked => { root.full-license = true; } }
            Rectangle { horizontal-stretch: 1; }
        }
        notice-area := TextEdit {
            min-height: 100px; vertical-stretch: 1;
            text: root.full-license ? root.license-text : root.notices;
            read-only: true;
            accessible-label: root.full-license ? @tr("ui" => "Full Apache 2.0 license text") : @tr("ui" => "Notices, rights and warranty disclaimer");
        }
        // Attribution required by the selected Slint desktop license.
        AboutSlint { preferred-height: 110px; vertical-stretch: 0; }
    }
}

// Registering a source never grants permission to scan it. Access checks and
// registration have distinct callbacks, separate from the main scan action.
export component AddSourceWindow inherits Window {
    icon: @image-url("../../../assets/branding/icons/bunny-and-size-256.png");
    out property <string> localized-title: @tr("ui" => "Add a source");
    title: root.localized-title;
    preferred-width: 660px; preferred-height: 630px;
    min-width: 550px; min-height: 580px;
    background: WorkshopTheme.surface;
    in-out property <int> source-kind: 0;
    in-out property <string> source-path;
    in-out property <string> display-name;
    in property <bool> windows-platform: false;
    in property <bool> linux-platform: false;
    in property <bool> busy: false;
    in property <bool> smb-server-only: false;
    in property <[string]> shares;
    // Disabled sources have their own management view, outside all active lists.
    in property <[string]> disconnected-sources;
    in-out property <int> selected-disconnected: -1;
    in-out property <bool> disconnected-view: false;
    out property <bool> add-tab-selected: add-source-tab.checked;
    out property <bool> disconnected-tab-selected: disconnected-source-tab.checked;
    in property <string> reconnect-status;
    out property <string> reconnected-message: @tr("ui" => "Source reconnected. No scan has been started.");
    // The controller prepends this non-source row to the discovered shares.
    out property <string> share-placeholder: @tr("ui" => "Shares on this server");
    in property <bool> shares-limited: false;
    in-out property <int> selected-share: -1;
    // 0 idle, 1 access check, 2 share enumeration, 3 native desktop connection.
    in property <int> operation: 0;
    private property <bool> whole-server: (root.windows-platform || root.linux-platform) && root.source-kind == 3;
    private property <bool> native-smb: (root.windows-platform || root.linux-platform) && (root.source-kind == 0 || root.whole-server);
    out property <bool> can-register-source: !root.disconnected-view && !root.busy && root.source-path != "" && (root.whole-server || !root.native-smb || !root.smb-server-only);
    // 0..6 retain registration/access states. 7..20 describe explicit native SMB
    // operations. 21..22 require a separate voluntary reconnection.
    in property <int> result-state: 0;
    in property <string> result-detail;
    out property <[string]> source-kinds: root.windows-platform || root.linux-platform ? [@tr("ui" => "SMB share"), @tr("ui" => "Existing NFS mount"), @tr("ui" => "Local folder"), @tr("ui" => "Complete SMB NAS server")] : [@tr("ui" => "SMB share"), @tr("ui" => "Existing NFS mount"), @tr("ui" => "Local folder")];
    out property <string> access-status: root.busy ? (root.operation == 2 ? @tr("ui" => "Looking for shares on this server…") : root.operation == 3 ? (root.linux-platform ? @tr("ui" => "Waiting for the Ubuntu connection…") : @tr("ui" => "Waiting for the Windows connection…")) : @tr("ui" => "Checking access…")) :
        root.result-state == 1 ? @tr("ui" => "Accessible. No scan has been started.") :
        root.result-state == 2 ? @tr("ui" => "Unavailable. You can still add this source.") :
        root.result-state == 3 ? @tr("ui" => "Access denied. Check permissions in your operating system.") :
        root.result-state == 4 ? (root.whole-server ? (root.linux-platform ? @tr("ui" => "Enter a server name, IP address or smb://server/, without a share.") : @tr("ui" => "Enter a server name, IP address or UNC server root, without a share.")) : (root.linux-platform ? @tr("ui" => "Invalid path. Use smb://server/share, a UNC share, or an existing native mount or folder.") : @tr("ui" => "Invalid path. Use a UNC share or an existing native mount or folder."))) :
        root.result-state == 5 ? @tr("ui" => "Source added. Select it and start its scan explicitly.") :
        root.result-state == 6 ? @tr("ui" => "Source added for this session; saving failed.") :
        root.result-state == 7 || (root.native-smb && root.smb-server-only && root.result-state == 0) ? (root.whole-server ? @tr("ui" => "Server source ready to add, including offline. Scan its selected shares later with Scan.") : (root.linux-platform ? @tr("ui" => "Server address accepted. Search for shares or enter smb://server/share before adding it.") : @tr("ui" => "Server address accepted. Search for shares or enter a full UNC share path before adding it."))) :
        root.result-state == 8 ? @tr("ui" => "Server unavailable. Check its address and network connection, then try again.") :
        root.result-state == 9 ? (root.linux-platform ? @tr("ui" => "Server reachable, but no file shares could be listed. Enter smb://server/share manually.") : @tr("ui" => "Server reachable, but no file shares could be listed. Enter the full UNC path manually.")) :
        root.result-state == 10 ? (root.linux-platform ? @tr("ui" => "Authentication required. Use Connect with Ubuntu, sign in through the Files application, then retry.") : @tr("ui" => "Authentication required. Use Connect with Windows, or establish this connection in Windows Explorer, then retry.")) :
        root.result-state == 11 ? (root.linux-platform ? @tr("ui" => "Credentials rejected by Ubuntu or the server. Check your account and try again.") : @tr("ui" => "Credentials rejected by Windows or the server. Check your account and try again.")) :
        root.result-state == 12 ? @tr("ui" => "Share not found. Check its name or search the server's shares again.") :
        root.result-state == 13 ? (root.linux-platform ? @tr("ui" => "Ubuntu mount available for scanning. No scan has been started.") : @tr("ui" => "Windows connection established. No scan has been started.")) :
        root.result-state == 14 ? @tr("ui" => "Operation cancelled. No scan has been started.") :
        root.result-state == 15 ? @tr("ui" => "Windows session conflict (1219). A connection using another account already exists. Existing connections have been kept.") :
        root.result-state == 16 ? (root.linux-platform ? @tr("ui" => "Shares could not be listed. Enter smb://server/share or an existing mount; connect in Files if needed.") : @tr("ui" => "Shares could not be listed. Enter a full UNC share path manually; connect to it in Windows Explorer if necessary, then retry.")) :
        root.result-state == 17 ? (root.linux-platform ? @tr("ui" => "Ubuntu SMB tools are unavailable. Connect to smb://server/share in Files, then choose its mounted folder.") : @tr("ui" => "Native SMB discovery and sign-in are available on Windows. Use an existing system mount on this platform.")) :
        root.result-state == 18 ? (root.whole-server ? @tr("ui" => "Server source ready to add, including offline. Scan its selected shares later with Scan.") : @tr("ui" => "Select a share from the list, then add it. No scan has been started.")) :
        root.result-state == 19 ? (root.linux-platform ? @tr("ui" => "Share listing denied. Connect with Ubuntu, then retry, or enter smb://server/share manually.") : @tr("ui" => "Share listing denied. Use Connect with Windows, then retry, or enter a full UNC share path manually.")) :
        root.result-state == 20 ? @tr("ui" => "Ubuntu connection requested. Finish signing in through Files, then retry. Scanning requires an accessible mounted folder.") :
        root.result-state == 21 ? @tr("ui" => "This source was disconnected. Click Reconnect to restore it. No scan will be started.") :
        root.result-state == 22 ? @tr("ui" => "This share is unavailable because its NAS server is disconnected. Reconnect the server first; individually disconnected shares will stay disconnected.") :
        @tr("ui" => "Access has not been checked.");
    callback input-changed();
    callback type-changed();
    callback check-access();
    callback add-source();
    callback reconnect-source(int);
    callback browse-source();
    callback find-shares();
    callback select-share(int);
    callback connect-share();
    callback cancel();
    forward-focus: add-source-tab;
    FocusScope {
        width: 100%; height: 100%;
        focus-on-tab-navigation: false;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); return accept; } return reject; }
        VerticalLayout {
            padding: 16px; spacing: 8px;
            HorizontalLayout {
                spacing: 8px; vertical-stretch: 0;
                add-source-tab := Button {
                    text: @tr("ui" => "Add a source");
                    checkable: false; checked: !root.disconnected-view; enabled: !root.busy;
                    clicked => { root.disconnected-view = false; }
                }
                disconnected-source-tab := Button {
                    text: @tr("ui" => "Disconnected sources");
                    checkable: false; checked: root.disconnected-view; enabled: !root.busy;
                    clicked => { root.disconnected-view = true; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.disconnected-view: VerticalLayout {
                spacing: 8px;
                Text {
                    text: @tr("ui" => "Reconnect a source to restore it to the active lists. No scan will be started.");
                    color: WorkshopTheme.ink; wrap: word-wrap;
                }
                if root.disconnected-sources.length > 0: ComboBox {
                    model: root.disconnected-sources;
                    current-index <=> root.selected-disconnected;
                    enabled: !root.busy;
                    accessible-label: @tr("ui" => "Disconnected sources");
                }
                if root.disconnected-sources.length == 0: Text {
                    text: @tr("ui" => "No disconnected sources.");
                    color: WorkshopTheme.ink; wrap: word-wrap;
                }
                if root.result-state == 21 || root.result-state == 22 || root.reconnect-status != "": Text {
                    text: root.result-state == 21 || root.result-state == 22 ? root.access-status : root.reconnect-status;
                    color: WorkshopTheme.ink; wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px; vertical-stretch: 0;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("ui" => "Close"); clicked => { root.cancel(); } }
                    Button {
                        text: @tr("ui" => "Reconnect");
                        enabled: !root.busy && root.selected-disconnected >= 0 && root.selected-disconnected < root.disconnected-sources.length;
                        clicked => { root.reconnect-source(root.selected-disconnected); }
                    }
                }
            }
            if !root.disconnected-view: VerticalLayout {
                spacing: 8px;
                Text { text: @tr("ui" => "Source type"); color: WorkshopTheme.ink; }
                source-type := ComboBox { model: root.source-kinds; current-index <=> root.source-kind; selected => { root.type-changed(); } enabled: !root.busy; accessible-label: @tr("ui" => "Source type"); }
                Text { text: root.native-smb ? @tr("ui" => "Server or share") : @tr("ui" => "Native path"); color: WorkshopTheme.ink; }
                HorizontalLayout {
                    spacing: 6px;
                    source-path-field := LineEdit {
                        text <=> root.source-path; enabled: !root.busy; horizontal-stretch: 1;
                        placeholder-text: root.native-smb ? (root.linux-platform ? @tr("ui" => "Server name, IP address or smb://server/share") : @tr("ui" => "Server name, IP address or full UNC share")) : root.windows-platform ? "Z:\\" : "/mnt/share";
                        accessible-label: root.native-smb ? @tr("ui" => "Server or share") : @tr("ui" => "Native path");
                        edited => { root.input-changed(); }
                    }
                    if !root.native-smb || (root.linux-platform && !root.whole-server): Button { text: @tr("ui" => "Browse…"); enabled: !root.busy; clicked => { root.browse-source(); } }
                }
                Text {
                    text: root.whole-server ? @tr("ui" => "Add the server as a logical source. No share discovery or scan is required to save it.") : root.native-smb ? (root.linux-platform ? @tr("ui" => "Enter a server name, IP or smb://server/share. An existing SMB mount can also be used.") : @tr("ui" => "Enter a server name or IP, then search its shares; or enter a full UNC share path.")) : root.source-kind == 2 ? @tr("ui" => "Choose an existing local folder.") : @tr("ui" => "Choose an existing system mount. The application does not mount network shares.");
                    color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap;
                }
                if root.native-smb: HorizontalLayout {
                    spacing: 8px; vertical-stretch: 0;
                    Button { text: @tr("ui" => "Find shares"); enabled: !root.busy && root.source-path != ""; clicked => { root.find-shares(); } }
                    Button { text: (root.linux-platform ? @tr("ui" => "Connect with Ubuntu") : @tr("ui" => "Connect with Windows")); enabled: !root.busy && root.source-path != ""; clicked => { root.connect-share(); } }
                }
                if root.native-smb && !root.whole-server && root.shares.length > 0: Text { text: @tr("ui" => "Shares on this server"); color: WorkshopTheme.ink; }
                if root.native-smb && !root.whole-server && root.shares.length > 0: share-picker := ComboBox {
                    model: root.shares; current-index <=> root.selected-share;
                    enabled: !root.busy; accessible-label: @tr("ui" => "Shares on this server");
                    selected => { root.select-share(share-picker.current-index); }
                }
                if root.native-smb && root.shares-limited: Text { text: (root.linux-platform ? @tr("ui" => "The share list is limited. You can also enter smb://server/share manually.") : @tr("ui" => "The share list is limited. You can also enter a full UNC share path manually.")); color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
                Text { text: @tr("ui" => "Display name (optional)"); color: WorkshopTheme.ink; }
                LineEdit { text <=> root.display-name; enabled: !root.busy; accessible-label: @tr("ui" => "Display name (optional)"); }
                Text { text: root.native-smb ? (root.linux-platform ? @tr("ui" => "Adding or connecting a source never starts a scan. Ubuntu handles credentials; Bunny and Size does not store passwords.") : @tr("ui" => "Adding or connecting a source never starts a scan. Windows handles credentials; Bunny and Size does not store passwords.")) : @tr("ui" => "Adding a source never starts a scan. No password is requested or stored."); color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
                Text { text: root.access-status; color: WorkshopTheme.ink; wrap: word-wrap; }
                if root.result-detail != "": Text { text: root.result-detail; color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px; vertical-stretch: 0;
                    Button { text: @tr("ui" => "Check access"); enabled: root.can-register-source; clicked => { root.check-access(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("ui" => "Cancel"); clicked => { root.cancel(); } }
                    Button { text: @tr("ui" => "Add source"); enabled: root.can-register-source; clicked => { root.add-source(); } }
                }
            }
        }
    }
}

// The controller owns the immutable request token. This window only emits an
// intention; opening, closing, changing options or pressing Escape has no effect
// on acquisitions. Cancel receives initial focus, including after recreation.
export component NetworkDisconnectWindow inherits Window {
    icon: @image-url("../../../assets/branding/icons/bunny-and-size-256.png");
    out property <string> localized-title: @tr("ui" => "Confirm disconnection");
    title: root.localized-title;
    preferred-width: 660px; preferred-height: 520px;
    min-width: 540px; min-height: 500px;
    background: WorkshopTheme.surface;
    in property <int> request-token;
    in property <string> source-name;
    in property <string> source-path;
    // -1 denotes one source; zero or more denotes the known server scope.
    in property <int> affected-share-count: -1;
    in property <bool> windows-platform: false;
    in property <bool> linux-platform: false;
    in property <bool> linux-option-available: false;
    in-out property <bool> disconnect-linux: false;
    in property <bool> windows-option-available: false;
    in-out property <bool> disconnect-windows: false;
    changed request-token => { root.disconnect-windows = false; root.disconnect-linux = false; }
    out property <string> confirmation-message: @tr("ui" => "Do you really want to disconnect the source {}?", root.source-name);
    out property <string> cancel-label: @tr("ui" => "Cancel");
    out property <string> confirm-label: @tr("ui" => "Confirm disconnection");
    callback accepted(int, bool);
    callback rejected(int);
    forward-focus: disconnect-cancel;
    FocusScope {
        width: 100%; height: 100%; focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape { root.rejected(root.request-token); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: 20px; spacing: 12px;
            Text { text: root.confirmation-message; color: WorkshopTheme.ink; font-weight: 600; wrap: word-wrap; }
            Text { text: root.source-path; color: WorkshopTheme.ink; wrap: word-wrap; }
            if root.affected-share-count >= 0: Text {
                text: @tr("ui" => "Known shares affected: {}. Newly discovered shares will also remain disconnected.", root.affected-share-count);
                color: WorkshopTheme.ink; wrap: word-wrap;
            }
            Text { text: @tr("ui" => "The current scan will be stopped and pending operations cancelled."); color: WorkshopTheme.ink; wrap: word-wrap; }
            Text { text: @tr("ui" => "This source will be excluded from future scans until you explicitly reconnect it. Saved inventories will be kept."); color: WorkshopTheme.ink; wrap: word-wrap; }
            if root.windows-platform: CheckBox {
                text: @tr("ui" => "Also disconnect the network connection in Windows");
                checked <=> root.disconnect-windows;
                enabled: root.windows-option-available;
            }
            if root.windows-platform && !root.windows-option-available: Text {
                text: @tr("ui" => "Windows disconnection is unavailable for this source: its effects on other connections cannot be safely limited.");
                color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap;
            }
            if root.linux-platform: CheckBox {
                text: @tr("ui" => "Also disconnect the mount in Ubuntu");
                checked <=> root.disconnect-linux;
                enabled: root.linux-option-available;
            }
            if root.linux-platform && !root.linux-option-available: Text {
                text: @tr("ui" => "The system mount stays connected. Only an exact user mount can be safely disconnected here; other applications may use this mount.");
                color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 12px; vertical-stretch: 0;
                Rectangle { horizontal-stretch: 1; }
                disconnect-cancel := Button { text: root.cancel-label; clicked => { root.rejected(root.request-token); } }
                Button { text: root.confirm-label; clicked => { root.accepted(root.request-token, (root.windows-platform && root.windows-option-available && root.disconnect-windows) || (root.linux-platform && root.linux-option-available && root.disconnect-linux)); } }
            }
        }
    }
}

export struct SmbShareChoice { name: string, path: string, selected: bool, disconnected: bool }
export struct SmbShareRow { name: string, path: string, size: string, files: string, directories: string, state: string, selected: bool, disconnected: bool }
export struct SmbDisconnectedShareRow { name: string, path: string }

// Shared by storage cards and individual shares. Capture the publication token
// at menu opening so an asynchronous model replacement cannot retarget an action.
component NetworkSourceInteraction inherits ContextMenuArea {
    in property <int> token;
    in property <bool> network: true;
    in property <bool> disconnected;
    in property <bool> reconnect-needed: false;
    in property <bool> reconnect-busy: false;
    in property <bool> selection-enabled: true;
    in property <bool> details-enabled: false;
    in property <string> label;
    out property <bool> has-focus: source-focus.has-focus;
    private property <int> menu-token: -1;
    private property <bool> menu-reconnect: false;
    private property <bool> menu-disconnect: false;
    private property <bool> menu-busy: false;
    callback selected(int);
    callback context-action(int, bool);
    callback expand(bool);
    public function show-source-menu(x: length, y: length) {
        root.menu-token = root.token;
        root.menu-reconnect = root.disconnected || root.reconnect-needed;
        root.menu-disconnect = !root.disconnected;
        root.menu-busy = root.reconnect-busy;
        source-focus.focus();
        root.show({x: x, y: y});
    }
    enabled: root.network;
    forward-focus: source-focus;
    Menu {
        MenuItem {
            title: root.menu-reconnect ? @tr("ui" => "Reconnect") : @tr("ui" => "Disconnect");
            enabled: !root.menu-reconnect || !root.menu-busy;
            activated => { root.context-action(root.menu-token, root.menu-reconnect); }
        }
        MenuItem {
            title: root.menu-reconnect ? @tr("ui" => "Disconnect") : @tr("ui" => "Reconnect");
            enabled: root.menu-reconnect && root.menu-disconnect;
            activated => { root.context-action(root.menu-token, false); }
        }
    }
    source-focus := FocusScope {
        width: 100%; height: 100%;
        accessible-role: button; accessible-label: root.label;
        accessible-action-default => { if root.selection-enabled { root.selected(root.token); } }
        key-pressed(event) => {
            if root.network && (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                root.show-source-menu(8px, 8px); return accept;
            }
            if root.details-enabled && event.text == Key.RightArrow { root.expand(true); return accept; }
            if root.details-enabled && event.text == Key.LeftArrow { root.expand(false); return accept; }
            if root.selection-enabled && (event.text == Key.Return || event.text == Key.Space) { root.selected(root.token); return accept; }
            return reject;
        }
        TouchArea {
            property <int> pressed-token: -1;
            property <bool> left-press: false;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    self.pressed-token = root.token;
                    self.left-press = event.button == PointerEventButton.left;
                    if event.button == PointerEventButton.right {
                        source-focus.focus();
                    }
                }
                // TouchArea grabs every mouse button in Slint 1.18, so the
                // enclosing ContextMenuArea never receives the right press.
                // Open explicitly on release, after the grab has been cleared.
                if root.network && event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    root.show-source-menu(self.mouse-x, self.mouse-y);
                }
                if event.kind == PointerEventKind.cancel { self.left-press = false; }
            }
            clicked => { source-focus.focus(); if self.left-press && root.selection-enabled { root.selected(self.pressed-token); } }
        }
    }
}

// This dialog confirms one immutable scope. Tokens are checked again in Rust;
// model changes, opening the window and toggling choices never start a scan.
export component SmbServerScanWindow inherits Window {
    icon: @image-url("../../../assets/branding/icons/bunny-and-size-256.png");
    out property <string> localized-title: @tr("ui" => "Confirm server scan");
    title: root.localized-title;
    preferred-width: 740px; preferred-height: 620px;
    min-width: 540px; min-height: 560px;
    background: WorkshopTheme.surface;
    in property <int> token;
    in property <string> server-path;
    in property <[SmbShareChoice]> shares;
    in property <bool> busy: false;
    in property <bool> discovery-uncertain: false;
    in property <int> selected-count: 0;
    in property <string> status;
    out property <bool> can-confirm: !root.busy && root.selected-count > 0;
    callback toggle-share(int, int, bool);
    callback select-all(int, bool);
    callback confirm(int);
    callback cancel(int);
    forward-focus: choose-all;
    FocusScope {
        width: 100%; height: 100%; focus-on-tab-navigation: false;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(root.token); return accept; } return reject; }
        VerticalLayout {
            padding: 16px; spacing: 8px;
            Text { text: root.server-path; color: WorkshopTheme.ink; font-weight: 600; wrap: word-wrap; }
            Text { text: @tr("ui" => "Choose the shares for this operation. New shares will not be added during the scan."); color: WorkshopTheme.ink; wrap: word-wrap; }
            Text { text: @tr("ui" => "A server scan may process large amounts of data. You can cancel it."); color: WorkshopTheme.ink; wrap: word-wrap; }
            Text { text: @tr("ui" => "Totals are observed logical sizes, not physical NAS usage. Shares can overlap and count the same data more than once."); color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
            if root.discovery-uncertain: Text { text: @tr("ui" => "Share discovery is limited or uncertain. The server coverage will remain partial or unknown."); color: WorkshopTheme.ink; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px; vertical-stretch: 0;
                choose-all := Button { text: @tr("ui" => "Select all"); enabled: !root.busy; clicked => { root.select-all(root.token, true); } }
                Button { text: @tr("ui" => "Deselect all"); enabled: !root.busy; clicked => { root.select-all(root.token, false); } }
                Text { text: @tr("ui" => "Selected shares: {}", root.selected-count); color: WorkshopTheme.ink; vertical-alignment: center; }
            }
            ListView {
                min-height: 100px; vertical-stretch: 1;
                for share[index] in root.shares: VerticalLayout {
                    padding: 4px; spacing: 2px;
                    CheckBox {
                        text: share.name + (share.disconnected ? " · " + @tr("ui" => "Disconnected") : "");
                        checked: share.selected && !share.disconnected; enabled: !root.busy && !share.disconnected;
                        accessible-label: share.name + ", " + share.path + (share.disconnected ? ", " + @tr("ui" => "Disconnected") : "");
                        toggled => { if !share.disconnected { root.toggle-share(root.token, index, self.checked); } }
                    }
                    Text { text: share.path; color: WorkshopTheme.ink; font-size: 11px; overflow: elide; }
                }
            }
            if root.busy: Text { text: @tr("ui" => "Looking for shares on this server…"); color: WorkshopTheme.ink; }
            if root.status != "": Text { text: root.status; color: WorkshopTheme.ink; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px; vertical-stretch: 0;
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("ui" => "Cancel"); clicked => { root.cancel(root.token); } }
                Button { text: @tr("ui" => "Confirm scan"); enabled: root.can-confirm; clicked => { root.confirm(root.token); } }
            }
        }
    }
}

// Shared search criteria keep their natural control height in every style.
// At narrow widths the second column moves below the first without duplicating
// bindings, focus targets or callbacks.
component SearchCriteria inherits Rectangle {
    in-out property <string> name-filter;
    in-out property <string> path-filter;
    in-out property <string> extension-filter;
    in-out property <string> glob-filter;
    in-out property <string> min-filter;
    in-out property <string> max-filter;
    in-out property <bool> case-sensitive;
    in property <bool> busy;
    out property <bool> two-columns: self.width >= 500px;
    property <length> gap: 6px;
    property <length> field-height: max(32px,name-field.preferred-height, path-field.preferred-height, extension-field.preferred-height, glob-field.preferred-height, min-field.preferred-height, max-field.preferred-height);
    property <length> field-width: root.two-columns ? (self.width - root.gap) / 2 : self.width;
    property <length> field-step: root.field-height + root.gap;
    preferred-height: (root.two-columns ? 3 : 6) * root.field-step + case-control.preferred-height;
    min-height: self.preferred-height; max-height: self.preferred-height;
    callback submit();
    forward-focus: name-field;
    name-field := LineEdit {
        x: 0px; y: 0px; width: root.field-width; height: root.field-height;
        text <=> root.name-filter; enabled: !root.busy;
        placeholder-text: @tr("ui" => "Name contains"); accessible-label: @tr("ui" => "Name contains"); accepted => { root.submit(); }
    }
    path-field := LineEdit {
        x: root.two-columns ? root.field-width + root.gap : 0px;
        y: root.two-columns ? 0px : root.field-step;
        width: root.field-width; height: root.field-height;
        text <=> root.path-filter; enabled: !root.busy;
        placeholder-text: @tr("ui" => "Path contains"); accessible-label: @tr("ui" => "Path contains"); accepted => { root.submit(); }
    }
    extension-field := LineEdit {
        x: 0px; y: (root.two-columns ? 1 : 2) * root.field-step;
        width: root.field-width; height: root.field-height;
        text <=> root.extension-filter; enabled: !root.busy;
        placeholder-text: @tr("ui" => "Extension"); accessible-label: @tr("ui" => "Extension"); accepted => { root.submit(); }
    }
    glob-field := LineEdit {
        x: root.two-columns ? root.field-width + root.gap : 0px;
        y: (root.two-columns ? 1 : 3) * root.field-step;
        width: root.field-width; height: root.field-height;
        text <=> root.glob-filter; enabled: !root.busy;
        placeholder-text: @tr("ui" => "Relative path glob"); accessible-label: @tr("ui" => "Relative path glob"); accepted => { root.submit(); }
    }
    min-field := LineEdit {
        x: 0px; y: (root.two-columns ? 2 : 4) * root.field-step;
        width: root.field-width; height: root.field-height;
        text <=> root.min-filter; enabled: !root.busy;
        placeholder-text: @tr("ui" => "Minimum bytes"); accessible-label: @tr("ui" => "Minimum bytes"); accepted => { root.submit(); }
    }
    max-field := LineEdit {
        x: root.two-columns ? root.field-width + root.gap : 0px;
        y: (root.two-columns ? 2 : 5) * root.field-step;
        width: root.field-width; height: root.field-height;
        text <=> root.max-filter; enabled: !root.busy;
        placeholder-text: @tr("ui" => "Maximum bytes"); accessible-label: @tr("ui" => "Maximum bytes"); accepted => { root.submit(); }
    }
    case-control := CheckBox {
        x: 0px; y: (root.two-columns ? 3 : 6) * root.field-step;
        width: root.width; height: self.preferred-height;
        text: @tr("ui" => "Case sensitive"); checked <=> root.case-sensitive; enabled: !root.busy;
    }
}

component DuplicateContentLimits inherits Rectangle {
    in-out property <string> total-bytes;
    in-out property <string> file-bytes;
    in property <bool> busy;
    in property <string> error;
    callback edited();
    out property <length> inputs-bottom: max(total-input.absolute-position.y + total-input.height,
        file-input.absolute-position.y + file-input.height);
    out property <length> guidance-top: guidance.absolute-position.y;

    // Measure the wrapped text at its actual width before sizing the enclosing
    // scroll content. The inputs keep a full row even when a message wraps.
    preferred-height: self.visible ? validation.y + validation.height : 0px;
    min-height: self.preferred-height;
    max-height: self.preferred-height;

    fields := GridLayout {
        y: 4px; width: root.width; height: max(self.min-height, self.preferred-height); spacing: 6px;
        Row {
            Text { text: @tr("ui" => "Total content read (bytes)"); color: WorkshopTheme.ink; wrap: word-wrap; }
            Text { text: @tr("ui" => "Maximum file size (bytes)"); color: WorkshopTheme.ink; wrap: word-wrap; }
        }
        Row {
            total-input := LineEdit {
                horizontal-stretch: 1;
                text <=> root.total-bytes;
                accessible-label: @tr("ui" => "Total content read (bytes)");
                read-only: root.busy;
                edited => { root.edited(); }
            }
            file-input := LineEdit {
                horizontal-stretch: 1;
                text <=> root.file-bytes;
                accessible-label: @tr("ui" => "Maximum file size (bytes)");
                read-only: root.busy;
                edited => { root.edited(); }
            }
        }
    }
    guidance := Text {
        y: fields.y + max(total-input.y + total-input.height, file-input.y + file-input.height) + 3px;
        width: root.width; height: self.preferred-height;
        text: @tr("ui" => "These limits apply to local Windows searches for this session, including from the Folders pane. Leave a field empty for no limit.");
        color: WorkshopTheme.ink; wrap: word-wrap;
    }
    validation := Text {
        y: guidance.y + guidance.height + (self.visible ? 3px : 0px);
        width: root.width; height: self.visible ? self.preferred-height : 0px;
        visible: root.error != ""; text: root.error; color: WorkshopTheme.ink;
        wrap: word-wrap; font-weight: 600; accessible-label: self.text;
    }
}

component DuplicateResources inherits Rectangle {
    in-out property <string> memory-mib;
    in-out property <string> temporary-mib;
    in property <string> temporary-parent;
    in property <bool> temporary-custom;
    in property <bool> picker-enabled;
    in property <bool> picker-failed;
    in-out property <bool> dirty;
    in-out property <bool> invalid;
    callback browse();
    callback reset-parent();
    callback apply-limits();
    out property <length> apply-x: apply.absolute-position.x + apply.width / 2;
    out property <length> apply-y: apply.absolute-position.y + apply.height / 2;

    preferred-height: self.visible ? form.preferred-height : 0px;
    min-height: self.preferred-height;
    max-height: self.preferred-height;

    form := VerticalLayout {
        width: root.width;
        spacing: 4px; padding-top: 4px; padding-bottom: 4px;
        Text { text: @tr("ui" => "Local temporary folder"); color: WorkshopTheme.ink; wrap: word-wrap; }
        LineEdit {
            text: root.temporary-parent;
            placeholder-text: @tr("ui" => "Automatic");
            accessible-label: @tr("ui" => "Local temporary folder");
            read-only: true;
        }
        HorizontalLayout {
            spacing: 6px;
            Button { text: @tr("ui" => "Browse…"); enabled: root.picker-enabled; clicked => { root.browse(); } }
            Button { text: @tr("ui" => "Use system folder"); enabled: root.temporary-custom && root.picker-enabled; clicked => { root.reset-parent(); } }
        }
        GridLayout {
            spacing: 6px;
            Row {
                Text { text: @tr("ui" => "Search RAM (MiB)"); color: WorkshopTheme.ink; wrap: word-wrap; }
                Text { text: @tr("ui" => "Temporary quota (MiB)"); color: WorkshopTheme.ink; wrap: word-wrap; }
            }
            Row {
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.memory-mib;
                    placeholder-text: @tr("ui" => "Automatic");
                    accessible-label: @tr("ui" => "Search RAM (MiB)");
                    edited => { root.dirty = true; root.invalid = false; }
                    accepted => { root.apply-limits(); }
                }
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.temporary-mib;
                    placeholder-text: @tr("ui" => "Automatic");
                    accessible-label: @tr("ui" => "Temporary quota (MiB)");
                    edited => { root.dirty = true; root.invalid = false; }
                    accepted => { root.apply-limits(); }
                }
            }
        }
        apply := Button { horizontal-stretch: 0; text: @tr("ui" => "Apply limits"); enabled: root.dirty; clicked => { root.apply-limits(); } }
        Text {
            text: @tr("ui" => "Leave a limit blank for Automatic. Changes apply to new searches.");
            color: WorkshopTheme.ink; wrap: word-wrap;
        }
        if root.invalid: Text {
            text: @tr("ui" => "Enter positive whole numbers in MiB within range, or leave a limit blank.");
            color: WorkshopTheme.ink; font-weight: 600; wrap: word-wrap; accessible-label: self.text;
        }
        if root.picker-failed: Text {
            text: @tr("ui" => "Could not choose the temporary folder.");
            color: WorkshopTheme.ink; font-weight: 600; wrap: word-wrap; accessible-label: self.text;
        }
    }
}

// One stable row per chosen folder; the drive is secondary metadata.
component CompareFolderCard inherits Rectangle {
    min-width: 0px;
    in property <string> side;
    in property <string> side-label;
    in property <string> folder-label;
    in property <string> analyze-label;
    in property <string> inventory-info;
    in property <[string]> sources;
    in-out property <int> selected-source;
    in-out property <string> folder;
    in property <bool> busy;
    in property <bool> choosing-folder;
    in property <bool> browse-enabled;
    in property <bool> analyze-enabled;
    callback select(int);
    callback edited();
    callback browse();
    callback analyze();
    property <bool> wide: self.width >= 720px;
    preferred-height: self.wide ? 38px : 72px;
    min-height: self.preferred-height;
    DuplicateSideBadge {
        x: 0px; y: 4px; width: 74px; height: 24px;
        side: root.side; label: root.side-label;
    }
    folder-input := LineEdit {
        x: 78px; y: 0px; height: 32px;
        width: max(40px, root.width - self.x - browse.width - 6px - (root.wide ? 302px : 0px));
        min-width: 0px; text <=> root.folder;
        placeholder-text: root.folder-label; accessible-label: root.folder-label;
        enabled: !root.busy && !root.choosing-folder;
        edited => { root.edited(); }
        accepted => { root.edited(); }
    }
    browse := Button {
        x: root.width - self.width - (root.wide ? 302px : 0px); y: 0px; height: 32px;
        text: @tr("ui" => "Browse…");
        accessible-label: root.folder-label + ": " + @tr("ui" => "Browse…");
        enabled: root.browse-enabled && !root.busy && !root.choosing-folder;
        clicked => { root.browse(); }
    }
    Text {
        x: root.wide ? root.width - 296px : 78px; y: root.wide ? 0px : 36px;
        width: max(0px, root.wide ? 184px : root.width - 190px); height: 32px;
        text: root.inventory-info; accessible-label: root.inventory-info;
        color: WorkshopTheme.ink; overflow: elide; vertical-alignment: center;
    }
    Button {
        x: root.width - 106px; y: root.wide ? 0px : 36px; width: 106px; height: 32px;
        text: root.analyze-label; enabled: root.analyze-enabled; clicked => { root.analyze(); }
    }
}
export struct DuplicateRow {
    group: string, side: string, name: string, location: string, size: string,
    verification: string, selectable: bool, selected: bool, partial: bool, selection-label: string,
    protected: bool, copy: bool, group-start: bool, group-first-file: bool, group-note: string,
    role-label: string, scope-label: string, protected-location: string, name-detail: string,
}

component DuplicateProfileControls inherits VerticalLayout {
    in property <bool> busy;
    in-out property <int> profile-choice: 2;
    in-out property <bool> exhaustive;
    callback profile-changed(int);
    callback exhaustive-changed(bool);
    spacing: 3px;
    HorizontalLayout {
        spacing: 8px;
        ComboBox {
            model: [@tr("ui" => "General search (256 KiB)"), @tr("ui" => "Optimized search (1 MiB)"), @tr("ui" => "Large files only (10 MiB)")];
            accessible-label: @tr("ui" => "Duplicate search profile");
            current-index <=> root.profile-choice;
            enabled: !root.busy && !root.exhaustive;
            selected => { root.profile-changed(self.current-index); }
        }
        CheckBox {
            text: @tr("ui" => "Exhaustive search");
            accessible-label: @tr("ui" => "Include all small files — exhaustive search");
            checked <=> root.exhaustive;
            enabled: !root.busy;
            toggled => { root.exhaustive-changed(self.checked); }
        }
    }
    Text {
        text: root.exhaustive
            ? @tr("ui" => "Includes all small regular files from one byte.")
            : @tr("ui" => "Only files at or above the selected minimum are included.");
        color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap;
    }
}

export struct EmptyResultRow { name: string, path: string, parent: string, detail: string }

export struct AnalysisRow { id: int, label: string, size: string, fraction: float, }
export component AnalysisWindow inherits Window {
    icon: @image-url("../../../assets/branding/icons/bunny-and-size-256.png");
    title: @tr("ui" => "Search / statistics");
    preferred-width: 1000px; preferred-height: 650px;
    min-width: 780px; min-height: 520px;
    background: WorkshopTheme.alternate;
    in-out property <string> name-filter;
    in-out property <string> path-filter;
    in-out property <string> extension-filter;
    in-out property <string> glob-filter;
    in-out property <string> min-filter;
    in-out property <string> max-filter;
    in-out property <bool> case-sensitive: false;
    in-out property <int> sort-order: 0;
    in property <string> source-path;
    in property <string> scope-note;
    in property <string> statistics-note;
    in property <string> result-note;
    in property <string> diagnostic-text;
    in property <string> empty-message;
    in-out property <int> duplicate-profile-choice: 2;
    in-out property <bool> duplicate-exhaustive: false;
    callback duplicate-profile-changed(int);
    callback duplicate-exhaustive-changed(bool);
    in property <bool> duplicates-visible;
    in-out property <bool> errors-visible: false;
    in property <string> page-label;
    in property <bool> has-previous;
    in property <bool> has-next;
    in property <int> selected-id: -1;
    in-out property <bool> statistics-visible: false;
    in property <bool> busy: false;
    in property <string> status;
    in property <[AnalysisRow]> results;
    in property <[AnalysisRow]> statistics;
    callback search();
    callback duplicates();
    callback cancel();
    callback reveal(int);
    callback change-page(bool);
    callback change-sort();
    out property <float> name-input-x: name-input.absolute-position.x / 1px;
    out property <float> name-input-y: name-input.absolute-position.y / 1px;
    out property <float> result-viewport-height: result-list.height / 1px;
    out property <float> result-list-x: result-list.absolute-position.x / 1px;
    out property <float> result-list-y: result-list.absolute-position.y / 1px;
    out property <float> next-button-x: next-button.absolute-position.x / 1px;
    out property <float> next-button-y: next-button.absolute-position.y / 1px;
    VerticalLayout {
        padding: 10px; spacing: 6px;
        LineEdit { text: root.source-path; read-only: true; accessible-label: @tr("ui" => "Analysis source"); }
        analysis-controls := ScrollView {
            min-height: 56px;
            preferred-height: analysis-control-content.preferred-height;
            max-height: self.preferred-height; vertical-stretch: 0;
            horizontal-scrollbar-policy: always-off;
            analysis-control-content := VerticalLayout {
                width: analysis-controls.visible-width - 18px; spacing: 6px;
                name-input := SearchCriteria {
                    name-filter <=> root.name-filter; path-filter <=> root.path-filter;
                    extension-filter <=> root.extension-filter; glob-filter <=> root.glob-filter;
                    min-filter <=> root.min-filter; max-filter <=> root.max-filter;
                    case-sensitive <=> root.case-sensitive; busy: root.busy;
                    submit => { root.search(); }
                }
                HorizontalLayout {
                    ComboBox { model: [@tr("ui" => "Path"), @tr("ui" => "Size: smallest first"), @tr("ui" => "Size: largest first")]; current-index <=> root.sort-order; enabled: !root.busy && !root.duplicates-visible; selected => { root.change-sort(); } }
                }
                HorizontalLayout {
                    Button { horizontal-stretch: 0; vertical-stretch: 0; text: @tr("ui" => "Search"); enabled: !root.busy; clicked => { root.search(); } }
                    Button { horizontal-stretch: 0; vertical-stretch: 0; text: @tr("ui" => "Cancel"); enabled: root.busy; clicked => { root.cancel(); } }
                    CheckBox { text: @tr("ui" => "Statistics"); checked <=> root.statistics-visible; }
                    Button { horizontal-stretch: 0; vertical-stretch: 0; visible: root.diagnostic-text != ""; text: @tr("ui" => "Read errors"); clicked => { root.errors-visible = !root.errors-visible; } }
                }
                DuplicateProfileControls {
                    busy: root.busy;
                    profile-choice <=> root.duplicate-profile-choice;
                    exhaustive <=> root.duplicate-exhaustive;
                    profile-changed(index) => { root.duplicate-profile-changed(index); }
                    exhaustive-changed(value) => { root.duplicate-exhaustive-changed(value); }
                }
                Button { horizontal-stretch: 0; vertical-stretch: 0; text: @tr("ui" => "Find exact duplicates (reads files)"); enabled: !root.busy; clicked => { root.duplicates(); } }
                Text { text: @tr("ui" => "Read-only. No files will be deleted."); wrap: word-wrap; font-size: 12px; }
            }
        }
        TextEdit {
            text: root.errors-visible && root.diagnostic-text != "" ? root.diagnostic-text : root.status + "\n" + root.scope-note + (root.statistics-visible ? "\n" + root.statistics-note : root.duplicates-visible ? "\n" + root.result-note : "") + (root.empty-message != "" ? "\n" + root.empty-message : "");
            read-only: true; min-height: 56px; preferred-height: 76px; max-height: 96px; vertical-stretch: 0;
            accessible-label: root.errors-visible && root.diagnostic-text != "" ? @tr("ui" => "Read errors") : @tr("ui" => "Analysis status and coverage");
        }
        HorizontalLayout {
            visible: !root.statistics-visible; min-height: 0px; max-height: root.statistics-visible ? 0px : 40px;
            Button { text: @tr("ui" => "Previous"); enabled: !root.busy && root.has-previous; clicked => { root.change-page(false); } }
            Text { text: root.page-label; vertical-alignment: center; horizontal-stretch: 1; }
            next-button := Button { text: @tr("ui" => "Next"); enabled: !root.busy && root.has-next; clicked => { root.change-page(true); } }
        }
        result-list := ListView {
            min-height: 80px; vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
            for row in (root.statistics-visible ? root.statistics : root.results): Rectangle {
                height: 38px; width: max(0px, result-list.visible-width - 18px);
                background: row.id >= 0 && row.id == root.selected-id ? WorkshopTheme.alternate : WorkshopTheme.surface;
                Rectangle { height: 4px; y: parent.height - 4px; width: parent.width * row.fraction; background: #23658a; }
                HorizontalLayout {
                    padding: 3px; spacing: 8px;
                    if row.id >= 0: Button { text: @tr("ui" => "Show"); enabled: !root.busy; clicked => { root.reveal(row.id); } }
                    LineEdit { text: row.label; read-only: true; accessible-label: row.label; horizontal-stretch: 1; }
                    Text { text: row.size; min-width: 150px; horizontal-stretch: 0; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
        }
    }
}

export struct ColumnSetting { label: string, shown: bool, pixels: float, }
export struct VolumeRow {
    name: string, summary: string, state: string,
    display-name: string, path: string, compact-summary: string,
    reconnect-needed: bool, reconnect-busy: bool,
    network: bool, disconnected: bool,
    fraction: float, has-usage: bool, selectable: bool, usage-level: int, usage: string, usage-percent: float,
}
export struct TreeRow {
    node-id: int, depth: int, name: string, size: string, path: string, focused: bool,
    expandable: bool, expanded: bool, selected: bool,
    fraction: float, has-weight: bool, proportion: string,
    weight-provisional: bool, color-index: int,
}
export struct DetailRow {
    node-id: int, name: string, path: string, size: string, note: string,
    directory: bool, proportion: string, fraction: float, color-index: int, has-weight: bool, weight-provisional: bool,
    files: string, directories: string, modified: string, accessed: string, allocated: string, owner: string,
}
export struct TopRow { rank: int, name: string, size: string, path: string, }
export struct MapTile {
    node-id: int, name: string, size: string, directory: bool, path: string, partial: bool,
    color-index: int, x: float, y: float, w: float, h: float, band-x: float, band-w: float,
}
component TreemapTile inherits Rectangle {
    in property <MapTile> tile;
    in property <bool> inspected;
    in property <bool> focused;
    callback activate();
    clip: true;
    background: TilePalette.color(tile.color-index);
    border-width: focused || inspected ? 3px : 1px;
    border-color: focused ? #ffdd75 : inspected ? #ffffff : #ffffff80;
    accessible-role: button;
    accessible-label: (tile.directory ? @tr("ui" => "Open folder {}, {}", tile.name, tile.size) : tile.node-id >= 0 ? @tr("ui" => "Inspect file {}, {}", tile.name, tile.size) : @tr("ui" => "Group {}, {}", tile.name, tile.size));
    accessible-action-default => { root.activate(); }
    // Pointer input is owned by the parent map surface; accessibility stays local.
    if root.width > 70px && root.height > 24px: Text {
        x: 7px; y: 4px; width: max(0px, parent.width - 14px); height: 20px;
        text: (root.tile.directory ? "▸ " : "") + root.tile.name;
        color: white; font-size: 12px; font-weight: 600; overflow: elide;
    }
    if root.width > 70px && root.height > 48px: Text {
        x: 7px; y: 26px; width: max(0px, parent.width - 14px); height: 18px;
        text: root.tile.size; color: white; font-size: 11px; overflow: elide;
    }
}
// A native, keyboard-focusable button with an elided display label. Full
// names remain available through accessibility and the read-only path.
component NameButton inherits Rectangle {
    in property <string> label;
    in property <string> action-label;
    callback clicked();
    min-width: 20px;
    Tooltip { Rectangle {width:400px;background:WorkshopTheme.surface;border-width:1px;border-color:WorkshopTheme.border;VerticalLayout{padding:8px;Text{text:root.action-label;color:WorkshopTheme.ink;wrap:word-wrap;}}}}
    Button {
        width: 100%; height: 100%;
        text: ""; accessible-label: root.action-label;
        clicked => { root.clicked(); }
    }
    Text {
        x: 8px; width: parent.width - 16px; height: 100%;
        text: root.label; color: WorkshopTheme.ink; font-size: 12px;
        overflow: elide; vertical-alignment: center;
    }
}
// Platform-independent ribbon tabs. Native widget styles keep their own
// metrics; these navigation tabs share geometry and theme colors everywhere.
component RibbonTab inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in-out property <bool> checked: false;
    in property <bool> checkable: false;
    out property <bool> has-focus: tab-focus.has-focus;
    callback clicked();
    min-width: tab-label.preferred-width + 34px;
    min-height: max(32px, tab-label.preferred-height + 12px);
    horizontal-stretch: 0; vertical-stretch: 0;
    background: root.checked || tab-touch.has-hover ? WorkshopTheme.alternate : WorkshopTheme.surface;
    border-radius: 4px; border-width: root.has-focus || root.checked ? 1px : 0px;
    border-color: root.has-focus ? WorkshopTheme.focus : WorkshopTheme.border;
    forward-focus: tab-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    // WIN-01: embedded vectors keep both indicator states independent of fonts.
    Image {
        x: 10px; y: (parent.height - self.height) / 2;
        width: 10px; height: 10px;
        source: root.icon; colorize: WorkshopTheme.ink;
        accessible-role: none;
    }
    tab-label := Text {
        x: 24px; width: parent.width - 34px; height: 100%;
        text: root.text; color: WorkshopTheme.ink; font-size: 12px;
        vertical-alignment: center; horizontal-alignment: center;
    }
    tab-focus := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    tab-touch := TouchArea {
        clicked => { tab-focus.focus(); root.clicked(); }
    }
}

export struct DiffRow { change:string,old-path:string,new-path:string }
export struct HistoryRow { title: string, state: string, value: string, direction: int }
export struct HistoryPoint { x: float, y: float, previous-x: float, previous-y: float, connect: bool, gap: bool }

component HistoryPlot inherits VerticalLayout {
    in property <[HistoryPoint]> points;
    in property <string> zero;
    in property <string> middle;
    in property <string> maximum;
    in property <string> first;
    in property <string> last;
    spacing: 4px;
    plot-box := Rectangle {
        height: 166px;
        border-radius: 5px;
        background: WorkshopTheme.alternate;
        property <color> line-ink: WorkshopTheme.dark-surface ? #88ccf0 : #20658a;
        for tick[i] in [root.maximum, root.middle, root.zero]: Text {
            x: 8px; width: 96px;
            y: 4px + (parent.height - 26px) * i / 2;
            height: 18px; vertical-alignment: center;
            text: tick; color: WorkshopTheme.ink; font-size: 11px; overflow: elide;
        }
        plot-area := Rectangle {
            x: 108px; y: 13px;
            width: max(1px, parent.width - 126px); height: parent.height - 26px;
            for i in 3: Rectangle {
                y: parent.height * i / 2;
                width: parent.width; height: 1px; background: WorkshopTheme.border;
            }
            for point in root.points: Path {
                visible: point.connect;
                width: parent.width; height: parent.height;
                stroke: plot-box.line-ink; stroke-width: 2px;
                viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
                MoveTo { x: point.previous-x * plot-area.width / 1px; y: point.previous-y * plot-area.height / 1px; }
                LineTo { x: point.x * plot-area.width / 1px; y: point.y * plot-area.height / 1px; }
            }
            for point in root.points: Rectangle {
                x: point.x * parent.width - self.width / 2;
                y: point.y * parent.height - self.height / 2;
                width: point.gap ? 5px : 8px; height: point.gap ? 12px : 8px;
                border-radius: point.gap ? 1px : 4px;
                background: point.gap ? WorkshopTheme.ink : plot-box.line-ink;
            }
        }
    }
    HorizontalLayout {
        padding-left: 108px; padding-right: 8px; spacing: 8px;
        Text { text: root.first; color: WorkshopTheme.ink; font-size: 11px; overflow: elide; }
        Text { text: root.last; color: WorkshopTheme.ink; font-size: 11px; overflow: elide; horizontal-stretch: 1; horizontal-alignment: right; }
    }
    Text {
        text: @tr("ui" => "Dots show complete measurements. Axis marks show gaps. Dates and recorded values are listed below.");
        color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap;
    }
}
