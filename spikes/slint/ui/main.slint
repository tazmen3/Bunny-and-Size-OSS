    in property <bool> top-loading: false;
    callback show-global-top();
    callback top-entry-menu(int, int, float, float);
    public function focus-top() { root.top-visible = true; top-focus.focus(); }
    in property <int> top-selected: -1;
    in property <bool> top-retained: false;
    in-out property <length> top-scroll-y <=> top-view.content-y;
    callback select-top(int); callback reveal-top();
    in property <[TreeRow]> rows;
    in property <[DetailRow]> details;
    in-out property <length> detail-scroll-y <=> details-view.content-y;
    in-out property <length> detail-scroll-x <=> detail-columns.content-x;
    in property <[MapTile]> tiles;
    in property <string> treemap-note: @tr("ui" => "Start a scan to display the Treemap.");
    in property <int> inspected-node: -1;
    in-out property <int> map-cursor: 0;
    // Hover state belongs to the window, independent from keyboard/click selection.
    in-out property <int> map-hover-index: -1;
    in-out property <float> map-origin-x: map-area.absolute-position.x / 1px;
    in-out property <float> map-origin-y: map-area.absolute-position.y / 1px;
    private property <float> map-pointer-x: 0;
    private property <float> map-pointer-y: 0;
    callback map-hover(float, float, bool);
    out property <bool> map-tooltip-visible: root.map-hover-index >= 0 && root.map-hover-index < root.tiles.length && map-area.visible && !root.top-visible && !root.search-visible && !root.preferences-open && !root.cache-visible;
    private property <MapTile> hovered-tile: root.tiles[root.map-hover-index];
    out property <string> map-tooltip-text: root.map-tooltip-visible ? root.hovered-tile.name + "\n" + (root.hovered-tile.node-id < 0 ? @tr("ui" => "Type / status") : root.hovered-tile.directory ? @tr("rust" => "Folder") : @tr("rust" => "File")) + " · " + @tr("ui" => "Logical size") + " : " + root.hovered-tile.size + (root.hovered-tile.partial ? " · " + @tr("rust" => "Partial") : "") + (root.hovered-tile.path != "" ? "\n" + root.hovered-tile.path : "") : "";
    out property <float> map-tooltip-x: map-tooltip.x / 1px;
    out property <float> map-tooltip-y: map-tooltip.y / 1px;
    out property <float> map-tooltip-width: map-tooltip.width / 1px;
    out property <float> map-tooltip-height: map-tooltip.height / 1px;
    function update-map-pointer() {
        root.map-pointer-x = (map-pointer.absolute-position.x + map-pointer.mouse-x) / 1px;
        root.map-pointer-y = (map-pointer.absolute-position.y + map-pointer.mouse-y) / 1px;
        root.map-hover(map-pointer.mouse-x / 1px, map-pointer.mouse-y / 1px, map-pointer.has-hover);
    }
    function refresh-map-hover() {
        root.map-hover(root.map-pointer-x - root.map-origin-x, root.map-pointer-y - root.map-origin-y, map-pointer.has-hover && map-area.visible);
    }
    changed map-origin-x => { root.refresh-map-hover(); }
    changed map-origin-y => { root.refresh-map-hover(); }
    changed tiles => { root.refresh-map-hover(); }
    changed treemap-mode => { root.refresh-map-hover(); }
    in-out property <float> map-width: map-area.width / 1px;
    in-out property <float> map-height: map-area.height / 1px;
    changed map-width => { root.resize-treemap(root.map-width, root.map-height); root.refresh-map-hover(); }
    changed map-height => { root.resize-treemap(root.map-width, root.map-height); root.refresh-map-hover(); }
    callback resize-treemap(float, float);
    callback activate-tile(int);
    callback show-legal();
    callback browse-folder(); callback path-edited();
    callback start-scan(); callback cancel-scan(); callback toggle-node(int);
    callback save-fast-inventory();
    callback select-node(int); callback inspect-entry(int);
    callback go-parent(); callback sort-details(bool); callback change-page(bool, bool);

    VerticalLayout {
        padding: root.compact-view ? 10px : 14px; spacing: 0px;
        HorizontalLayout {
            height: 36px; spacing: 12px;
            Text { text: "Bunny and Size"; color: WorkshopTheme.ink; font-size: root.narrow-view ? 20px : 24px; font-weight: 700; vertical-alignment: center; }
            if !root.narrow-view: Text { text: @tr("ui" => "Storage analysis"); color: WorkshopTheme.ink; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }

        }
        HorizontalLayout {
            spacing: 4px; min-height: 34px; vertical-stretch: 0;
            folders-button := Button { text: @tr("ui" => "Folders"); horizontal-stretch:0; checkable:false; checked:sidebar-outer.shown;
                accessible-expanded: sidebar-outer.shown;
                accessible-label:@tr("ui" => "Collapse or reopen the folders and sources panel");
                clicked => { if root.narrow-view && root.search-visible { root.close-search(); root.set-sidebar-collapsed(false); root.navigation-open=true; } else if root.narrow-view {if root.sidebar-collapsed || !root.navigation-open {root.set-sidebar-collapsed(false);root.navigation-open=true;} else {root.set-sidebar-collapsed(true);root.navigation-open=false;}} else {root.navigation-open=root.sidebar-collapsed;root.set-sidebar-collapsed(!root.sidebar-collapsed);} }
            }
            Rectangle { width: 1px; horizontal-stretch: 0; background: WorkshopTheme.border; }
            navigation-tab := RibbonTab {
                text: @tr("ui" => "Navigation");
                icon: root.ribbon-tab == 0 ? @image-url("icons/ribbon-down.svg") : @image-url("icons/ribbon-right.svg");
                horizontal-stretch: 0; checkable: false; checked: root.ribbon-tab == 0;
                accessible-label: @tr("ui" => "Navigation"); accessible-expanded: root.ribbon-tab == 0;
                clicked => { root.activate-ribbon(0); }
            }
            analysis-tab := RibbonTab {
                text: @tr("ui" => "Analysis");
                icon: root.ribbon-tab == 1 ? @image-url("icons/ribbon-down.svg") : @image-url("icons/ribbon-right.svg");
                horizontal-stretch: 0; checkable: false; checked: root.ribbon-tab == 1;
                accessible-label: @tr("ui" => "Analysis"); accessible-expanded: root.ribbon-tab == 1;
                clicked => { root.activate-ribbon(1); }
            }
            display-tab := RibbonTab {
                text: @tr("ui" => "Display");
                icon: root.ribbon-tab == 2 ? @image-url("icons/ribbon-down.svg") : @image-url("icons/ribbon-right.svg");
                horizontal-stretch: 0; checkable: false; checked: root.ribbon-tab == 2;
                accessible-label: @tr("ui" => "Display"); accessible-expanded: root.ribbon-tab == 2;
                clicked => { root.activate-ribbon(2); }
            }
            extensions-tab := RibbonTab {
                text: @tr("ui" => "Extensions");
                icon: root.ribbon-tab == 3 ? @image-url("icons/ribbon-down.svg") : @image-url("icons/ribbon-right.svg");
                horizontal-stretch: 0; checkable: false; checked: root.ribbon-tab == 3;
                accessible-label: @tr("ui" => "Extensions"); accessible-expanded: root.ribbon-tab == 3;
                clicked => { root.activate-ribbon(3); }
            }
            help-tab := RibbonTab {
                text: @tr("ui" => "Help");
                icon: root.ribbon-tab == 4 ? @image-url("icons/ribbon-down.svg") : @image-url("icons/ribbon-right.svg");
                horizontal-stretch: 0; checkable: false; checked: root.ribbon-tab == 4;
                accessible-label: @tr("ui" => "Help"); accessible-expanded: root.ribbon-tab == 4;
                clicked => { root.activate-ribbon(4); }
            }
            Button {
                visible: root.workshop-live;
                enabled: !root.smb-server-visible;
                text: @tr("ui" => "Saved measures");
                checkable: false; checked: root.cache-visible; horizontal-stretch: 0;
                clicked => { root.toggle-cache-panel(); }
            }
            Rectangle { horizontal-stretch: 1; }
            top-cancel := Button {
                visible: (root.busy || root.cancelling) && root.ribbon-tab != 0;
                min-width: 0px; max-width: self.visible ? 100000px : 0px;
                text: root.cancelling ? @tr("ui" => "Cancelling…") : @tr("ui" => "Cancel");
                accessible-label: @tr("ui" => "Cancel the scan or owner resolution");
                enabled: (root.busy || root.resolve-owner) && !root.cancelling;
                clicked => { root.cancel-scan(); }
            }
        }
        Rectangle {
            visible: root.ribbon-tab==1;
            height: self.visible ? max(36px, analysis-commands.min-height) : 0px; vertical-stretch: 0;
            clip: true;
            analysis-commands := HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 6px;
                Button { text: @tr("ui" => "Tree / Treemap"); checkable: false; checked: !root.top-visible && !root.search-visible; clicked => { if root.cache-visible { root.close-cache-panel(); } if root.search-visible { root.close-search(); } root.top-visible = false; } }
                Button { text: @tr("ui" => "Top 100"); enabled: !root.smb-server-visible; checkable: false; checked: root.top-visible && !root.search-visible; clicked => { if root.cache-visible { root.close-cache-panel(); } if root.search-visible { root.close-search(); } root.show-global-top(); root.focus-top(); } }
                Button { text: @tr("ui" => "Search / statistics"); enabled: root.workshop-live || (!root.smb-server-visible && !root.busy && root.rows.length > 0); clicked => { if root.duplicate-single && !root.search-busy { root.duplicate-mode-changed(0); } root.show-analysis(); } }
                if root.workshop-live: Button {
                    text: @tr("ui" => "Duplicates");
                    enabled: !root.search-busy;
                    clicked => { root.duplicate-mode-changed(3); root.show-analysis(); }
                }
                if root.workshop-live: Rectangle {
                    horizontal-stretch: 0;
                    min-width: empty-analysis-button.min-width;
                    preferred-width: empty-analysis-button.preferred-width;
                    empty-analysis-button := Button {
                        width: 100%; height: 100%;
                        text: @tr("ui" => "Empty items…");
                        clicked => { empty-analysis-menu.show({x: 0px, y: self.height}); }
                    }
                    empty-analysis-menu := ContextMenuArea {
                        x: 0px; y: 0px; width: 0px; height: 0px; enabled: false;
                        Menu {
                            MenuItem {
                                title: @tr("ui" => "Find empty files");
                                activated => { root.open-empty-analysis(1); }
                            }
                            MenuItem {
                                title: @tr("ui" => "Find empty folders");
                                activated => { root.open-empty-analysis(2); }
                            }
                        }
                    }
                }
                saved-measures-button := Button { visible: root.workshop-live; enabled: !root.smb-server-visible; text: @tr("ui" => "Saved measures"); clicked => { root.toggle-cache-panel(); } }
                Text { text: root.workshop-live ? @tr("ui" => "Live inventory") : @tr("ui" => "Retained inventory: transitional view"); color: WorkshopTheme.ink; min-width: 0px; horizontal-stretch: 1; overflow: elide; }
            }
        }
        Rectangle {
            visible: root.ribbon-tab == 2;
            height: self.visible ? max(36px, display-commands.min-height) : 0px; vertical-stretch: 0;
            clip: true;
            display-commands := HorizontalLayout {
                width: 100%; height: 100%; spacing: 14px;
                display-button := Button { text: @tr("ui" => "Columns and display"); horizontal-stretch: 0; enabled: root.ribbon-tab == 2; clicked => { root.preferences-open = !root.preferences-open; } }
                Text { text: @tr("ui" => "Theme"); color: WorkshopTheme.ink; vertical-alignment: center; }
                theme-picker := ComboBox {
                    min-width: 130px; preferred-width: 150px; max-width: 160px; horizontal-stretch: 0;
                    model: [@tr("ui" => "System"), @tr("ui" => "Light"), @tr("ui" => "Dark")];
                    current-index <=> root.theme-choice; accessible-label: @tr("ui" => "Theme");
                    enabled: root.ribbon-tab == 2;
                    selected(value) => { root.set-theme(self.current-index); }
                }
                compact-checkbox := CheckBox {
                    text: @tr("ui" => "Compact"); checked <=> root.dense; horizontal-stretch: 0;
                    enabled: root.ribbon-tab == 2;
                    toggled => { compact-checkbox.focus(); root.set-density(self.checked); }
                }
                Rectangle { min-width: 0px; horizontal-stretch: 1; }
            }
        }
        Rectangle {
            visible: root.ribbon-tab == 2;
            height: self.visible ? max(36px, units-commands.min-height) : 0px; vertical-stretch: 0;
            clip: true;
            units-commands := HorizontalLayout {
                width: 100%; height: 100%; spacing: 12px;
                Text { text: @tr("ui" => "Units"); color: WorkshopTheme.ink; vertical-alignment: center; }
                size-unit-picker := ComboBox {
                    min-width: 130px; preferred-width: 150px; max-width: 160px; horizontal-stretch: 0;
                    model: [@tr("ui" => "Automatic"), root.decimal-units ? @tr("ui" => "kB") : @tr("ui" => "KiB"), root.decimal-units ? @tr("ui" => "MB") : @tr("ui" => "MiB"), root.decimal-units ? @tr("ui" => "GB") : @tr("ui" => "GiB"), root.decimal-units ? @tr("ui" => "TB") : @tr("ui" => "TiB")];
                    current-index <=> root.size-unit-choice; accessible-label: @tr("ui" => "Units for displayed sizes");
                    enabled: root.ribbon-tab == 2;
                    selected(value) => { root.set-size-unit(self.current-index); }
                }
                CheckBox {
                    text: @tr("ui" => "Collect allocated sizes"); horizontal-stretch: 0;
                    checked <=> root.collect-allocation;
                    accessible-label: @tr("ui" => "Collect allocated sizes during the next scan");
                    enabled: root.ribbon-tab == 2 && !root.busy && !root.choosing-folder && root.scan-enabled;
                }
                Button { text: @tr("ui" => "Owners") + (root.collect-owner ? " ✓" : ""); horizontal-stretch: 0;
                    enabled: root.ribbon-tab == 2;
                    accessible-label: @tr("ui" => "Show or hide owner collection and resolution options");
                    clicked => { root.owner-options = !root.owner-options; }
                }
                Rectangle { min-width: 0px; horizontal-stretch: 1; }
            }
        }
        Rectangle {
            visible: root.ribbon-tab == 3;
            height: self.visible ? max(36px, extensions-commands.min-height) : 0px; vertical-stretch: 0;
            clip: true;
            extensions-commands := HorizontalLayout {
                width: 100%; height: 100%;
                Text {text:@tr("ui"=>"Extensions are not available yet. Local disks remain in Navigation.");wrap:word-wrap;color:WorkshopTheme.ink;}
            }
        }
        Rectangle {
            visible: root.ribbon-tab == 4;
            height: self.visible ? max(36px, help-commands.min-height) : 0px; vertical-stretch: 0;
            clip: true;
            help-commands := HorizontalLayout {
                width: 100%; height: 100%;
                Button {text:@tr("ui"=>"About / Licenses");clicked=>{root.show-legal();}}
                Button {text:@tr("ui"=>"Official repository");clicked=>{root.open-project();}}
                Text {text:@tr("ui"=>"Documentation is not published yet.");wrap:word-wrap;color:WorkshopTheme.ink;}
            }
        }
        if root.workshop-live: Rectangle {
            visible: root.ribbon-tab==2;
            height: self.visible ? max(36px, memory-commands.min-height) : 0px; vertical-stretch: 0;
            clip: true;
            memory-commands := HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 6px;
                Text { text: @tr("ui" => "Requested memory:"); color: WorkshopTheme.ink; vertical-alignment: center; }
                ComboBox { model: [@tr("ui" => "Automatic"), "50 000", "250 000", "1 000 000", "5 000 000", @tr("ui" => "Unlimited count")]; current-index <=> root.memory-choice; accessible-label: @tr("ui" => "Requested memory:"); selected(value) => { root.memory-select(self.current-index); } }
                LineEdit { preferred-width: 100px; text <=> root.memory-limit; placeholder-text: @tr("ui" => "Auto"); accessible-label: @tr("ui" => "Memory limit (MiB, empty = automatic)"); accepted => { root.memory-limit-apply(); } }
                Button { text: @tr("ui" => "Apply memory limit"); clicked => { root.memory-limit-apply(); } }
                Text { text: root.memory-status; color: WorkshopTheme.ink; wrap: word-wrap; horizontal-stretch: 1; font-size: 10px; }
            }
        }
        scan-toolbar := Rectangle {
            visible: root.ribbon-tab==0;
            height: self.visible ? max(36px, scan-commands.min-height) : 0px; vertical-stretch: 0;
            clip: true;
            scan-commands := HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 6px;
                LineEdit {
                    text <=> root.scan-path; placeholder-text: @tr("ui" => "Path of the folder to scan");
                    accessible-label: @tr("ui" => "Folder to scan");
                    enabled: !root.busy && !root.choosing-folder && root.scan-enabled;
                    edited => { root.path-edited(); }
                    accepted => { root.start-scan(); }
                }
                Button {
                    text: @tr("ui" => "Browse…"); accessible-label: @tr("ui" => "Choose a folder to scan");
                    enabled: root.folder-picker-enabled && root.scan-enabled && !root.busy && !root.choosing-folder;
                    clicked => { root.browse-folder(); }
                }
                ComboBox {
                    model: [@tr("ui" => "1 folder at a time"), @tr("ui" => "2 folders in parallel"), @tr("ui" => "4 folders in parallel"), @tr("ui" => "8 folders in parallel")];
                    current-index <=> root.worker-choice;
                    accessible-label: @tr("ui" => "Folders scanned concurrently");
                    enabled: !root.workshop-live && !root.busy && !root.choosing-folder && root.scan-enabled;
                }
                Button { text: @tr("ui" => "Scan"); enabled: !root.busy && !root.choosing-folder && root.scan-enabled; clicked => { root.start-scan(); } }
                scan-cancel := Button { text: root.cancelling ? @tr("ui" => "Cancelling…") : @tr("ui" => "Cancel"); accessible-label: @tr("ui" => "Cancel the scan or owner resolution"); enabled: (root.busy || root.resolve-owner) && !root.cancelling; clicked => { root.cancel-scan(); } }
            }
        }
        navigation-toolbar := Rectangle {
            visible: !root.search-visible && root.ribbon-tab==0;
            height: self.visible ? max(36px, navigation-commands.min-height) : 0px; vertical-stretch: 0;
            clip: true;
            navigation-commands := HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 4px;
                Button { text: root.top-visible ? @tr("ui" => "Tree / Treemap") : @tr("ui" => "Top 100"); enabled: !root.smb-server-visible; accessible-label: @tr("ui" => "Switch between Top 100 and browsing"); clicked => { if root.top-visible { root.top-visible = false; } else { root.show-global-top(); root.focus-top(); } } }
                Button { text: @tr("ui" => "Treemap"); enabled: !root.smb-server-visible; accessible-label: @tr("ui" => "Treemap"); clicked => { root.top-visible = false; root.treemap-expanded = !root.treemap-expanded; if !root.compact-view || root.treemap-expanded { map-focus.focus(); } } }
                Button { text: @tr("ui" => "↑ Parent"); accessible-label: @tr("ui" => "Go to the parent folder"); enabled: root.has-parent; clicked => { root.go-parent(); } }
                if root.can-load-details: Button { text: @tr("ui" => "Load folder contents"); enabled: !root.busy; clicked => { root.load-folder-details(); } }
                LineEdit { text: root.current-path; read-only: true; placeholder-text: @tr("ui" => "Current folder"); accessible-label: @tr("ui" => "Path of the current folder"); }
            }
        }
        if root.workshop-live && root.scan-fast-available && root.scan-fast-can-save && root.ribbon-tab == 0 && !root.smb-server-visible && !root.search-visible: HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;
            Button {
                text: @tr("ui" => "Save the inventory");
                clicked => { root.save-fast-inventory(); }
            }
        }
        if root.owner-options && root.ribbon-tab == 2: HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: @tr("ui" => "Collect owners"); checked <=> root.collect-owner;
                toggled => { if !root.collect-owner && !root.targeted-owner { root.resolve-owner = false; root.owner-resolution-changed(); } }
                accessible-label: @tr("ui" => "Collect native owners during the next scan");
                enabled: !root.busy && !root.choosing-folder && root.scan-enabled;
            }
            CheckBox {
                text: root.local-owner-resolution ? @tr("ui" => "Resolve local account names") : @tr("ui" => "Resolve names (NSS / AD: network possible)"); checked <=> root.resolve-owner;
                toggled => { root.owner-resolution-changed(); }
                accessible-label: root.local-owner-resolution ? @tr("ui" => "Resolve account names from local files only; no network lookup") : @tr("ui" => "Explicitly allow name resolution; NSS or Active Directory may access the network");
                enabled: (root.targeted-owner || (root.collect-owner && !root.busy)) && root.scan-enabled;
            }
            Button { text: @tr("ui" => "Stop resolution"); enabled: root.resolve-owner;
                clicked => { root.resolve-owner = false; root.owner-resolution-changed(); }
            }
        }
        workspace-area := Rectangle {
            vertical-stretch: 1;
            workspace := HorizontalLayout {
                width: 100%; height: 100%; visible: !root.top-visible && !(root.workshop-live && root.cache-visible);
                spacing: 0px;
                // Layout stretch avoids a window-size/minimum-size binding loop.
                sidebar-outer := Rectangle {
                    property <bool> shown:!root.sidebar-collapsed && (!root.narrow-view || root.navigation-open) && !(root.narrow-view && root.search-visible);
                    min-width: shown ? clamp(root.sidebar-width * 1px,220px,max(220px,root.sidebar-limit*1px)) : 0px;
                    max-width:self.min-width; horizontal-stretch:0;
                    visible: shown; clip:true;
                    min-height:0px;
                    background: WorkshopTheme.surface; border-color: WorkshopTheme.border; border-width: 1px; border-radius: 5px;
                    VerticalLayout {
                        padding: 8px; spacing: 6px;
                        sidebar-panels := Rectangle {
                            min-height: 242px; preferred-height: 300px; max-height: 100000px; vertical-stretch: 1;
                                folders-pane := Rectangle {
                                    x: 0px; y: 0px;
                                    width: parent.width;
                                    height: root.storage-enabled ? clamp((sidebar-panels.height - 12px) * root.sidebar-ratio / 1000, 80px, max(80px, sidebar-panels.height - 162px)) : sidebar-panels.height;
                                    VerticalLayout {
                                        x: 0px; y: 0px; width: 100%; height: 100%;
                        HorizontalLayout {
                            height: 30px; padding-right: root.scrollbar-gutter + 4px;
                            Text { text: @tr("ui" => "FOLDERS"); color: WorkshopTheme.ink; font-size: 11px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: @tr("ui" => "Folder share"); color: WorkshopTheme.ink; font-size: 10px; vertical-alignment: center; }
                        }
                        if root.smb-server-context: Button {
                            text: root.smb-server-title;
                            accessible-label: @tr("ui" => "Back to the NAS server") + ": " + root.smb-server-title;
                            clicked => { root.smb-server-home(); }
                        }
                        if root.smb-server-visible: ListView {
                            min-height: 0px; vertical-stretch: 1;
                            for share[index] in root.smb-share-rows: Rectangle {
                                height: 42px;
                                background: share.selected ? WorkshopTheme.alternate : WorkshopTheme.surface;
                                border-width: share-interaction.has-focus ? 2px : 0px; border-color: WorkshopTheme.focus;
                                Text { x: 8px; width: parent.width - 16px; height: 100%; text: share.name + " · " + share.state; color: WorkshopTheme.ink; overflow: elide; vertical-alignment: center; }
                                share-interaction := NetworkSourceInteraction {
                                    width: 100%; height: 100%; token: root.smb-server-token;
                                    disconnected: share.disconnected;
                                    label: share.name + ", " + share.state;
                                    selected(token) => { root.smb-share-open(token, index); }
                                    context-action(token, reconnect) => { root.smb-share-context-action(token, index, reconnect); }
                                }
                            }
                        }
                        tree-focus := FocusScope {
                            min-height: 0px; preferred-height: 0px; vertical-stretch: 1;
                            visible: !root.smb-server-visible;
                            max-height: root.smb-server-visible ? 0px : 100000px;
                            accessible-role: groupbox;
                            accessible-label: @tr("ui" => "Folders");
                            property <bool> pointer-menu-armed: false;
                            function row-menu-pointer(event: PointerEvent, index: int, x: length, y: length) {
                                if event.kind == PointerEventKind.cancel { self.pointer-menu-armed = false; }
                                if event.button == PointerEventButton.right {
                                    if event.kind == PointerEventKind.down {
                                        self.pointer-menu-armed = root.workshop-live && root.prepare-tree-menu(index) >= 0;
                                    } else if event.kind == PointerEventKind.up && self.pointer-menu-armed {
                                        self.pointer-menu-armed = false;
                                        folders-menu.show({x: x - self.absolute-position.x, y: y - self.absolute-position.y});
                                    }
                                }
                            }
                            key-pressed(event) => {
                                if root.workshop-live && (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                                    let index = root.prepare-tree-menu(-1);
                                    if index < 0 { return reject; }
                                    let y = (index + 1) * root.tree-row-height * 1px + root.sidebar-folder-scroll;
                                    folders-menu.show({x: 8px, y: clamp(y, 0px, self.height)});
                                    return accept;
                                }
                                if event.text == Key.UpArrow { root.tree-key(0); return accept; }
                                if event.text == Key.DownArrow { root.tree-key(1); return accept; }
                                if event.text == Key.LeftArrow { root.tree-key(2); return accept; }
                                if event.text == Key.RightArrow { root.tree-key(3); return accept; }
                                if event.text == Key.Return || event.text == Key.Space { root.tree-key(4); return accept; }
                                if event.text == Key.Home { root.tree-key(5); return accept; }
                                if event.text == Key.End { root.tree-key(6); return accept; }
                                return reject;
                            }
                            folders-menu := ContextMenuArea {
                                x: 0px; y: 0px; width: 0px; height: 0px;
                                // Explicit dispatch anchors the menu to the target captured on press.
                                enabled: false;
                                Menu {
                                    MenuItem {
                                        title: @tr("ui" => "Find duplicates");
                                        enabled: !root.choosing-folder;
                                        activated => { root.tree-find-duplicates(); }
                                    }
                                    MenuItem {
                                        title: @tr("ui" => "Find empty items");
                                        enabled: !root.choosing-folder;
                                        activated => { root.tree-find-empty(); }
                                    }
                                    MenuItem {
                                        title: @tr("ui" => "Top 100 files");
                                        activated => { root.tree-top-files(); }
                                    }
                                }
                            }
                            folders-list := ListView {
                                width: 100%; height: 100%;
                                content-width: max(self.visible-width, max(0, root.tree-max-depth) * 16px + 180px + root.scrollbar-gutter);
                                horizontal-scrollbar-policy: as-needed;
                                for row in root.rows: folder-row := Rectangle {
                                    width: max(0px, folders-list.content-width - root.scrollbar-gutter);
                                    height: root.tree-row-height * 1px;
                                    property <length> indent: max(0, row.depth) * 16px;
                                    property <length> gauge-width: 66px;
                                    background: row.selected || tree-row-touch.has-hover ? WorkshopTheme.alternate : WorkshopTheme.surface;
                                    border-radius: 3px;
                                    accessible-role: button;
                                    accessible-label: row.name + " · " + row.size + " · " + row.proportion;
                                    accessible-item-selectable: true;
                                    accessible-item-selected: row.selected;
                                    accessible-expandable: row.expandable;
                                    accessible-expanded: row.expanded;
                                    accessible-action-expand => { if row.expandable { tree-focus.focus(); root.toggle-node(row.node-id); } }
                                    accessible-action-default => { tree-focus.focus(); root.select-node(row.node-id); }
                                    if row.selected: Rectangle {
                                        x: 0px; y: 3px; width: 3px; height: parent.height - 6px;
                                        border-radius: 1px; background: WorkshopTheme.ink;
                                    }
                                    if tree-focus.has-focus && row.focused: Rectangle {
                                        width: 100%; height: 100%; background: transparent;
                                        border-width: 1px; border-color: WorkshopTheme.focus; border-radius: 3px;
                                    }
                                    TouchArea {
                                        enabled: root.workshop-live;
                                        width: folder-row.indent + 26px; height: 100%;
                                        pointer-event(event) => {
                                            tree-focus.row-menu-pointer(event, row.node-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                    Tooltip { Rectangle { width: 400px; background: WorkshopTheme.surface; border-width: 1px; border-color: WorkshopTheme.border;
                                        VerticalLayout { padding: 8px; spacing: 4px;
                                            Text { text: row.name + " · " + row.size; color: WorkshopTheme.ink; wrap: word-wrap; }
                                            Text { text: @tr("ui" => "Folder share") + " : " + row.proportion + (row.weight-provisional ? " · " + @tr("ui" => "Provisional") : ""); color: WorkshopTheme.ink; wrap: word-wrap; }
                                            if row.path != "": Text { text: row.path; color: WorkshopTheme.ink; wrap: word-wrap; }
                                        }
                                    }}
                                    // A dedicated expansion target leaves selection and the main pane intact.
                                    if row.expandable: Rectangle {
                                        x: folder-row.indent + 4px; width: 22px; height: 100%;
                                        accessible-role: button;
                                        accessible-label: row.expanded ? @tr("ui" => "Collapse {}", row.name) : @tr("ui" => "Expand {}", row.name);
                                        accessible-action-default => { tree-focus.focus(); root.toggle-node(row.node-id); }
                                        Text { width: 100%; height: 100%; text: row.expanded ? "⌄" : "›"; color: WorkshopTheme.ink; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { tree-focus.focus(); root.toggle-node(row.node-id); }
                                            pointer-event(event) => {
                                                tree-focus.row-menu-pointer(event, row.node-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                if root.workshop-live && event.button == PointerEventButton.left {
                                                    if event.kind == PointerEventKind.down { root.workshop-gesture(true); }
                                                    else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.workshop-gesture(false); }
                                                }
                                            }
                                        }
                                    }
                                    folder-icon := Rectangle {
                                        x: folder-row.indent + 28px; y: (parent.height - 13px) / 2;
                                        width: 16px; height: 13px; background: transparent;
                                        Rectangle { x: 0px; y: 0px; width: 8px; height: 5px; background: #c59032; border-radius: 1px; }
                                        Rectangle { x: 0px; y: 3px; width: 16px; height: 10px; background: row.expanded ? #d5a445 : #be8a2c; border-radius: 2px; }
                                    }
                                    Text {
                                        x: folder-icon.x + folder-icon.width + 6px; y: 0px;
                                        width: max(0px, folder-row.width - self.x - folder-row.gauge-width - 10px); height: 100%;
                                        text: row.name; color: WorkshopTheme.ink; font-size: 12px;
                                        font-weight: row.selected ? 600 : 400;
                                        overflow: elide; vertical-alignment: center;
                                    }
                                    // Percentage text uses the complete gauge area, even for a tiny fill.
                                    Rectangle {
                                        x: parent.width - folder-row.gauge-width - 4px; y: (parent.height - 20px) / 2;
                                        width: folder-row.gauge-width; height: 20px; clip: true;
                                        background: WorkshopTheme.alternate; border-radius: 3px;
                                        border-width: row.weight-provisional ? 1px : 0px; border-color: WorkshopTheme.border;
                                        Rectangle {
                                            x: 0px; y: 0px;
                                            width: row.has-weight ? parent.width * clamp(row.fraction, 0, 1) : 0px; height: 100%;
                                            background: TilePalette.color(row.color-index); opacity: row.weight-provisional ? 0.14 : 0.24;
                                        }
                                        Rectangle {
                                            x: 0px; y: parent.height - 3px; height: 3px;
                                            width: row.has-weight ? parent.width * clamp(row.fraction, 0, 1) : 0px;
                                            background: TilePalette.color(row.color-index);
                                        }
                                        Text { width: 100%; height: parent.height - 2px; text: row.proportion; color: WorkshopTheme.ink; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    tree-row-touch := TouchArea {
                                        x: folder-row.indent + 26px; width: max(0px, parent.width - self.x); height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => { tree-focus.focus(); root.select-node(row.node-id); }
                                        double-clicked => { if row.expandable { root.toggle-node(row.node-id); } }
                                        pointer-event(event) => {
                                            tree-focus.row-menu-pointer(event, row.node-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            if root.workshop-live && event.button == PointerEventButton.left {
                                                if event.kind == PointerEventKind.down { root.workshop-gesture(true); }
                                                else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.workshop-gesture(false); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if !root.smb-server-visible && (root.has-previous-page || root.has-next-page): HorizontalLayout {
                            spacing: 4px;
                            Button { text: "←"; accessible-label: @tr("ui" => "Previous page of folders"); enabled: root.has-previous-page; clicked => { root.change-page(false, false); } }
                            Text { text: root.tree-page; color: WorkshopTheme.ink; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            Button { text: "→"; accessible-label: @tr("ui" => "Next page of folders"); enabled: root.has-next-page; clicked => { root.change-page(false, true); } }
                        }
                                    }
                                }
                                sidebar-divider := Rectangle {
                                    width: parent.width; y: folders-pane.height;
                                    height: root.storage-enabled ? 12px : 0px;
                                    visible: root.storage-enabled;
                                    background: divider-focus.has-focus || divider-touch.has-hover ? WorkshopTheme.alternate : WorkshopTheme.surface;
                                    accessible-role: slider;
                                    accessible-label: @tr("ui" => "Resize folders and storage sources. Arrows adjust; Enter resets.");
                                    accessible-orientation: vertical;
                                    accessible-value: root.sidebar-ratio;
                                    accessible-value-minimum: 100;
                                    accessible-value-maximum: 900;
                                    accessible-value-step: 25;
                                    accessible-action-set-value(v) => { if v.is-float() { root.resize-sidebar(round(v.to-float())); } }
                                    accessible-action-increment => { root.resize-sidebar(root.sidebar-ratio + 25); }
                                    accessible-action-decrement => { root.resize-sidebar(root.sidebar-ratio - 25); }
                                    forward-focus: divider-focus;
                                    Rectangle { x: parent.width * 0.35; y: 5px; width: 30%; height: 2px; background: #708ba2; }
                                    divider-focus := FocusScope {
                                        key-pressed(event) => {
                                            if event.text == Key.UpArrow { root.resize-sidebar(root.sidebar-ratio - 25); return accept; }
                                            if event.text == Key.DownArrow { root.resize-sidebar(root.sidebar-ratio + 25); return accept; }
                                            if event.text == Key.Home { root.resize-sidebar(100); return accept; }
                                            if event.text == Key.End { root.resize-sidebar(900); return accept; }
                                            if event.text == Key.Return { root.resize-sidebar(550); return accept; }
                                            return reject;
                                        }
                                    }
                                    divider-touch := TouchArea {
                                        mouse-cursor: ns-resize;
                                        property <length> start-height;
                                        property <length> start-y;
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                self.start-height = folders-pane.height;
                                                self.start-y = sidebar-divider.y + self.mouse-y;
                                                divider-focus.focus();
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.resize-sidebar(round(1000 * (self.start-height + sidebar-divider.y + self.mouse-y - self.start-y) / max(1px, sidebar-panels.height - 12px)));
                                            }
                                        }
                                    }
                                }
                        sources-pane := VerticalLayout {
                            width: sidebar-panels.width;
                            y: folders-pane.height + sidebar-divider.height;
                            height: sidebar-panels.height - self.y;
                            visible: root.storage-enabled;
                            min-height: root.storage-enabled ? 150px : 0px;
                            vertical-stretch: 1;
                            spacing: 3px;
                            HorizontalLayout {
                                Text { text: @tr("ui" => "STORAGE SOURCES"); font-size: 10px; color: WorkshopTheme.ink; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                Button { text: @tr("ui" => "Refresh"); enabled: !root.storage-loading; clicked => { root.refresh-volumes(false); } }
                            }
                            Button { text: @tr("ui" => "+ Add a source"); clicked => { root.show-add-source(); } }
                            Text { text: root.storage-status; font-size: 10px; color: WorkshopTheme.ink; overflow: elide; }
                            sources-list := ScrollView {
                                horizontal-scrollbar-policy: always-off;
                                min-height: 40px;
                                vertical-stretch: 1;
                                accessible-role: list;
                                accessible-orientation: vertical;
                                content-height: source-cards.preferred-height;
                                // Sources are bounded. Layout every card at its actual width so
                                // the scroll range and row offsets include the expanded text.
                                source-cards := VerticalLayout {
                                    x: 0px; y: 0px;
                                    width: max(0px, sources-list.visible-width - root.scrollbar-gutter);
                                    height: self.preferred-height;
                                    spacing: 0px; alignment: start;
                                    for volume[index] in root.volumes: source-card := Rectangle {
                                        private property <string> details-key: volume.name + "\n" + volume.path;
                                        private property <bool> expanded: root.source-details-key == self.details-key;
                                        private property <length> details-width: max(0px, self.width - 10px);
                                        Tooltip { Rectangle {width:400px;background:WorkshopTheme.surface;border-width:1px;border-color:WorkshopTheme.border;VerticalLayout{padding:8px;Text{text:volume.name + "\n" + volume.summary + "\n" + volume.usage + "\n" + volume.state;color:WorkshopTheme.ink;wrap:word-wrap;}}}}
                                        height: max(52px, source-card-content.preferred-height);
                                        background: root.selected-volume == index ? WorkshopTheme.alternate : WorkshopTheme.surface;
                                        border-width: root.scanned-volume == index ? 2px : 0px; border-color: WorkshopTheme.focus;
                                        source-interaction := NetworkSourceInteraction {
                                            width: 100%; height: 100%; token: root.storage-token;
                                            network: volume.network; disconnected: volume.disconnected;
                                            reconnect-needed: volume.reconnect-needed; reconnect-busy: volume.reconnect-busy;
                                            details-enabled: true;
                                            selection-enabled: !root.choosing-folder && root.scan-enabled;
                                            label: @tr("ui" => "Select source: {}", volume.name);
                                            selected(token) => { if root.workshop-live {root.workshop-source(token,index);} else {root.select-volume(index);} }
                                            context-action(token, reconnect) => { root.source-context-action(token, index, reconnect); }
                                            expand(open) => { root.source-details-key = open ? source-card.details-key : ""; }
                                        }
                                        source-card-content := VerticalLayout {
                                            width: source-card.width;
                                            padding: 5px; spacing: 3px;
                                            HorizontalLayout {
                                                spacing: 5px;
                                                // Original small disk/NAS glyph, drawn with theme colors.
                                                Rectangle {
                                                    width: 18px; min-height: 32px; horizontal-stretch: 0;
                                                    Rectangle { x: 1px; y: 5px; width: 16px; height: volume.network ? 9px : 21px; border-radius: 2px; background: transparent; border-width: 1px; border-color: WorkshopTheme.ink; }
                                                    if volume.network: Rectangle { x: 1px; y: 17px; width: 16px; height: 9px; border-radius: 2px; background: transparent; border-width: 1px; border-color: WorkshopTheme.ink; }
                                                    Rectangle { x: 4px; y: 10px; width: 7px; height: 1px; background: WorkshopTheme.ink; }
                                                    Rectangle { x: 13px; y: 10px; width: 2px; height: 2px; border-radius: 1px; background: WorkshopTheme.ink; }
                                                    Rectangle { x: 4px; y: 22px; width: 7px; height: 1px; background: WorkshopTheme.ink; }
                                                }
                                                VerticalLayout {
                                                    spacing: 2px; horizontal-stretch: 1;
                                                    Text { text: volume.display-name != "" ? volume.display-name : volume.name; font-size: 11px; font-weight: 600; color: WorkshopTheme.ink; overflow: elide; vertical-alignment: center; }
                                                    Text { text: (volume.compact-summary != "" ? volume.compact-summary + " · " : "") + volume.state; color: WorkshopTheme.ink; font-size: 10px; overflow: elide; vertical-alignment: center; }
                                                }
                                                Rectangle { width: 24px; horizontal-stretch: 0; }
                                            }
                                            if volume.has-usage: Rectangle {
                                                height: 3px; background: WorkshopTheme.border;
                                                accessible-role: progress-indicator; accessible-label: volume.usage;
                                                accessible-value: volume.usage-percent;
                                                accessible-value-minimum: 0; accessible-value-maximum: 100;
                                                Rectangle {
                                                    x: 0px; y: 0px; height: 100%; width: parent.width * clamp(volume.fraction, 0, 1);
                                                    background: volume.usage-level == 3 ? #ba4343 : volume.usage-level == 2 ? #b98622 : #388261;
                                                }
                                            }
                                            if source-card.expanded: VerticalLayout {
                                                width: source-card.details-width;
                                                spacing: 3px;
                                                // Bind the text width before querying its preferred height.
                                                // The conditional layout is measured before its children are placed.
                                                Text { width: source-card.details-width; height: self.preferred-height; text: volume.summary; color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap; }
                                                Text { width: source-card.details-width; height: self.preferred-height; text: volume.usage; color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap; }
                                                Text { width: source-card.details-width; height: self.preferred-height; text: volume.path != "" ? volume.path : volume.name; color: WorkshopTheme.ink; font-size: 11px; wrap: char-wrap; }
                                                Text { width: source-card.details-width; height: self.preferred-height; text: volume.state; color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap; }
                                                if volume.network && volume.reconnect-needed: Button {
                                                    text: @tr("ui" => "Reconnect");
                                                    enabled: !volume.reconnect-busy;
                                                    clicked => { root.source-context-action(root.storage-token, index, true); }
                                                }
                                            }
                                        }
                                        if source-interaction.has-focus: Rectangle { width: 100%; height: 100%; background: transparent; border-width: 2px; border-color: WorkshopTheme.focus; }
                                        // Disclosure has its own focus/activation target. Right click keeps
                                        // the exact same source menu, and never toggles its details.
                                        source-disclosure := Rectangle {
                                            x: parent.width - 29px; y: 5px; width: 24px; height: 32px;
                                            accessible-role: button;
                                            accessible-label: source-card.expanded ? @tr("ui" => "Collapse {}", volume.name) : @tr("ui" => "Expand {}", volume.name);
                                            accessible-action-default => { root.source-details-key = source-card.expanded ? "" : source-card.details-key; }
                                            forward-focus: disclosure-focus;
                                            if disclosure-focus.has-focus: Rectangle { width: 100%; height: 100%; background: transparent; border-width: 1px; border-color: WorkshopTheme.focus; }
                                            Image {
                                                width: 10px; height: 10px;
                                                source: source-card.expanded ? @image-url("icons/ribbon-down.svg") : @image-url("icons/ribbon-right.svg");
                                                colorize: WorkshopTheme.ink;
                                            }
                                            disclosure-focus := FocusScope {
                                                width: 100%; height: 100%;
                                                key-pressed(event) => {
                                                    if event.text == Key.Return || event.text == Key.Space { root.source-details-key = source-card.expanded ? "" : source-card.details-key; return accept; }
                                                    if event.text == Key.RightArrow { root.source-details-key = source-card.details-key; return accept; }
                                                    if event.text == Key.LeftArrow { root.source-details-key = ""; return accept; }
                                                    if volume.network && (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) { source-interaction.show-source-menu(source-disclosure.x, source-disclosure.y); return accept; }
                                                    return reject;
                                                }
                                                TouchArea {
                                                    private property <bool> left-press: false;
                                                    mouse-cursor: pointer;
                                                    pointer-event(event) => {
                                                        if event.kind == PointerEventKind.down { self.left-press = event.button == PointerEventButton.left; }
                                                        if event.kind == PointerEventKind.cancel { self.left-press = false; }
                                                        if volume.network && event.button == PointerEventButton.right && event.kind == PointerEventKind.up { source-interaction.show-source-menu(source-disclosure.x + self.mouse-x, source-disclosure.y + self.mouse-y); }
                                                    }
                                                    clicked => { if self.left-press { disclosure-focus.focus(); root.source-details-key = source-card.expanded ? "" : source-card.details-key; } }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.selected-volume >= 0 && root.selected-volume < root.volumes.length && root.volumes[root.selected-volume].network && root.volumes[root.selected-volume].reconnect-needed: Button {
                                text: @tr("ui" => "Reconnect");
                                enabled: !root.volumes[root.selected-volume].reconnect-busy;
                                clicked => { root.source-context-action(root.storage-token, root.selected-volume, true); }
                            }
                            Button { text: @tr("ui" => "Query capacities"); enabled: !root.storage-loading;
                                accessible-label: @tr("ui" => "Query capacities of network or unknown sources; network access possible");
                                clicked => { root.refresh-volumes(true); }
                            }
                        }
                        }
                        if root.owner-status != "": Text { text: root.owner-status; color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap; }
                    }
                }
                Rectangle {
                    min-width:sidebar-outer.shown ? 12px : 0px; max-width:self.min-width;
                    visible:sidebar-outer.shown; background:WorkshopTheme.alternate;
                    accessible-role:slider; accessible-label:@tr("ui"=>"Resize the folders and sources panel. Left and right arrows adjust; Enter resets.");
                    accessible-orientation:horizontal; accessible-value:root.actual-sidebar-width;
                    accessible-value-minimum:220;accessible-value-maximum:max(220,min(600,root.sidebar-limit));accessible-value-step:20;
                    accessible-action-set-value(v)=>{if v.is-float(){root.resize-sidebar-bounded(v.to-float());}}
                    accessible-action-increment=>{root.resize-sidebar-bounded(root.actual-sidebar-width+20);}
                    accessible-action-decrement=>{root.resize-sidebar-bounded(root.actual-sidebar-width - 20);}
                    forward-focus:outer-split-focus;
                    Rectangle {x:5px;y:parent.height*0.35;width:2px;height:parent.height*0.3;background:WorkshopTheme.border;}
                    outer-split-focus := FocusScope {
                        width:100%;height:100%;
                        key-pressed(event)=>{
                            if event.text==Key.LeftArrow {root.resize-sidebar-bounded(root.actual-sidebar-width - 20);return accept;}
                            if event.text==Key.RightArrow {root.resize-sidebar-bounded(root.actual-sidebar-width+20);return accept;}
                            if event.text==Key.Home {root.resize-sidebar-bounded(220);return accept;}
                            if event.text==Key.End {root.resize-sidebar-bounded(600);return accept;}
                            if event.text==Key.Return {root.resize-sidebar-bounded(300);return accept;}
                            return reject;
                        }
                    }
                    if outer-split-focus.has-focus:Rectangle{width:100%;height:100%;background:transparent;border-width:2px;border-color:WorkshopTheme.focus;}
                    TouchArea {
                        mouse-cursor:ew-resize;
                        property<float> start-width;property<length> start-x;
                        pointer-event(event)=>{if event.button==PointerEventButton.left && event.kind==PointerEventKind.down{self.start-width=root.actual-sidebar-width;self.start-x=self.absolute-position.x+self.mouse-x;outer-split-focus.focus();}}
                        moved=>{if self.pressed{root.resize-sidebar-bounded(self.start-width+(self.absolute-position.x+self.mouse-x - self.start-x)/1px);}}
                    }
                }
                Rectangle {
                    horizontal-stretch: 7; min-width: 400px;
                    background: WorkshopTheme.surface; border-color: WorkshopTheme.border; border-width: 1px; border-radius: 5px;
                    if root.smb-server-visible: VerticalLayout {
                        padding: 8px; spacing: 6px;
                        Text { text: root.smb-server-title; color: WorkshopTheme.ink; font-weight: 600; wrap: word-wrap; }
                        Text { text: root.smb-server-summary; color: WorkshopTheme.ink; wrap: word-wrap; }
                        Text { text: @tr("ui" => "Observed logical totals may include overlapping shares; they do not measure physical NAS usage."); color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            Button { text: @tr("ui" => "Find shares"); enabled: !root.busy; clicked => { root.smb-server-discover(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        smb-catalog := ScrollView {
                            min-height: 80px; vertical-stretch: 1;
                            horizontal-scrollbar-policy: always-off;
                            content-height: smb-rows.preferred-height;
                            smb-rows := VerticalLayout {
                                width: max(0px, smb-catalog.visible-width - root.scrollbar-gutter);
                                height: self.preferred-height; alignment: start;
                                for share[index] in root.smb-share-rows: VerticalLayout {
                                    padding: 5px; spacing: 3px;
                                    Button { text: share.name; accessible-label: share.name + ", " + share.path; clicked => { root.smb-share-open(root.smb-server-token, index); } }
                                    Text { text: share.path; color: WorkshopTheme.ink; font-size: 11px; overflow: elide; }
                                    Text { text: share.size + " · " + share.files + " · " + share.directories + " · " + share.state; color: WorkshopTheme.ink; font-size: 12px; wrap: word-wrap; }
                                }
                                if root.smb-disconnected-share-rows.length > 0: VerticalLayout {
                                    padding: 5px; spacing: 5px;
                                    Text {
                                        text: @tr("ui" => "Disconnected in Bunny");
                                        color: WorkshopTheme.ink; font-weight: 600;
                                    }
                                    for share[index] in root.smb-disconnected-share-rows: HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: share.name; color: WorkshopTheme.ink; overflow: elide; }
                                            Text { text: share.path; color: WorkshopTheme.ink; font-size: 11px; overflow: elide; }
                                        }
                                        Button {
                                            text: @tr("ui" => "Reconnect");
                                            accessible-label: @tr("ui" => "Reconnect {}", share.name);
                                            horizontal-stretch: 0;
                                            enabled: !root.smb-reconnect-busy;
                                            clicked => { root.smb-disconnected-share-reconnect(root.smb-disconnected-share-token, index); }
                                        }
                                    }
                                }
                            }
                        }
                        if root.smb-share-rows.length == 0 && root.smb-disconnected-share-rows.length == 0: Text { text: @tr("ui" => "No shares discovered yet. Find shares or choose Scan to prepare an operation."); color: WorkshopTheme.ink; wrap: word-wrap; }
                    }
                    empty-panel := VerticalLayout {
                        visible: root.search-visible && root.empty-mode > 0 && !root.smb-server-visible;
                        padding: 6px; spacing: 5px;
                        HorizontalLayout {
                            Text {
                                text: root.empty-mode == 1 ? @tr("ui" => "Find empty files") : @tr("ui" => "Find empty folders");
                                color: WorkshopTheme.ink; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center;
                            }
                            Button { text: @tr("ui" => "Close"); clicked => { root.close-search(); } }
                        }
                        Text {
                            text: root.empty-mode == 1 ? @tr("ui" => "Regular files with a logical size of zero bytes.") : @tr("ui" => "Folders with no direct entries. A subfolder counts as an entry.");
                            color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            ComboBox {
                                model: [@tr("ui" => "Find empty files"), @tr("ui" => "Find empty folders")];
                                current-index: root.empty-mode == 2 ? 1 : 0;
                                accessible-label: @tr("ui" => "Empty items…");
                                enabled: !root.empty-busy && !root.choosing-folder;
                                selected => { root.empty-kind-changed(self.current-index + 1); }
                            }
                            empty-scope-input := LineEdit {
                                text <=> root.empty-scope; placeholder-text: @tr("ui" => "Analysis source");
                                accessible-label: @tr("ui" => "Analysis source"); horizontal-stretch: 1;
                                enabled: !root.empty-busy && !root.choosing-folder;
                                edited => { root.empty-scope-edited(); }
                                accepted => { if root.empty-ready { root.empty-start(); } }
                            }
                            Button {
                                text: @tr("ui" => "Browse…"); enabled: !root.empty-busy && !root.choosing-folder;
                                clicked => { root.empty-browse(); }
                            }
                            Button {
                                text: @tr("ui" => "Search"); enabled: root.empty-ready;
                                clicked => { root.empty-start(); }
                            }
                            Button {
                                text: @tr("ui" => "Cancel"); enabled: root.empty-busy;
                                clicked => { root.empty-cancel(); }
                            }
                        }
                        Text { text: root.empty-status; color: WorkshopTheme.ink; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 6px;
                            LineEdit {
                                text <=> root.empty-filter; placeholder-text: @tr("ui" => "Filter by path");
                                accessible-label: @tr("ui" => "Filter by path"); enabled: root.empty-can-query;
                                accepted => { root.empty-query(); }
                            }
                            Button {
                                text: @tr("ui" => "Apply filter"); enabled: root.empty-can-query;
                                clicked => { root.empty-query(); }
                            }
                            ComboBox {
                                enabled: root.empty-can-query && !root.empty-breakdown;
                                accessible-label: @tr("ui" => "Sort");
                                model: root.empty-mode == 1
                                    ? [@tr("ui" => "Path ↑"), @tr("ui" => "Path ↓"), @tr("ui" => "Modified newest"), @tr("ui" => "Modified oldest")]
                                    : [@tr("ui" => "Path ↑"), @tr("ui" => "Path ↓")];
                                current-index <=> root.empty-sort;
                                selected => { root.empty-query(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            CheckBox {
                                text: @tr("ui" => "Breakdown by parent folder");
                                checked <=> root.empty-breakdown; enabled: root.empty-can-query;
                                toggled => { root.empty-query(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: @tr("ui" => "Previous"); enabled: root.empty-previous; clicked => { root.empty-page(false); } }
                            Button { text: @tr("ui" => "Next"); enabled: root.empty-next; clicked => { root.empty-page(true); } }
                        }
                        empty-list-focus := FocusScope {
                            vertical-stretch: 1; min-height: 1px; enabled: root.empty-mode > 0 && root.search-visible;
                            key-pressed(event) => {
                                if event.text == Key.Escape { if root.empty-busy { root.empty-cancel(); } else { root.close-search(); } return accept; }
                                if root.empty-rows.length > 0 {
                                    if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Home || event.text == Key.End {
                                        root.empty-selected = event.text == Key.Home ? 0 : event.text == Key.End ? root.empty-rows.length - 1
                                            : clamp(root.empty-selected + (event.text == Key.UpArrow ? -1 : 1), 0, root.empty-rows.length - 1);
                                        let row-y = root.empty-selected * 38px;
                                        if row-y < -empty-list.content-y { empty-list.content-y = -row-y; }
                                        if row-y + 38px > -empty-list.content-y + empty-list.visible-height {
                                            empty-list.content-y = min(0px, empty-list.visible-height - row-y - 38px);
                                        }
                                        return accept;
                                    }
                                }
                                return reject;
                            }
                            empty-list := ListView {
                                width: 100%; height: 100%; content-y <=> root.empty-scroll-y;
                                accessible-label: root.empty-mode == 1 ? @tr("ui" => "Find empty files") : @tr("ui" => "Find empty folders");
                                for row[index] in root.empty-rows: Rectangle {
                                    height: 38px; border-width: root.empty-selected == index ? 1px : 0px; border-color: WorkshopTheme.focus;
                                    background: mod(index, 2) == 0 ? WorkshopTheme.alternate : WorkshopTheme.surface;
                                    accessible-role: list-item;
                                    accessible-label: row.path + " · " + row.detail;
                                    TouchArea { clicked => { root.empty-selected = index; empty-list-focus.focus(); } }
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 6px; spacing: 8px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: row.name; color: WorkshopTheme.ink; overflow: elide; font-size: 13px; }
                                            Text { text: row.path; color: WorkshopTheme.ink; overflow: elide; font-size: 11px; }
                                        }
                                        Text { text: row.detail; color: WorkshopTheme.ink; vertical-alignment: center; overflow: elide; font-size: 11px; }
                                    }
                                }
                            }
                        }
                        LineEdit {
                            read-only: true; placeholder-text: @tr("ui" => "Full path"); accessible-label: @tr("ui" => "Full path");
                            text: root.empty-selected >= 0 && root.empty-selected < root.empty-rows.length ? root.empty-rows[root.empty-selected].path : "";
                        }
                        if !root.empty-breakdown: LineEdit {
                            read-only: true; placeholder-text: @tr("ui" => "Parent folder"); accessible-label: @tr("ui" => "Parent folder");
                            text: root.empty-selected >= 0 && root.empty-selected < root.empty-rows.length ? root.empty-rows[root.empty-selected].parent : "";
                        }
                    }
                    live-search-layout := VerticalLayout {
                        visible: root.search-visible && root.empty-mode == 0 && !root.smb-server-visible; padding: 6px; spacing: root.duplicate-cross ? 3px : 5px;
                        if root.duplicate-mode == 0: Text { text: @tr("ui" => "Search / statistics"); color: WorkshopTheme.ink; font-weight: 600; }
                        if root.duplicate-mode == 0: Text { text: root.search-scope; color: WorkshopTheme.ink; wrap: word-wrap; font-size: 10px; }
                        live-search-controls := ScrollView {
