    changed width => { root.narrow-view = root.width < 960px; root.sidebar-limit=root.width/1px*0.45; }
    private property <bool> compact-view: false;
    private property <length> automatic-treemap-height: 190px;
    changed height => {
        root.compact-view = root.dense || root.height < 680px;
