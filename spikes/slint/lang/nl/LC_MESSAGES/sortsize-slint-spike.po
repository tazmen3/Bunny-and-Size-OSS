msgctxt "ui"
msgid "Resize the treemap and file list. Use Up and Down arrows or Enter to reset."
msgstr "Pas de grootte van de treemap en de bestandenlijst aan. Gebruik Pijl-omhoog en Pijl-omlaag of Enter om te herstellen."

msgctxt "rust"
msgid "Choose another retained date…"
msgstr "Kies een andere bewaarde datum…"

msgctxt "rust"
msgid "Choose two different retained dates."
msgstr "Kies twee verschillende bewaarde datums."

msgctxt "rust"
msgid "Date retained locally"
msgstr "Datum lokaal bewaard"

msgctxt "rust"
msgid "Direct files and immediate folders, including their descendants."
msgstr "Bestanden in de hoofdmap en directe submappen met hun inhoud."

msgctxt "rust"
msgid "Folder changes · logical size"
msgstr "Wijzigingen per map · logische grootte"

msgctxt "rust"
msgid "Incomparable scope"
msgstr "Onvergelijkbaar bereik"

msgctxt "rust"
msgid "Keep complete measures of this scope at two different times to see a trend."
msgstr "Bewaar volledige metingen van dit bereik op twee verschillende momenten om het verloop te zien."

msgctxt "rust"
msgid "Largest entries · observed logical size"
msgstr "Grootste items · waargenomen logische grootte"

msgctxt "rust"
msgid "Last automatic scan"
msgstr "Laatste automatische scan"

msgctxt "rust"
msgid "Later measure"
msgstr "Nieuwere meting"

msgctxt "rust"
msgid "Logical size over time"
msgstr "Verloop van de logische grootte"

msgctxt "rust"
msgid "No entries with a known logical size."
msgstr "Geen items met een bekende logische grootte."

msgctxt "rust"
msgid "No logical size changes in immediate folders."
msgstr "Geen wijzigingen in logische grootte in de directe submappen."

msgctxt "rust"
msgid "Retained date"
msgstr "Bewaarde datum"

msgctxt "rust"
msgid "The comparison needs two complete measures with known logical totals."
msgstr "Voor de vergelijking zijn twee volledige metingen met bekende logische totalen nodig."

msgctxt "rust"
msgid "The two scopes could not be matched."
msgstr "De twee bereiken konden niet aan elkaar worden gekoppeld."

msgctxt "rust"
msgid "Up to five increases and five decreases among immediate folders. Direct files also affect the total."
msgstr "Maximaal vijf toenames en vijf afnames bij directe submappen. Bestanden in de hoofdmap tellen ook mee in het totaal."

msgctxt "ui"
msgid "Compare retained dates"
msgstr "Bewaarde datums vergelijken"

msgctxt "ui"
msgid "Dots show complete measurements. Axis marks show gaps. Dates and recorded values are listed below."
msgstr "Punten tonen volledige metingen. Markeringen op de as tonen gaten. Datums en gemeten waarden staan hieronder."

msgctxt "ui"
msgid "Keep another scan to compare two dates."
msgstr "Bewaar nog een scan om twee datums te vergelijken."

msgctxt "ui"
msgid "Keep current scan as a dated measure"
msgstr "Huidige scan bewaren als gedateerde meting"

msgctxt "ui"
msgid "Keep each scan you want in the history. A new scan replaces the automatic entry for the same location."
msgstr "Bewaar elke scan die je in de geschiedenis wilt opnemen. Een nieuwe scan vervangt het automatische item voor dezelfde locatie."

msgctxt "ui"
msgid "Largest entries"
msgstr "Grootste items"

msgctxt "ui"
msgid "Manage measures"
msgstr "Metingen beheren"

msgctxt "ui"
msgid "No retained dates yet."
msgstr "Nog geen bewaarde datums."

msgctxt "ui"
msgid "Other retained date for comparison"
msgstr "Andere bewaarde datum voor vergelijking"

msgctxt "ui"
msgid "Show trend"
msgstr "Verloop tonen"

msgctxt "rust"
msgid "Saved measure deleted."
msgstr "Bewaarde meting verwijderd."

msgctxt "rust"
msgid "Saved measure deleted. Journal update failed."
msgstr "Meting verwijderd. Bijwerken van het logboek mislukt."

msgctxt "rust"
msgid "This measure shares storage with other records and cannot be deleted separately."
msgstr "Deze meting deelt opslag met andere records. Afzonderlijk verwijderen is niet beschikbaar."

msgctxt "ui"
msgid "Delete measure"
msgstr "Meting verwijderen"

msgctxt "ui"
msgid "Delete selected measure…"
msgstr "Geselecteerde meting verwijderen…"

msgctxt "ui"
msgid "Permanently delete this saved measure?"
msgstr "Deze bewaarde meting definitief verwijderen?"

msgctxt "ui"
msgid "Scanned files are kept."
msgstr "De gescande bestanden blijven behouden."

msgctxt "ui"
msgid "Could not show the item in the file manager."
msgstr "Het item kon niet in bestandsbeheer worden getoond."

msgctxt "ui"
msgid "Open in File Manager"
msgstr "Openen in bestandsbeheer"

msgctxt "ui"
msgid "Show in File Manager"
msgstr "Tonen in bestandsbeheer"

msgctxt "ui"
msgid "Logical size of scanned files · {}"
msgstr "Logische grootte van de gescande bestanden · {}"
