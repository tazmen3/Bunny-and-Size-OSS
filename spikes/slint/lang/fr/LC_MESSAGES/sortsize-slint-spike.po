msgstr "Nom du serveur, adresse IP ou partage UNC complet"

msgctxt "ui"
msgid "Enter a server name or IP, then search its shares; or enter a full UNC share path."
msgstr "Saisissez un nom de serveur ou une IP, puis recherchez ses partages ; ou saisissez un chemin UNC complet."

msgctxt "ui"
msgid "Find shares"
msgstr "Rechercher les partages"

msgctxt "ui"
msgid "Connect with Windows"
msgstr "Connecter avec Windows"

msgctxt "ui"
msgid "Shares on this server"
msgstr "Partages de ce serveur"

msgctxt "ui"
msgid "Adding or connecting a source never starts a scan. Windows handles credentials; Bunny and Size does not store passwords."
msgstr "Ajouter ou connecter une source ne lance jamais d’analyse. Windows gère les identifiants ; Bunny and Size n’enregistre aucun mot de passe."

msgctxt "ui"
msgid "The share list is limited. You can also enter a full UNC share path manually."
msgstr "La liste des partages est limitée. Vous pouvez aussi saisir manuellement un chemin UNC complet."

msgctxt "ui"
msgid "Select a share from the list, then add it. No scan has been started."
msgstr "Sélectionnez un partage dans la liste, puis ajoutez-le. Aucune analyse n’a été lancée."

msgctxt "ui"
msgid "Share listing denied. Use Connect with Windows, then retry, or enter a full UNC share path manually."
msgstr "Liste des partages refusée. Utilisez Connecter avec Windows, puis réessayez, ou saisissez manuellement un chemin UNC complet."

msgctxt "ui"
msgid "Complete SMB NAS server"
msgstr "Serveur NAS SMB complet"

msgctxt "ui"
msgid "Enter a server name, IP address or UNC server root, without a share."
msgstr "Saisir un nom de serveur, une adresse IP ou une racine serveur UNC, sans partage."

