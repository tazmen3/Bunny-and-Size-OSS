msgstr "Vérification de l’accès…"

msgctxt "rust"
msgid "Disconnected deliberately"
msgstr "Déconnecté volontairement"

msgctxt "ui"
msgid "Waiting for the Ubuntu connection…"
msgstr "Connexion Ubuntu en cours…"

msgctxt "ui"
msgid "Enter a server name, IP address or smb://server/, without a share."
msgstr "Saisissez un nom de serveur, une adresse IP ou smb://serveur/, sans partage."

msgctxt "ui"
msgid "Invalid path. Use smb://server/share, a UNC share, or an existing native mount or folder."
msgstr "Chemin invalide. Utilisez smb://serveur/partage, un partage UNC ou un montage ou dossier natif existant."

msgctxt "ui"
msgid "Server address accepted. Search for shares or enter smb://server/share before adding it."
msgstr "Adresse du serveur acceptée. Recherchez ses partages ou saisissez smb://serveur/partage avant l’ajout."

msgctxt "ui"
msgid "Server reachable, but no file shares could be listed. Enter smb://server/share manually."
msgstr "Serveur joignable, mais aucun partage n’a pu être listé. Saisissez smb://serveur/partage manuellement."

msgctxt "ui"
msgid "Authentication required. Use Connect with Ubuntu, sign in through the Files application, then retry."
msgstr "Authentification nécessaire. Utilisez Connecter avec Ubuntu, identifiez-vous dans Fichiers, puis réessayez."

msgctxt "ui"
msgid "Credentials rejected by Ubuntu or the server. Check your account and try again."
msgstr "Identifiants refusés par Ubuntu ou le serveur. Vérifiez votre compte et réessayez."

msgctxt "ui"
msgid "Ubuntu mount available for scanning. No scan has been started."
msgstr "Montage Ubuntu disponible pour l’analyse. Aucune analyse n’a été lancée."

msgctxt "ui"
msgid "Shares could not be listed. Enter smb://server/share or an existing mount; connect in Files if needed."
msgstr "Impossible de lister les partages. Saisissez smb://serveur/partage ou un montage existant ; connectez-vous dans Fichiers si nécessaire."

