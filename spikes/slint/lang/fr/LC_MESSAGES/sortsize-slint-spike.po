msgctxt "rust"
msgid "No logical size changes in immediate folders."
msgstr "Aucune variation de taille logique dans les dossiers de premier niveau."

msgctxt "rust"
msgid "Retained date"
msgstr "Date conservée"

msgctxt "rust"
msgid "The comparison needs two complete measures with known logical totals."
msgstr "La comparaison exige deux mesures complètes dont les totaux logiques sont connus."

msgctxt "rust"
msgid "The two scopes could not be matched."
msgstr "Impossible de faire correspondre les deux périmètres."

msgctxt "rust"
msgid "Up to five increases and five decreases among immediate folders. Direct files also affect the total."
msgstr "Jusqu’à cinq hausses et cinq baisses parmi les dossiers de premier niveau. Les fichiers à la racine comptent aussi dans le total."

msgctxt "ui"
msgid "Compare retained dates"
msgstr "Comparer les dates conservées"

msgctxt "ui"
msgid "Dots show complete measurements. Axis marks show gaps. Dates and recorded values are listed below."
msgstr "Les points indiquent les mesures complètes. Les repères sur l’axe signalent les trous. Les dates et valeurs relevées figurent ci-dessous."

msgctxt "ui"
msgid "Keep another scan to compare two dates."
msgstr "Conservez un autre scan pour comparer deux dates."

msgctxt "ui"
msgid "Keep current scan as a dated measure"
msgstr "Conserver ce scan comme mesure datée"

msgctxt "ui"
msgid "Keep each scan you want in the history. A new scan replaces the automatic entry for the same location."
msgstr "Conservez chaque scan à ajouter à l’historique. Un nouveau scan remplace l’entrée automatique du même emplacement."

msgctxt "ui"
msgid "Largest entries"
msgstr "Principaux postes"

msgctxt "ui"
msgid "Manage measures"
msgstr "Gérer les mesures"

msgctxt "ui"
msgid "No retained dates yet."
msgstr "Aucune date conservée pour le moment."

msgctxt "ui"
msgid "Other retained date for comparison"
msgstr "Autre date conservée à comparer"

msgctxt "ui"
msgid "Show trend"
msgstr "Voir l’évolution"

msgctxt "rust"
msgid "Saved measure deleted."
msgstr "Mesure enregistrée supprimée."

msgctxt "rust"
msgid "Saved measure deleted. Journal update failed."
msgstr "Mesure supprimée. La mise à jour du journal a échoué."

msgctxt "rust"
msgid "This measure shares storage with other records and cannot be deleted separately."
msgstr "Cette mesure partage son stockage avec d’autres relevés. La suppression individuelle est indisponible."

msgctxt "ui"
msgid "Delete measure"
msgstr "Supprimer la mesure"

msgctxt "ui"
msgid "Delete selected measure…"
msgstr "Supprimer la mesure sélectionnée…"

msgctxt "ui"
msgid "Permanently delete this saved measure?"
msgstr "Supprimer définitivement cette mesure enregistrée ?"

msgctxt "ui"
msgid "Scanned files are kept."
msgstr "Les fichiers analysés sont conservés."

msgctxt "ui"
msgid "Could not show the item in the file manager."
msgstr "Impossible d’afficher l’élément dans le gestionnaire de fichiers."

msgctxt "ui"
msgid "Open in File Manager"
msgstr "Ouvrir dans le gestionnaire de fichiers"

msgctxt "ui"
msgid "Show in File Manager"
msgstr "Afficher dans le gestionnaire de fichiers"

msgctxt "ui"
msgid "Logical size of scanned files · {}"
msgstr "Taille logique des fichiers analysés · {}"

msgctxt "rust"
msgid "Looking for shares on this server…"
msgstr "Recherche des partages sur ce serveur…"

msgctxt "rust"
msgid "Share discovery is limited or uncertain."
msgstr "La découverte des partages est limitée ou incertaine."

msgctxt "rust"
msgid "Visible shares: {}"
msgstr "Partages visibles : {}"

msgctxt "rust"
msgid "Shares disconnected in Bunny: {}"
msgstr "Partages déconnectés dans Bunny : {}"

msgctxt "rust"
msgid "Current scan"
msgstr "Analyse en cours"

msgctxt "rust"
msgid "Last scan"
msgstr "Dernière analyse"

msgctxt "rust"
msgid "Saved measures"
msgstr "Mesures enregistrées"

msgctxt "ui"
msgid "Disconnected in Bunny"
msgstr "Déconnectés dans Bunny"

msgctxt "ui"
msgid "Reconnect {}"
msgstr "Reconnecter {}"
