msgstr "Selecionar origem: {}"

msgctxt "ui"
msgid "Looking for shares on this server…"
msgstr "A procurar partilhas neste servidor…"

msgctxt "ui"
msgid "Waiting for the Windows connection…"
msgstr "A aguardar a ligação do Windows…"

msgctxt "ui"
msgid "Server address accepted. Search for shares or enter a full UNC share path before adding it."
msgstr "Endereço do servidor aceite. Procure partilhas ou introduza um caminho UNC completo antes de adicionar."

msgctxt "ui"
msgid "Server unavailable. Check its address and network connection, then try again."
msgstr "Servidor indisponível. Verifique o endereço e a ligação de rede e tente novamente."

msgctxt "ui"
msgid "Server reachable, but no file shares could be listed. Enter the full UNC path manually."
msgstr "Servidor acessível, mas nenhuma partilha de ficheiros pôde ser listada. Introduza manualmente o caminho UNC completo."

msgctxt "ui"
msgid "Authentication required. Use Connect with Windows, or establish this connection in Windows Explorer, then retry."
msgstr "Autenticação necessária. Utilize Ligar com o Windows ou estabeleça a ligação no Explorador do Windows e tente novamente."

msgctxt "ui"
msgid "Credentials rejected by Windows or the server. Check your account and try again."
msgstr "Credenciais recusadas pelo Windows ou pelo servidor. Verifique a conta e tente novamente."

msgctxt "ui"
msgid "Share not found. Check its name or search the server's shares again."
msgstr "Partilha inexistente. Verifique o nome ou procure novamente as partilhas do servidor."

msgctxt "ui"
msgid "Windows connection established. No scan has been started."
msgstr "Ligação do Windows estabelecida. Nenhuma análise foi iniciada."

msgctxt "ui"
msgid "Operation cancelled. No scan has been started."
msgstr "Operação cancelada. Nenhuma análise foi iniciada."

msgctxt "ui"
msgid "Windows session conflict (1219). A connection using another account already exists. Existing connections have been kept."
msgstr "Conflito de sessão do Windows (1219). Já existe uma ligação com outra conta. As ligações existentes foram mantidas."

msgctxt "ui"
msgid "Shares could not be listed. Enter a full UNC share path manually; connect to it in Windows Explorer if necessary, then retry."
msgstr "Não foi possível listar as partilhas. Introduza um caminho UNC completo; se necessário, ligue-se no Explorador do Windows e tente novamente."

msgctxt "ui"
msgid "Native SMB discovery and sign-in are available on Windows. Use an existing system mount on this platform."
msgstr "A pesquisa e autenticação SMB nativas estão disponíveis no Windows. Nesta plataforma, utilize uma montagem existente do sistema."

msgctxt "ui"
msgid "Server or share"
msgstr "Servidor ou partilha"

msgctxt "ui"
msgid "Server name, IP address or full UNC share"
msgstr "Nome do servidor, endereço IP ou partilha UNC completa"

msgctxt "ui"
msgid "Enter a server name or IP, then search its shares; or enter a full UNC share path."
msgstr "Introduza o nome ou IP de um servidor e procure as partilhas; ou introduza um caminho UNC completo."

msgctxt "ui"
msgid "Find shares"
msgstr "Procurar partilhas"

msgctxt "ui"
msgid "Connect with Windows"
msgstr "Ligar com o Windows"

msgctxt "ui"
msgid "Shares on this server"
msgstr "Partilhas deste servidor"

msgctxt "ui"
msgid "Adding or connecting a source never starts a scan. Windows handles credentials; Bunny and Size does not store passwords."
msgstr "Adicionar ou ligar uma origem nunca inicia uma análise. O Windows gere as credenciais; o Bunny and Size não guarda palavras-passe."

msgctxt "ui"
msgid "The share list is limited. You can also enter a full UNC share path manually."
msgstr "A lista de partilhas é limitada. Também pode introduzir manualmente um caminho UNC completo."

msgctxt "ui"
msgid "Select a share from the list, then add it. No scan has been started."
msgstr "Selecione uma partilha da lista e adicione-a. Nenhuma análise foi iniciada."

msgctxt "ui"
msgid "Share listing denied. Use Connect with Windows, then retry, or enter a full UNC share path manually."
msgstr "Listagem de partilhas recusada. Utilize Ligar com o Windows e tente novamente, ou introduza manualmente um caminho UNC completo."

msgctxt "ui"
msgid "Complete SMB NAS server"
msgstr "Servidor NAS SMB completo"

msgctxt "ui"
msgid "Enter a server name, IP address or UNC server root, without a share."
msgstr "Introduza um nome de servidor, endereço IP ou raiz UNC do servidor, sem partilha."

msgctxt "ui"
msgid "Server source ready to add, including offline. Scan its selected shares later with Scan."
msgstr "Servidor pronto a adicionar, mesmo offline. Analise depois as partilhas escolhidas com Analisar."

msgctxt "ui"
msgid "Add the server as a logical source. No share discovery or scan is required to save it."
msgstr "Adicione o servidor como origem lógica. Não é necessário descobrir partilhas nem analisar para o guardar."

msgctxt "ui"
msgid "Confirm server scan"
msgstr "Confirmar análise do servidor"

msgctxt "ui"
msgid "Choose the shares for this operation. New shares will not be added during the scan."
msgstr "Escolha as partilhas para esta operação. Não serão adicionadas novas partilhas durante a análise."

msgctxt "ui"
msgid "A server scan may process large amounts of data. You can cancel it."
msgstr "A análise de um servidor pode processar grandes volumes de dados. Pode cancelá-la."

msgctxt "ui"
msgid "Totals are observed logical sizes, not physical NAS usage. Shares can overlap and count the same data more than once."
msgstr "Os totais são tamanhos lógicos observados, não a ocupação física do NAS. As partilhas podem sobrepor-se e contar os mesmos dados mais de uma vez."

msgctxt "ui"
msgid "Share discovery is limited or uncertain. The server coverage will remain partial or unknown."
msgstr "A descoberta de partilhas é limitada ou incerta. A cobertura do servidor permanecerá parcial ou desconhecida."

msgctxt "ui"
msgid "Select all"
msgstr "Selecionar tudo"

msgctxt "ui"
msgid "Deselect all"
msgstr "Desselecionar tudo"

msgctxt "ui"
msgid "Selected shares: {}"
msgstr "Partilhas selecionadas: {}"

msgctxt "ui"
msgid "Confirm scan"
msgstr "Confirmar análise"

msgctxt "ui"
msgid "Back to the NAS server"
msgstr "Voltar ao servidor NAS"

msgctxt "ui"
msgid "Observed logical totals may include overlapping shares; they do not measure physical NAS usage."
msgstr "Os totais lógicos observados podem incluir partilhas sobrepostas; não medem a ocupação física do NAS."

msgctxt "ui"
msgid "No shares discovered yet. Find shares or choose Scan to prepare an operation."
msgstr "Ainda não foram descobertas partilhas. Procure partilhas ou escolha Analisar para preparar uma operação."

msgctxt "rust"
msgid "Shares completed: {} / {}"
msgstr "Partilhas concluídas: {} / {}"

msgctxt "rust"
msgid "Waiting"
msgstr "Em espera"

msgctxt "rust"
msgid "Scanning"
msgstr "A analisar"

msgctxt "rust"
msgid "Failed"
msgstr "Falhou"

msgctxt "rust"
msgid "Share discovery failed. Connect with Windows, then try again."
msgstr "A descoberta de partilhas falhou. Ligue com o Windows e tente novamente."

msgctxt "rust"
msgid "Discover shares explicitly before browsing this server."
msgstr "Descubra explicitamente as partilhas antes de explorar este servidor."

msgctxt "rust"
msgid "Share not inventoried. Click Scan to analyze this share."
msgstr "Partilha sem inventário. Clique em Analisar para analisar esta partilha."

msgctxt "ui"
msgid "Confirm disconnection"
msgstr "Confirmar desconexão"

