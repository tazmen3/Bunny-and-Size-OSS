msgctxt "rust"
msgid "Later measure"
msgstr "Medição mais recente"

msgctxt "rust"
msgid "Logical size over time"
msgstr "Evolução do tamanho lógico"

msgctxt "rust"
msgid "No entries with a known logical size."
msgstr "Nenhum elemento com tamanho lógico conhecido."

msgctxt "rust"
msgid "No logical size changes in immediate folders."
msgstr "Sem alterações ao tamanho lógico nas pastas de primeiro nível."

msgctxt "rust"
msgid "Retained date"
msgstr "Data guardada"

msgctxt "rust"
msgid "The comparison needs two complete measures with known logical totals."
msgstr "A comparação requer duas medições completas com totais lógicos conhecidos."

msgctxt "rust"
msgid "The two scopes could not be matched."
msgstr "Não foi possível estabelecer a correspondência entre os dois âmbitos."

msgctxt "rust"
msgid "Up to five increases and five decreases among immediate folders. Direct files also affect the total."
msgstr "Até cinco aumentos e cinco reduções nas pastas de primeiro nível. Os ficheiros na raiz também contam para o total."

msgctxt "ui"
msgid "Compare retained dates"
msgstr "Comparar datas guardadas"

msgctxt "ui"
msgid "Dots show complete measurements. Axis marks show gaps. Dates and recorded values are listed below."
msgstr "Os pontos indicam medições completas. As marcas no eixo indicam lacunas. As datas e os valores registados estão abaixo."

msgctxt "ui"
msgid "Keep another scan to compare two dates."
msgstr "Guarde outra análise para comparar duas datas."

msgctxt "ui"
msgid "Keep current scan as a dated measure"
msgstr "Guardar a análise atual como medição datada"

msgctxt "ui"
msgid "Keep each scan you want in the history. A new scan replaces the automatic entry for the same location."
msgstr "Guarde cada análise que pretende adicionar ao histórico. Uma nova análise substitui a entrada automática da mesma localização."

msgctxt "ui"
msgid "Largest entries"
msgstr "Maiores elementos"

msgctxt "ui"
msgid "Manage measures"
msgstr "Gerir medições"

msgctxt "ui"
msgid "No retained dates yet."
msgstr "Ainda não há datas guardadas."

msgctxt "ui"
msgid "Other retained date for comparison"
msgstr "Outra data guardada para comparação"

msgctxt "ui"
msgid "Show trend"
msgstr "Ver evolução"

msgctxt "rust"
msgid "Saved measure deleted."
msgstr "Medição guardada eliminada."

msgctxt "rust"
msgid "Saved measure deleted. Journal update failed."
msgstr "Medição eliminada. Falhou a atualização do registo."

msgctxt "rust"
msgid "This measure shares storage with other records and cannot be deleted separately."
msgstr "Esta medição partilha o armazenamento com outros registos. A eliminação individual está indisponível."

msgctxt "ui"
msgid "Delete measure"
msgstr "Eliminar a medição"

msgctxt "ui"
msgid "Delete selected measure…"
msgstr "Eliminar a medição selecionada…"

msgctxt "ui"
msgid "Permanently delete this saved measure?"
msgstr "Eliminar definitivamente esta medição guardada?"

msgctxt "ui"
msgid "Scanned files are kept."
msgstr "Os ficheiros analisados são preservados."

msgctxt "ui"
msgid "Could not show the item in the file manager."
msgstr "Não foi possível mostrar o item no gestor de ficheiros."

msgctxt "ui"
msgid "Open in File Manager"
msgstr "Abrir no gestor de ficheiros"

msgctxt "ui"
msgid "Show in File Manager"
msgstr "Mostrar no gestor de ficheiros"

msgctxt "ui"
msgid "Logical size of scanned files · {}"
msgstr "Tamanho lógico dos ficheiros analisados · {}"

msgctxt "rust"
msgid "Looking for shares on this server…"
msgstr "A procurar partilhas neste servidor…"

msgctxt "rust"
msgid "Share discovery is limited or uncertain."
msgstr "A descoberta de partilhas é limitada ou incerta."

msgctxt "rust"
msgid "Visible shares: {}"
msgstr "Partilhas visíveis: {}"

msgctxt "rust"
msgid "Shares disconnected in Bunny: {}"
msgstr "Partilhas desligadas no Bunny: {}"

