msgctxt "rust"
msgid "Inventory available"
msgstr "Inventário disponível"

msgctxt "rust"
msgid "Exact groups: {} · errors: {}."
msgstr "Grupos exatos: {} · erros: {}."

msgctxt "rust"
msgid "Verifying files…"
msgstr "A verificar ficheiros…"

msgctxt "ui"
msgid "Folders to compare"
