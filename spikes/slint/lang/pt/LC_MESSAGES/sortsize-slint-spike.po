msgid "Source disconnected and saved. Cancellation is requested; a pending system call may finish later."
msgstr "Origem desconectada e estado guardado. Cancelamento solicitado; uma chamada de sistema pendente pode terminar mais tarde."

msgctxt "rust"
msgid "Source disconnected for this session, but saving failed. Reconnect and retry before closing the application."
msgstr "Origem desconectada nesta sessão, mas não foi possível guardar. Reconecte e tente novamente antes de fechar a aplicação."

msgctxt "rust"
