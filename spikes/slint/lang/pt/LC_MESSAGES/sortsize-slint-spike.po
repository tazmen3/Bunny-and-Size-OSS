msgid "At most 16 session inventories are retained for comparison. Save further inventories to use them."
msgstr "São mantidos no máximo 16 inventários de sessão para comparação. Guarda os inventários adicionais para os utilizar."

msgctxt "rust"
msgid "Could not start search."
msgstr "Não foi possível iniciar a pesquisa."

msgctxt "rust"
msgid "Disconnected by user"
msgstr "Desligado pelo utilizador"

msgctxt "rust"
msgid "Effective duplicate budgets: {} bytes read; {} bytes per file; {} errors; {} bytes temporary state total; {} roots maximum."
msgstr "Limites efetivos dos duplicados: {} bytes lidos; {} bytes por ficheiro; {} erros; {} bytes de estado temporário no total; no máximo {} raízes."

msgctxt "rust"
msgid "Possible source aliases remain unverified. Results are incomplete."
msgstr "Continuam por verificar possíveis aliases das origens. Os resultados estão incompletos."

msgctxt "rust"
msgid "Verified exact"
msgstr "Igualdade exata verificada"

msgctxt "rust"
msgid "Another duplicate task is still closing. Retry shortly."
msgstr "Outra pesquisa de duplicados ainda está a terminar. Volta a tentar em breve."

msgctxt "rust"
msgid "Maximum pending duplicate tasks, including cancelled tasks awaiting the system: {}."
msgstr "Número máximo de pesquisas de duplicados pendentes, incluindo as canceladas à espera do sistema: {}."

msgctxt "rust"
msgid "Source continuity is unverified. Current file contents can be compared, but inventory coverage and independent copies are not proven."
msgstr "A continuidade da origem não está verificada. O conteúdo atual dos ficheiros pode ser comparado, mas a cobertura do inventário e a independência das cópias não estão comprovadas."

msgctxt "rust"
