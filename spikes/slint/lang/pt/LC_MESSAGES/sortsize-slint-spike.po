msgstr "Nome de apresentação (opcional)"

msgctxt "ui"
msgid "Adding a source never starts a scan. No password is requested or stored."
msgstr "Adicionar uma origem nunca inicia uma análise. Nenhuma palavra-passe é pedida ou guardada."

msgctxt "ui"
