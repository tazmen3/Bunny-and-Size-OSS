msgid "Do you really want to disconnect the source {}?"
msgstr "Deseja mesmo desconectar a origem {}?"

msgctxt "ui"
msgid "Known shares affected: {}. Newly discovered shares will also remain disconnected."
msgstr "Partilhas conhecidas afetadas: {}. As partilhas descobertas posteriormente também permanecerão desconectadas."

msgctxt "ui"
msgid "The current scan will be stopped and pending operations cancelled."
msgstr "A análise em curso será interrompida e as operações pendentes canceladas."

msgctxt "ui"
msgid "This source will be excluded from future scans until you explicitly reconnect it. Saved inventories will be kept."
msgstr "Esta origem será excluída das próximas análises até a reconectar explicitamente. Os inventários guardados serão mantidos."

msgctxt "ui"
msgid "Also disconnect the network connection in Windows"
msgstr "Desconectar também a ligação de rede no Windows"

msgctxt "ui"
msgid "Windows disconnection is unavailable for this source: its effects on other connections cannot be safely limited."
msgstr "A desconexão do Windows não está disponível para esta origem: não é possível limitar com segurança os efeitos noutras ligações."

msgctxt "ui"
msgid "Reconnect"
msgstr "Reconectar"

msgctxt "ui"
msgid "Disconnect"
msgstr "Desconectar"

msgctxt "rust"
msgid "Disconnected"
msgstr "Desconectado"

