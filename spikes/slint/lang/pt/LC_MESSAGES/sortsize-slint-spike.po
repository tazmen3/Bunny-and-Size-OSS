msgstr "Pasta ou raiz autorizada A"

msgctxt "ui"
msgid "Folder or allowed root B"
msgstr "Pasta ou raiz autorizada B"

msgctxt "ui"
msgid "Cancellation requested. A system call already in progress may delay the stop."
msgstr "Cancelamento solicitado. Uma chamada de sistema já em curso pode atrasar a paragem."

msgctxt "rust"
