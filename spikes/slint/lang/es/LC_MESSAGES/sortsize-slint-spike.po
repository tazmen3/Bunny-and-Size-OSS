msgstr "Último análisis automático"

msgctxt "rust"
msgid "Later measure"
msgstr "Medición más reciente"

msgctxt "rust"
msgid "Logical size over time"
msgstr "Evolución del tamaño lógico"

msgctxt "rust"
msgid "No entries with a known logical size."
msgstr "No hay elementos de tamaño lógico conocido."

msgctxt "rust"
msgid "No logical size changes in immediate folders."
msgstr "No hay cambios de tamaño lógico en las carpetas de primer nivel."

msgctxt "rust"
msgid "Retained date"
msgstr "Fecha conservada"

msgctxt "rust"
msgid "The comparison needs two complete measures with known logical totals."
msgstr "La comparación requiere dos mediciones completas con totales lógicos conocidos."

msgctxt "rust"
msgid "The two scopes could not be matched."
msgstr "No se pudo establecer la correspondencia entre los dos ámbitos."

msgctxt "rust"
msgid "Up to five increases and five decreases among immediate folders. Direct files also affect the total."
msgstr "Hasta cinco aumentos y cinco reducciones entre las carpetas de primer nivel. Los archivos de la raíz también cuentan en el total."

msgctxt "ui"
msgid "Compare retained dates"
msgstr "Comparar fechas conservadas"

msgctxt "ui"
msgid "Dots show complete measurements. Axis marks show gaps. Dates and recorded values are listed below."
msgstr "Los puntos indican mediciones completas. Las marcas del eje indican huecos. Abajo figuran las fechas y los valores registrados."

msgctxt "ui"
msgid "Keep another scan to compare two dates."
msgstr "Conserva otro análisis para comparar dos fechas."

msgctxt "ui"
msgid "Keep current scan as a dated measure"
msgstr "Conservar el análisis actual como medición fechada"

msgctxt "ui"
msgid "Keep each scan you want in the history. A new scan replaces the automatic entry for the same location."
msgstr "Conserva cada análisis que quieras añadir al historial. Un análisis nuevo sustituye la entrada automática de la misma ubicación."

msgctxt "ui"
msgid "Largest entries"
msgstr "Elementos más grandes"

msgctxt "ui"
msgid "Manage measures"
msgstr "Gestionar mediciones"

msgctxt "ui"
msgid "No retained dates yet."
msgstr "Aún no hay fechas conservadas."

msgctxt "ui"
msgid "Other retained date for comparison"
msgstr "Otra fecha conservada para comparar"

msgctxt "ui"
msgid "Show trend"
msgstr "Ver evolución"

msgctxt "rust"
msgid "Saved measure deleted."
msgstr "Medición guardada eliminada."

msgctxt "rust"
msgid "Saved measure deleted. Journal update failed."
msgstr "Medición eliminada. No se pudo actualizar el registro."

msgctxt "rust"
msgid "This measure shares storage with other records and cannot be deleted separately."
msgstr "Esta medición comparte almacenamiento con otros registros. La eliminación individual no está disponible."

msgctxt "ui"
msgid "Delete measure"
msgstr "Eliminar la medición"

msgctxt "ui"
msgid "Delete selected measure…"
msgstr "Eliminar la medición seleccionada…"

msgctxt "ui"
msgid "Permanently delete this saved measure?"
msgstr "¿Eliminar definitivamente esta medición guardada?"

msgctxt "ui"
msgid "Scanned files are kept."
msgstr "Los archivos analizados se conservan."

msgctxt "ui"
msgid "Could not show the item in the file manager."
msgstr "No se pudo mostrar el elemento en el gestor de archivos."

msgctxt "ui"
msgid "Open in File Manager"
msgstr "Abrir en el gestor de archivos"

msgctxt "ui"
msgid "Show in File Manager"
msgstr "Mostrar en el gestor de archivos"

msgctxt "ui"
msgid "Logical size of scanned files · {}"
msgstr "Tamaño lógico de los archivos analizados · {}"

msgctxt "rust"
msgid "Looking for shares on this server…"
msgstr "Buscando recursos compartidos en este servidor…"

msgctxt "rust"
msgid "Share discovery is limited or uncertain."
msgstr "La detección de recursos compartidos es limitada o incierta."

msgctxt "rust"
msgid "Visible shares: {}"
msgstr "Recursos compartidos visibles: {}"

msgctxt "rust"
msgid "Shares disconnected in Bunny: {}"
msgstr "Recursos compartidos desconectados en Bunny: {}"

msgctxt "rust"
msgid "Current scan"
msgstr "Análisis en curso"

msgctxt "rust"
msgid "Last scan"
msgstr "Último análisis"

msgctxt "rust"
msgid "Saved measures"
msgstr "Mediciones guardadas"

msgctxt "ui"
msgid "Disconnected in Bunny"
msgstr "Desconectados en Bunny"

msgctxt "ui"
msgid "Reconnect {}"
msgstr "Volver a conectar {}"
