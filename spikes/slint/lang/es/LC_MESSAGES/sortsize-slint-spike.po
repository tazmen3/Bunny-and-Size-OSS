msgid "The working folder is unavailable. Set BUNNY_AND_SIZE_STORE_DIR to an existing local folder and restart Bunny and Size."
msgstr "La carpeta de trabajo no está disponible. Configure BUNNY_AND_SIZE_STORE_DIR con una carpeta local existente y reinicie Bunny and Size."

