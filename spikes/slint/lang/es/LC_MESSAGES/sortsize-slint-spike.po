msgstr "Resolver nombres de cuentas locales"

msgctxt "ui"
msgid "Resolve account names from local files only; no network lookup"
msgstr "Resolver nombres de cuentas solo desde archivos locales; sin consultas de red"

msgctxt "ui"
msgid "Add a source"
msgstr "Añadir una fuente"

msgctxt "ui"
msgid "+ Add a source"
msgstr "+ Añadir una fuente"

msgctxt "ui"
msgid "SMB share"
msgstr "Recurso compartido SMB"

msgctxt "ui"
msgid "Existing NFS mount"
msgstr "Montaje NFS existente"

msgctxt "ui"
msgid "Local folder"
msgstr "Carpeta local"

msgctxt "ui"
msgid "Source type"
msgstr "Tipo de fuente"

msgctxt "ui"
msgid "Native path"
msgstr "Ruta nativa"

msgctxt "ui"
msgid "Checking access…"
msgstr "Comprobando el acceso…"

msgctxt "ui"
msgid "Accessible. No scan has been started."
msgstr "Accesible. No se ha iniciado ningún análisis."

msgctxt "ui"
msgid "Unavailable. You can still add this source."
msgstr "No disponible. Aun así puedes añadir esta fuente."

msgctxt "ui"
msgid "Access denied. Check permissions in your operating system."
msgstr "Acceso denegado. Comprueba los permisos en tu sistema operativo."

msgctxt "ui"
msgid "Invalid path. Use a UNC share or an existing native mount or folder."
msgstr "Ruta no válida. Usa un recurso UNC, un montaje nativo o una carpeta existente."

msgctxt "ui"
msgid "Source added. Select it and start its scan explicitly."
msgstr "Fuente añadida. Selecciónala e inicia su análisis explícitamente."

msgctxt "ui"
msgid "Source added for this session; saving failed."
msgstr "Fuente añadida para esta sesión; no se pudo guardar."

msgctxt "ui"
msgid "Access has not been checked."
msgstr "No se ha comprobado el acceso."

msgctxt "ui"
msgid "Choose an existing local folder."
msgstr "Elige una carpeta local existente."

msgctxt "ui"
msgid "Choose an existing system mount. The application does not mount network shares."
msgstr "Elige un montaje existente del sistema. La aplicación no monta recursos de red."

msgctxt "ui"
msgid "Display name (optional)"
msgstr "Nombre para mostrar (opcional)"

msgctxt "ui"
msgid "Adding a source never starts a scan. No password is requested or stored."
msgstr "Añadir una fuente nunca inicia un análisis. No se solicita ni guarda ninguna contraseña."

msgctxt "ui"
msgid "Check access"
msgstr "Comprobar acceso"

msgctxt "ui"
msgid "Add source"
msgstr "Añadir fuente"

msgctxt "ui"
msgid "Query capacities"
msgstr "Consultar capacidades"

msgctxt "ui"
msgid "Select source: {}"
msgstr "Seleccionar fuente: {}"

msgctxt "ui"
msgid "Looking for shares on this server…"
msgstr "Buscando recursos compartidos en este servidor…"

msgctxt "ui"
msgid "Waiting for the Windows connection…"
msgstr "Esperando la conexión de Windows…"

msgctxt "ui"
msgid "Server address accepted. Search for shares or enter a full UNC share path before adding it."
msgstr "Dirección del servidor aceptada. Busca los recursos compartidos o introduce una ruta UNC completa antes de añadirlo."

msgctxt "ui"
msgid "Server unavailable. Check its address and network connection, then try again."
msgstr "Servidor no disponible. Comprueba su dirección y la conexión de red e inténtalo de nuevo."

msgctxt "ui"
msgid "Server reachable, but no file shares could be listed. Enter the full UNC path manually."
msgstr "Servidor accesible, pero no se pudo listar ningún recurso de archivos. Introduce manualmente la ruta UNC completa."

msgctxt "ui"
msgid "Authentication required. Use Connect with Windows, or establish this connection in Windows Explorer, then retry."
msgstr "Se requiere autenticación. Usa Conectar con Windows o establece esta conexión en el Explorador de Windows y vuelve a intentarlo."

msgctxt "ui"
msgid "Credentials rejected by Windows or the server. Check your account and try again."
msgstr "Windows o el servidor rechazaron las credenciales. Comprueba tu cuenta e inténtalo de nuevo."

msgctxt "ui"
msgid "Share not found. Check its name or search the server's shares again."
msgstr "Recurso compartido inexistente. Comprueba su nombre o vuelve a buscar los recursos del servidor."

msgctxt "ui"
msgid "Windows connection established. No scan has been started."
msgstr "Conexión de Windows establecida. No se ha iniciado ningún análisis."

msgctxt "ui"
msgid "Operation cancelled. No scan has been started."
msgstr "Operación cancelada. No se ha iniciado ningún análisis."

msgctxt "ui"
msgid "Windows session conflict (1219). A connection using another account already exists. Existing connections have been kept."
msgstr "Conflicto de sesión de Windows (1219). Ya existe una conexión con otra cuenta. Se han conservado las conexiones existentes."

msgctxt "ui"
msgid "Shares could not be listed. Enter a full UNC share path manually; connect to it in Windows Explorer if necessary, then retry."
msgstr "No se pudieron listar los recursos compartidos. Introduce una ruta UNC completa; si es necesario, conéctate en el Explorador de Windows y vuelve a intentarlo."

msgctxt "ui"
msgid "Native SMB discovery and sign-in are available on Windows. Use an existing system mount on this platform."
msgstr "La búsqueda y autenticación SMB nativas están disponibles en Windows. En esta plataforma, usa un montaje existente del sistema."

msgctxt "ui"
msgid "Server or share"
msgstr "Servidor o recurso compartido"

msgctxt "ui"
msgid "Server name, IP address or full UNC share"
msgstr "Nombre del servidor, dirección IP o recurso UNC completo"

msgctxt "ui"
msgid "Enter a server name or IP, then search its shares; or enter a full UNC share path."
msgstr "Introduce el nombre o la IP de un servidor y busca sus recursos compartidos; o introduce una ruta UNC completa."

msgctxt "ui"
msgid "Find shares"
msgstr "Buscar recursos compartidos"

msgctxt "ui"
msgid "Connect with Windows"
msgstr "Conectar con Windows"

msgctxt "ui"
msgid "Shares on this server"
msgstr "Recursos compartidos de este servidor"

msgctxt "ui"
msgid "Adding or connecting a source never starts a scan. Windows handles credentials; Bunny and Size does not store passwords."
msgstr "Añadir o conectar una fuente nunca inicia un análisis. Windows gestiona las credenciales; Bunny and Size no guarda contraseñas."

msgctxt "ui"
msgid "The share list is limited. You can also enter a full UNC share path manually."
msgstr "La lista de recursos compartidos es limitada. También puedes introducir manualmente una ruta UNC completa."

msgctxt "ui"
msgid "Select a share from the list, then add it. No scan has been started."
msgstr "Selecciona un recurso compartido de la lista y añádelo. No se ha iniciado ningún análisis."

msgctxt "ui"
msgid "Share listing denied. Use Connect with Windows, then retry, or enter a full UNC share path manually."
msgstr "Se denegó la lista de recursos compartidos. Usa Conectar con Windows y vuelve a intentarlo, o introduce manualmente una ruta UNC completa."

msgctxt "ui"
msgid "Complete SMB NAS server"
msgstr "Servidor NAS SMB completo"

msgctxt "ui"
msgid "Enter a server name, IP address or UNC server root, without a share."
msgstr "Introduce un nombre de servidor, dirección IP o raíz UNC del servidor, sin recurso compartido."

msgctxt "ui"
msgid "Server source ready to add, including offline. Scan its selected shares later with Scan."
msgstr "Servidor listo para añadir, incluso sin conexión. Analiza después los recursos elegidos con Analizar."

msgctxt "ui"
msgid "Add the server as a logical source. No share discovery or scan is required to save it."
msgstr "Añade el servidor como fuente lógica. No hace falta buscar recursos ni analizar para guardarlo."

msgctxt "ui"
msgid "Confirm server scan"
msgstr "Confirmar análisis del servidor"

msgctxt "ui"
msgid "Choose the shares for this operation. New shares will not be added during the scan."
msgstr "Elige los recursos para esta operación. No se añadirán otros durante el análisis."

msgctxt "ui"
msgid "A server scan may process large amounts of data. You can cancel it."
msgstr "El análisis de un servidor puede procesar muchos datos. Puedes cancelarlo."

msgctxt "ui"
msgid "Totals are observed logical sizes, not physical NAS usage. Shares can overlap and count the same data more than once."
msgstr "Los totales son tamaños lógicos observados, no el uso físico del NAS. Los recursos pueden solaparse y contar los mismos datos varias veces."

msgctxt "ui"
msgid "Share discovery is limited or uncertain. The server coverage will remain partial or unknown."
msgstr "La búsqueda de recursos está limitada o es incierta. La cobertura del servidor seguirá siendo parcial o desconocida."

msgctxt "ui"
msgid "Select all"
msgstr "Seleccionar todo"

msgctxt "ui"
msgid "Deselect all"
msgstr "Deseleccionar todo"

msgctxt "ui"
msgid "Selected shares: {}"
msgstr "Recursos seleccionados: {}"

msgctxt "ui"
msgid "Confirm scan"
msgstr "Confirmar análisis"

msgctxt "ui"
msgid "Back to the NAS server"
msgstr "Volver al servidor NAS"

msgctxt "ui"
msgid "Observed logical totals may include overlapping shares; they do not measure physical NAS usage."
msgstr "Los totales lógicos observados pueden incluir recursos solapados; no miden el uso físico del NAS."

msgctxt "ui"
msgid "No shares discovered yet. Find shares or choose Scan to prepare an operation."
msgstr "Aún no se han encontrado recursos. Busca recursos o elige Analizar para preparar una operación."

msgctxt "rust"
msgid "Shares completed: {} / {}"
msgstr "Recursos completados: {} / {}"

msgctxt "rust"
msgid "Waiting"
msgstr "En espera"

msgctxt "rust"
msgid "Scanning"
msgstr "Analizando"

msgctxt "rust"
msgid "Failed"
msgstr "Error"

msgctxt "rust"
msgid "Share discovery failed. Connect with Windows, then try again."
msgstr "Error al buscar recursos. Conecta con Windows y vuelve a intentarlo."

msgctxt "rust"
msgid "Discover shares explicitly before browsing this server."
msgstr "Busca los recursos explícitamente antes de explorar este servidor."

msgctxt "rust"
msgid "Share not inventoried. Click Scan to analyze this share."
msgstr "Recurso sin inventario. Pulsa Analizar para analizarlo."

msgctxt "ui"
msgid "Confirm disconnection"
msgstr "Confirmar desconexión"

msgctxt "ui"
msgid "Do you really want to disconnect the source {}?"
msgstr "¿Realmente desea desconectar la fuente {}?"

msgctxt "ui"
msgid "Known shares affected: {}. Newly discovered shares will also remain disconnected."
msgstr "Recursos compartidos conocidos afectados: {}. Los que se descubran después también permanecerán desconectados."

msgctxt "ui"
msgid "The current scan will be stopped and pending operations cancelled."
msgstr "Se detendrá el análisis actual y se cancelarán las operaciones pendientes."

msgctxt "ui"
msgid "This source will be excluded from future scans until you explicitly reconnect it. Saved inventories will be kept."
msgstr "Esta fuente se excluirá de futuros análisis hasta que la reconecte explícitamente. Los inventarios guardados se conservarán."

msgctxt "ui"
msgid "Also disconnect the network connection in Windows"
msgstr "Desconectar también la conexión de red en Windows"

msgctxt "ui"
msgid "Windows disconnection is unavailable for this source: its effects on other connections cannot be safely limited."
msgstr "La desconexión de Windows no está disponible para esta fuente: no se pueden limitar con seguridad sus efectos en otras conexiones."

msgctxt "ui"
msgid "Reconnect"
msgstr "Reconectar"

msgctxt "ui"
msgid "Disconnect"
msgstr "Desconectar"

msgctxt "rust"
msgid "Disconnected"
msgstr "Desconectado"

msgctxt "rust"
msgid "This source is disconnected. Open + Add a source > Disconnected sources and click Reconnect before scanning."
msgstr "Esta fuente está desconectada. Abra + Añadir una fuente > Fuentes desconectadas y pulse Reconectar antes de analizarla."

msgctxt "rust"
msgid "Source reconnected. Click Scan to start a new analysis."
msgstr "Fuente reconectada. Pulse Analizar para iniciar un nuevo análisis."

msgctxt "rust"
msgid "Source disconnected. Saving this state…"
msgstr "Fuente desconectada. Guardando este estado…"

msgctxt "rust"
msgid "Source disconnected and saved. Cancellation is requested; a pending system call may finish later."
msgstr "Fuente desconectada y guardada. Cancelación solicitada; una llamada del sistema pendiente puede finalizar más tarde."

msgctxt "rust"
msgid "Source disconnected for this session, but saving failed. Reconnect and retry before closing the application."
msgstr "Fuente desconectada en esta sesión, pero no se pudo guardar. Reconecte e inténtelo de nuevo antes de cerrar la aplicación."

msgctxt "rust"
msgid "Source disconnected in Bunny and Size. The Windows connection is still active."
msgstr "Fuente desconectada en Bunny and Size. La conexión de Windows sigue activa."

msgctxt "rust"
msgid "Source disconnected in Bunny and Size and Windows."
msgstr "Fuente desconectada en Bunny and Size y Windows."

msgctxt "ui"
msgid "Disconnected"
msgstr "Desconectado"

msgctxt "rust"
msgid "Disconnection failed. The source has not been changed."
msgstr "La desconexión falló. La fuente no se ha modificado."

msgctxt "rust"
msgid "The source state could not be saved. It may differ after restart."
msgstr "No se pudo guardar el estado de la fuente. Puede ser distinto al reiniciar."

msgctxt "rust"
msgid "Authentication required"
msgstr "Autenticación necesaria"

msgctxt "rust"
msgid "Connection cancelled"
msgstr "Conexión cancelada"

msgctxt "rust"
msgid "Windows session conflict"
msgstr "Conflicto de sesión de Windows"

msgctxt "rust"
msgid "Connection failed"
msgstr "Error de conexión"

msgctxt "rust"
msgid "A Windows source operation is already running. Wait for it to finish, then retry."
msgstr "Ya hay una operación de Windows sobre una fuente en curso. Espera a que termine y vuelve a intentarlo."

msgctxt "rust"
msgid "Open this source in Windows File Explorer, sign in there, then click Reconnect again. Existing Windows sessions are preserved."
msgstr "Abre esta fuente en el Explorador de archivos de Windows, inicia sesión allí y pulsa Reconectar de nuevo. Las sesiones de Windows existentes se conservan."

msgctxt "rust"
msgid "Checking access…"
msgstr "Comprobando el acceso…"

msgctxt "rust"
msgid "Disconnected deliberately"
msgstr "Desconectada voluntariamente"

msgctxt "ui"
msgid "Waiting for the Ubuntu connection…"
msgstr "Esperando la conexión de Ubuntu…"

msgctxt "ui"
msgid "Enter a server name, IP address or smb://server/, without a share."
msgstr "Introduzca un servidor, una IP o smb://servidor/, sin recurso compartido."

msgctxt "ui"
msgid "Invalid path. Use smb://server/share, a UNC share, or an existing native mount or folder."
msgstr "Ruta no válida. Use smb://servidor/recurso, un recurso UNC o un montaje o carpeta nativos existentes."

msgctxt "ui"
msgid "Server address accepted. Search for shares or enter smb://server/share before adding it."
msgstr "Dirección aceptada. Busque recursos o introduzca smb://servidor/recurso antes de añadirlo."

msgctxt "ui"
msgid "Server reachable, but no file shares could be listed. Enter smb://server/share manually."
msgstr "Servidor accesible, pero no se pudieron listar recursos. Introduzca smb://servidor/recurso manualmente."

msgctxt "ui"
msgid "Authentication required. Use Connect with Ubuntu, sign in through the Files application, then retry."
msgstr "Autenticación necesaria. Use Conectar con Ubuntu, inicie sesión en Archivos y reintente."

msgctxt "ui"
msgid "Credentials rejected by Ubuntu or the server. Check your account and try again."
msgstr "Ubuntu o el servidor rechazaron las credenciales. Compruebe su cuenta y reintente."

msgctxt "ui"
msgid "Ubuntu mount available for scanning. No scan has been started."
msgstr "Montaje de Ubuntu disponible para analizar. No se ha iniciado ningún análisis."

msgctxt "ui"
msgid "Shares could not be listed. Enter smb://server/share or an existing mount; connect in Files if needed."
msgstr "No se pudieron listar los recursos. Introduzca smb://servidor/recurso o un montaje existente; conecte en Archivos si es necesario."

msgctxt "ui"
msgid "Ubuntu SMB tools are unavailable. Connect to smb://server/share in Files, then choose its mounted folder."
msgstr "Herramientas SMB de Ubuntu no disponibles. Conecte a smb://servidor/recurso en Archivos y elija la carpeta montada."

msgctxt "ui"
msgid "Share listing denied. Connect with Ubuntu, then retry, or enter smb://server/share manually."
msgstr "Listado de recursos denegado. Conecte con Ubuntu y reintente, o introduzca smb://servidor/recurso manualmente."

msgctxt "ui"
msgid "Ubuntu connection requested. Finish signing in through Files, then retry. Scanning requires an accessible mounted folder."
msgstr "Conexión de Ubuntu solicitada. Complete el acceso en Archivos y reintente. El análisis requiere una carpeta montada accesible."

msgctxt "ui"
msgid "Server name, IP address or smb://server/share"
msgstr "Servidor, dirección IP o smb://servidor/recurso"

msgctxt "ui"
msgid "Enter a server name, IP or smb://server/share. An existing SMB mount can also be used."
msgstr "Introduzca un servidor, IP o smb://servidor/recurso. También puede usar un montaje SMB existente."

msgctxt "ui"
msgid "Connect with Ubuntu"
msgstr "Conectar con Ubuntu"

msgctxt "ui"
msgid "The share list is limited. You can also enter smb://server/share manually."
msgstr "La lista es limitada. También puede introducir smb://servidor/recurso manualmente."

msgctxt "ui"
msgid "Adding or connecting a source never starts a scan. Ubuntu handles credentials; Bunny and Size does not store passwords."
msgstr "Añadir o conectar una fuente nunca inicia un análisis. Ubuntu gestiona las credenciales; Bunny and Size no guarda contraseñas."

msgctxt "ui"
msgid "Also disconnect the mount in Ubuntu"
msgstr "Desconectar también el montaje en Ubuntu"

msgctxt "ui"
msgid "The system mount stays connected. Only an exact user mount can be safely disconnected here; other applications may use this mount."
msgstr "El montaje del sistema sigue conectado. Solo se puede desconectar de forma segura un montaje de usuario exacto; otras aplicaciones podrían usarlo."

msgctxt "rust"
msgid "Share discovery failed. Open the server in Files, then try again or enter a known share."
msgstr "Error al descubrir recursos. Abra el servidor en Archivos y reintente o introduzca un recurso conocido."

msgctxt "rust"
msgid "A desktop source operation is already running. Wait for it to finish, then retry."
msgstr "Ya hay una operación de fuente del escritorio en curso. Espere a que termine y reintente."

msgctxt "rust"
msgid "Open this source in Files, connect it there, then click Reconnect again. A usable native mount is required for scanning."
msgstr "Abra esta fuente en Archivos, conéctela y pulse Reconectar de nuevo. El análisis requiere un montaje nativo utilizable."

msgctxt "rust"
msgid "Source disconnected in Bunny and Size and Ubuntu."
msgstr "Fuente desconectada en Bunny and Size y Ubuntu."

msgctxt "rust"
msgid "Source disconnected in Bunny and Size. The Ubuntu mount is still active."
msgstr "Fuente desconectada en Bunny and Size. El montaje de Ubuntu sigue activo."

msgctxt "rust"
msgid "No accessible Ubuntu mount was found for this SMB share. Open it in Files, then click Reconnect. A successful connection does not start scanning."
msgstr "No se encontró ningún montaje de Ubuntu accesible para este recurso SMB. Ábralo en Archivos y pulse Reconectar. Una conexión correcta no inicia ningún análisis."

msgctxt "ui"
msgid "Source reconnected. No scan has been started."
msgstr "Fuente reconectada. No se ha iniciado ningún análisis."

msgctxt "ui"
msgid "Disconnected sources"
msgstr "Fuentes desconectadas"

msgctxt "ui"
msgid "Reconnect a source to restore it to the active lists. No scan will be started."
msgstr "Reconecte una fuente para restaurarla en las listas activas. No se iniciará ningún análisis."

msgctxt "ui"
msgid "No disconnected sources."
msgstr "No hay fuentes desconectadas."

msgctxt "ui"
msgid "This source was disconnected. Click Reconnect to restore it. No scan will be started."
msgstr "Esta fuente se ha desconectado. Pulse Reconectar para reactivarla. No se iniciará ningún análisis."

msgctxt "ui"
msgid "This share is unavailable because its NAS server is disconnected. Reconnect the server first; individually disconnected shares will stay disconnected."
msgstr "Este recurso compartido no está disponible porque su servidor NAS está desconectado. Reconecte primero el servidor; los recursos desconectados individualmente seguirán desconectados."

msgctxt "rust"
msgid "This share is unavailable because its NAS server is disconnected. Reconnect the server first; individually disconnected shares will stay disconnected."
msgstr "Este recurso compartido no está disponible porque su servidor NAS está desconectado. Reconecte primero el servidor; los recursos desconectados individualmente seguirán desconectados."

msgctxt "ui"
msgid "In one folder or drive"
msgstr "En una carpeta o unidad"

msgctxt "ui"
msgid "Between A and B"
msgstr "Entre A y B"

msgctxt "ui"
msgid "Duplicate search scope"
msgstr "Ámbito de búsqueda de duplicados"

msgctxt "ui"
msgid "Analyze A"
msgstr "Analizar A"

msgctxt "ui"
msgid "Analyze B"
msgstr "Analizar B"

msgctxt "ui"
msgid "Find duplicates (reads files)"
msgstr "Buscar duplicados (lee archivos)"

msgctxt "rust"
msgid "At most 16 session inventories are retained for comparison. Save further inventories to use them."
msgstr "Se conservan hasta 16 inventarios de sesión para comparar. Guarda los inventarios adicionales para utilizarlos."

msgctxt "rust"
msgid "Could not start search."
msgstr "No se pudo iniciar la búsqueda."

msgctxt "rust"
msgid "Disconnected by user"
msgstr "Desconectado por el usuario"

msgctxt "rust"
msgid "Effective duplicate budgets: {} bytes read; {} bytes per file; {} errors; {} bytes temporary state total; {} roots maximum."
msgstr "Límites efectivos de duplicados: {} bytes leídos; {} bytes por archivo; {} errores; {} bytes de estado temporal en total; {} raíces como máximo."

msgctxt "rust"
msgid "Possible source aliases remain unverified. Results are incomplete."
msgstr "Quedan posibles alias de origen sin verificar. Los resultados están incompletos."

msgctxt "rust"
msgid "Verified exact"
msgstr "Igualdad exacta verificada"

msgctxt "rust"
msgid "Another duplicate task is still closing. Retry shortly."
msgstr "Otra búsqueda de duplicados aún se está cerrando. Vuelve a intentarlo en breve."

msgctxt "rust"
msgid "Maximum pending duplicate tasks, including cancelled tasks awaiting the system: {}."
msgstr "Máximo de tareas de duplicados pendientes, incluidas las canceladas que esperan al sistema: {}."

msgctxt "rust"
msgid "Source continuity is unverified. Current file contents can be compared, but inventory coverage and independent copies are not proven."
msgstr "La continuidad del origen no está verificada. Se puede comparar el contenido actual de los archivos, pero no están demostradas la cobertura del inventario ni la independencia de las copias."

msgctxt "rust"
msgid "Group {} · location {} ·"
msgstr "Grupo {} · ubicación {} ·"

msgctxt "rust"
msgid "Unverified sources: {}."
msgstr "Orígenes sin verificar: {}."

msgctxt "rust"
msgid "This source differs from its recorded inventory. Analyze it separately before comparing."
msgstr "Este origen difiere de su inventario guardado. Analízalo por separado antes de comparar."

msgctxt "ui"
msgid "Folder or allowed root A"
msgstr "Carpeta o raíz autorizada A"

msgctxt "ui"
msgid "Folder or allowed root B"
msgstr "Carpeta o raíz autorizada B"

msgctxt "ui"
msgid "Cancellation requested. A system call already in progress may delay the stop."
msgstr "Cancelación solicitada. Una llamada al sistema en curso puede retrasar la detención."

msgctxt "rust"
msgid "Cancelling…"
msgstr "Cancelando…"

msgctxt "rust"
msgid "Inventory absent"
msgstr "Inventario ausente"

msgctxt "rust"
msgid "Inventory available"
msgstr "Inventario disponible"

msgctxt "rust"
msgid "Exact groups: {} · errors: {}."
msgstr "Grupos exactos: {} · errores: {}."

msgctxt "rust"
msgid "Verifying files…"
