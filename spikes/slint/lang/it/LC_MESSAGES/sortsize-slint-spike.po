msgstr "Andamento della dimensione logica"

msgctxt "rust"
msgid "No entries with a known logical size."
msgstr "Nessun elemento di dimensione logica nota."

msgctxt "rust"
msgid "No logical size changes in immediate folders."
msgstr "Nessuna variazione della dimensione logica nelle cartelle di primo livello."

msgctxt "rust"
msgid "Retained date"
msgstr "Data conservata"

msgctxt "rust"
msgid "The comparison needs two complete measures with known logical totals."
msgstr "Il confronto richiede due misure complete con totali logici noti."

msgctxt "rust"
msgid "The two scopes could not be matched."
msgstr "Impossibile associare i due ambiti."

msgctxt "rust"
msgid "Up to five increases and five decreases among immediate folders. Direct files also affect the total."
msgstr "Fino a cinque aumenti e cinque diminuzioni tra le cartelle di primo livello. Anche i file della radice incidono sul totale."

msgctxt "ui"
msgid "Compare retained dates"
msgstr "Confronta date conservate"

msgctxt "ui"
msgid "Dots show complete measurements. Axis marks show gaps. Dates and recorded values are listed below."
msgstr "I punti indicano misure complete. Le tacche sull’asse indicano lacune. Le date e i valori rilevati sono elencati sotto."

msgctxt "ui"
msgid "Keep another scan to compare two dates."
msgstr "Conserva un’altra scansione per confrontare due date."

msgctxt "ui"
msgid "Keep current scan as a dated measure"
msgstr "Conserva la scansione corrente come misura datata"

msgctxt "ui"
msgid "Keep each scan you want in the history. A new scan replaces the automatic entry for the same location."
msgstr "Conserva ogni scansione da aggiungere alla cronologia. Una nuova scansione sostituisce la voce automatica della stessa posizione."

msgctxt "ui"
msgid "Largest entries"
msgstr "Elementi più grandi"

msgctxt "ui"
msgid "Manage measures"
msgstr "Gestisci misure"

msgctxt "ui"
msgid "No retained dates yet."
msgstr "Nessuna data conservata per ora."

msgctxt "ui"
msgid "Other retained date for comparison"
msgstr "Altra data conservata per il confronto"

msgctxt "ui"
msgid "Show trend"
msgstr "Mostra andamento"

msgctxt "rust"
msgid "Saved measure deleted."
msgstr "Misura salvata eliminata."

msgctxt "rust"
msgid "Saved measure deleted. Journal update failed."
msgstr "Misura eliminata. Aggiornamento del registro non riuscito."

msgctxt "rust"
msgid "This measure shares storage with other records and cannot be deleted separately."
msgstr "Questa misura condivide l’archivio con altre registrazioni. L’eliminazione singola non è disponibile."

msgctxt "ui"
msgid "Delete measure"
msgstr "Elimina la misura"

msgctxt "ui"
msgid "Delete selected measure…"
msgstr "Elimina la misura selezionata…"

msgctxt "ui"
msgid "Permanently delete this saved measure?"
msgstr "Eliminare definitivamente questa misura salvata?"

msgctxt "ui"
msgid "Scanned files are kept."
msgstr "I file analizzati vengono conservati."

msgctxt "ui"
msgid "Could not show the item in the file manager."
msgstr "Impossibile mostrare l’elemento nel gestore file."

msgctxt "ui"
msgid "Open in File Manager"
msgstr "Apri nel gestore file"

msgctxt "ui"
msgid "Show in File Manager"
msgstr "Mostra nel gestore file"

msgctxt "ui"
msgid "Logical size of scanned files · {}"
msgstr "Dimensione logica dei file analizzati · {}"

msgctxt "rust"
msgid "Looking for shares on this server…"
msgstr "Ricerca delle condivisioni su questo server…"

msgctxt "rust"
msgid "Share discovery is limited or uncertain."
msgstr "Il rilevamento delle condivisioni è limitato o incerto."

msgctxt "rust"
msgid "Visible shares: {}"
msgstr "Condivisioni visibili: {}"

msgctxt "rust"
msgid "Shares disconnected in Bunny: {}"
msgstr "Condivisioni disconnesse in Bunny: {}"

msgctxt "rust"
msgid "Current scan"
msgstr "Analisi in corso"

msgctxt "rust"
msgid "Last scan"
msgstr "Ultima analisi"

msgctxt "rust"
msgid "Saved measures"
msgstr "Misurazioni salvate"

msgctxt "ui"
msgid "Disconnected in Bunny"
msgstr "Disconnessi in Bunny"

msgctxt "ui"
msgid "Reconnect {}"
msgstr "Riconnetti {}"
