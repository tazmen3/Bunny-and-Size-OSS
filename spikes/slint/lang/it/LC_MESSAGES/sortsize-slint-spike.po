msgstr "Attendere il termine dell’acquisizione in corso prima di verificare o riprendere."

msgctxt "rust"
msgid "The working folder is unavailable. Set BUNNY_AND_SIZE_STORE_DIR to an existing local folder and restart Bunny and Size."
msgstr "La cartella di lavoro non è disponibile. Imposta BUNNY_AND_SIZE_STORE_DIR su una cartella locale esistente e riavvia Bunny and Size."

msgctxt "ui"
msgid "Provisional"
msgstr "Provvisorio"

msgctxt "rust"
msgid "Loading…"
msgstr "Caricamento…"

msgctxt "rust"
msgid "Unresolved SID"
msgstr "SID non risolto"

msgctxt "rust"
msgid "Load more folders"
msgstr "Carica altre cartelle"

msgctxt "rust"
msgid "Previous folders"
msgstr "Cartelle precedenti"

msgctxt "rust"
msgid "Folder tree display limit reached. Collapse a branch to show more folders."
msgstr "Limite di visualizzazione dell’albero delle cartelle raggiunto. Comprimi un ramo per mostrare altre cartelle."

msgctxt "rust"
msgid "This folder could not be expanded within the tree budget."
msgstr "Non è stato possibile espandere questa cartella entro il limite di risorse dell’albero."

msgctxt "ui"
msgid "Navigation"
msgstr "Navigazione"

msgctxt "ui"
msgid "Extensions are not available yet. Local disks remain in Navigation."
msgstr "Le estensioni non sono ancora disponibili. I dischi locali restano in Navigazione."

msgctxt "ui"
msgid "KiB"
msgstr "KiB"

msgctxt "ui"
msgid "MiB"
msgstr "MiB"

msgctxt "ui"
msgid "GiB"
msgstr "GiB"

msgctxt "ui"
msgid "TiB"
msgstr "TiB"

msgctxt "ui"
msgid "kB"
msgstr "kB"

msgctxt "ui"
msgid "MB"
msgstr "MB"

msgctxt "ui"
msgid "GB"
msgstr "GB"

msgctxt "ui"
msgid "TB"
msgstr "TB"

msgctxt "ui"
msgid "Resolve local account names"
msgstr "Risolvi i nomi degli account locali"

msgctxt "ui"
msgid "Resolve account names from local files only; no network lookup"
msgstr "Risolvi i nomi degli account solo dai file locali; nessuna ricerca in rete"

msgctxt "ui"
msgid "Add a source"
msgstr "Aggiungi una sorgente"

msgctxt "ui"
msgid "+ Add a source"
msgstr "+ Aggiungi una sorgente"

msgctxt "ui"
msgid "SMB share"
msgstr "Condivisione SMB"

msgctxt "ui"
msgid "Existing NFS mount"
msgstr "Montaggio NFS esistente"

msgctxt "ui"
msgid "Local folder"
msgstr "Cartella locale"

msgctxt "ui"
msgid "Source type"
msgstr "Tipo di sorgente"

msgctxt "ui"
msgid "Native path"
msgstr "Percorso nativo"

msgctxt "ui"
msgid "Checking access…"
msgstr "Verifica dell’accesso…"

msgctxt "ui"
msgid "Accessible. No scan has been started."
msgstr "Accessibile. Nessuna analisi è stata avviata."

msgctxt "ui"
msgid "Unavailable. You can still add this source."
msgstr "Non disponibile. Puoi comunque aggiungere questa sorgente."

msgctxt "ui"
msgid "Access denied. Check permissions in your operating system."
msgstr "Accesso negato. Verifica i permessi nel sistema operativo."

msgctxt "ui"
msgid "Invalid path. Use a UNC share or an existing native mount or folder."
msgstr "Percorso non valido. Usa una condivisione UNC, un montaggio nativo o una cartella esistente."

msgctxt "ui"
msgid "Source added. Select it and start its scan explicitly."
msgstr "Sorgente aggiunta. Selezionala e avviane esplicitamente l’analisi."

msgctxt "ui"
msgid "Source added for this session; saving failed."
msgstr "Sorgente aggiunta per questa sessione; salvataggio non riuscito."

msgctxt "ui"
msgid "Access has not been checked."
msgstr "L’accesso non è stato verificato."

msgctxt "ui"
msgid "Choose an existing local folder."
msgstr "Scegli una cartella locale esistente."

msgctxt "ui"
msgid "Choose an existing system mount. The application does not mount network shares."
msgstr "Scegli un montaggio di sistema esistente. L’applicazione non monta condivisioni di rete."

msgctxt "ui"
msgid "Display name (optional)"
msgstr "Nome visualizzato (facoltativo)"

msgctxt "ui"
msgid "Adding a source never starts a scan. No password is requested or stored."
msgstr "L’aggiunta di una sorgente non avvia mai un’analisi. Nessuna password viene richiesta o salvata."

msgctxt "ui"
msgid "Check access"
msgstr "Verifica accesso"

msgctxt "ui"
msgid "Add source"
msgstr "Aggiungi sorgente"

msgctxt "ui"
msgid "Query capacities"
msgstr "Interroga capacità"

msgctxt "ui"
msgid "Select source: {}"
msgstr "Seleziona sorgente: {}"

msgctxt "ui"
msgid "Looking for shares on this server…"
msgstr "Ricerca delle condivisioni su questo server…"

msgctxt "ui"
msgid "Waiting for the Windows connection…"
msgstr "Connessione Windows in corso…"

msgctxt "ui"
msgid "Server address accepted. Search for shares or enter a full UNC share path before adding it."
msgstr "Indirizzo del server accettato. Cerca le condivisioni o inserisci un percorso UNC completo prima di aggiungerlo."

msgctxt "ui"
msgid "Server unavailable. Check its address and network connection, then try again."
msgstr "Server non disponibile. Verifica l’indirizzo e la connessione di rete, poi riprova."

msgctxt "ui"
msgid "Server reachable, but no file shares could be listed. Enter the full UNC path manually."
msgstr "Server raggiungibile, ma nessuna condivisione di file elencabile. Inserisci manualmente il percorso UNC completo."

msgctxt "ui"
msgid "Authentication required. Use Connect with Windows, or establish this connection in Windows Explorer, then retry."
msgstr "Autenticazione richiesta. Usa Connetti con Windows oppure stabilisci la connessione in Esplora file di Windows, poi riprova."

msgctxt "ui"
msgid "Credentials rejected by Windows or the server. Check your account and try again."
msgstr "Credenziali rifiutate da Windows o dal server. Verifica il tuo account e riprova."

msgctxt "ui"
msgid "Share not found. Check its name or search the server's shares again."
msgstr "Condivisione inesistente. Verifica il nome o cerca di nuovo le condivisioni del server."

msgctxt "ui"
msgid "Windows connection established. No scan has been started."
msgstr "Connessione Windows stabilita. Nessuna analisi è stata avviata."

msgctxt "ui"
msgid "Operation cancelled. No scan has been started."
msgstr "Operazione annullata. Nessuna analisi è stata avviata."

msgctxt "ui"
msgid "Windows session conflict (1219). A connection using another account already exists. Existing connections have been kept."
msgstr "Conflitto di sessione Windows (1219). Esiste già una connessione con un altro account. Le connessioni esistenti sono state mantenute."

msgctxt "ui"
msgid "Shares could not be listed. Enter a full UNC share path manually; connect to it in Windows Explorer if necessary, then retry."
msgstr "Impossibile elencare le condivisioni. Inserisci un percorso UNC completo; se necessario, connettiti in Esplora file di Windows e riprova."

msgctxt "ui"
msgid "Native SMB discovery and sign-in are available on Windows. Use an existing system mount on this platform."
msgstr "Ricerca e autenticazione SMB native disponibili su Windows. Su questa piattaforma, usa un montaggio di sistema esistente."

msgctxt "ui"
msgid "Server or share"
msgstr "Server o condivisione"

msgctxt "ui"
msgid "Server name, IP address or full UNC share"
msgstr "Nome del server, indirizzo IP o condivisione UNC completa"

msgctxt "ui"
msgid "Enter a server name or IP, then search its shares; or enter a full UNC share path."
msgstr "Inserisci il nome o l’IP del server e cerca le condivisioni; oppure inserisci un percorso UNC completo."

msgctxt "ui"
msgid "Find shares"
msgstr "Cerca condivisioni"

msgctxt "ui"
msgid "Connect with Windows"
msgstr "Connetti con Windows"

msgctxt "ui"
msgid "Shares on this server"
msgstr "Condivisioni su questo server"

msgctxt "ui"
msgid "Adding or connecting a source never starts a scan. Windows handles credentials; Bunny and Size does not store passwords."
msgstr "Aggiungere o connettere una sorgente non avvia mai un’analisi. Windows gestisce le credenziali; Bunny and Size non salva password."

msgctxt "ui"
msgid "The share list is limited. You can also enter a full UNC share path manually."
msgstr "L’elenco delle condivisioni è limitato. Puoi anche inserire manualmente un percorso UNC completo."

msgctxt "ui"
msgid "Select a share from the list, then add it. No scan has been started."
msgstr "Seleziona una condivisione dall’elenco e aggiungila. Nessuna analisi è stata avviata."

msgctxt "ui"
msgid "Share listing denied. Use Connect with Windows, then retry, or enter a full UNC share path manually."
msgstr "Elenco delle condivisioni negato. Usa Connetti con Windows e riprova, oppure inserisci manualmente un percorso UNC completo."

msgctxt "ui"
msgid "Complete SMB NAS server"
msgstr "Server NAS SMB completo"

msgctxt "ui"
msgid "Enter a server name, IP address or UNC server root, without a share."
msgstr "Inserisci un nome server, un indirizzo IP o la radice UNC del server, senza condivisione."

msgctxt "ui"
msgid "Server source ready to add, including offline. Scan its selected shares later with Scan."
msgstr "Server pronto da aggiungere, anche offline. Analizza poi le condivisioni scelte con Analizza."

msgctxt "ui"
msgid "Add the server as a logical source. No share discovery or scan is required to save it."
msgstr "Aggiungi il server come origine logica. Per salvarlo non occorre cercare condivisioni o avviare analisi."

msgctxt "ui"
msgid "Confirm server scan"
msgstr "Conferma analisi del server"

msgctxt "ui"
msgid "Choose the shares for this operation. New shares will not be added during the scan."
msgstr "Scegli le condivisioni per questa operazione. Non ne verranno aggiunte altre durante l’analisi."

msgctxt "ui"
msgid "A server scan may process large amounts of data. You can cancel it."
msgstr "L’analisi di un server può elaborare grandi quantità di dati. Puoi annullarla."

msgctxt "ui"
msgid "Totals are observed logical sizes, not physical NAS usage. Shares can overlap and count the same data more than once."
msgstr "I totali sono dimensioni logiche osservate, non l’occupazione fisica del NAS. Le condivisioni possono sovrapporsi e contare più volte gli stessi dati."

msgctxt "ui"
msgid "Share discovery is limited or uncertain. The server coverage will remain partial or unknown."
msgstr "La ricerca delle condivisioni è limitata o incerta. La copertura del server resterà parziale o sconosciuta."

msgctxt "ui"
msgid "Select all"
msgstr "Seleziona tutto"

msgctxt "ui"
msgid "Deselect all"
msgstr "Deseleziona tutto"

msgctxt "ui"
msgid "Selected shares: {}"
msgstr "Condivisioni selezionate: {}"

msgctxt "ui"
msgid "Confirm scan"
msgstr "Conferma analisi"

msgctxt "ui"
msgid "Back to the NAS server"
msgstr "Torna al server NAS"

msgctxt "ui"
msgid "Observed logical totals may include overlapping shares; they do not measure physical NAS usage."
msgstr "I totali logici osservati possono includere condivisioni sovrapposte; non misurano l’occupazione fisica del NAS."

msgctxt "ui"
msgid "No shares discovered yet. Find shares or choose Scan to prepare an operation."
msgstr "Nessuna condivisione trovata. Cerca condivisioni o scegli Analizza per preparare un’operazione."

msgctxt "rust"
msgid "Shares completed: {} / {}"
msgstr "Condivisioni completate: {} / {}"

msgctxt "rust"
msgid "Waiting"
msgstr "In attesa"

msgctxt "rust"
msgid "Scanning"
msgstr "Analisi in corso"

msgctxt "rust"
msgid "Failed"
msgstr "Non riuscito"

msgctxt "rust"
msgid "Share discovery failed. Connect with Windows, then try again."
msgstr "Ricerca delle condivisioni non riuscita. Connettiti con Windows e riprova."

msgctxt "rust"
msgid "Discover shares explicitly before browsing this server."
msgstr "Cerca esplicitamente le condivisioni prima di esplorare questo server."

msgctxt "rust"
msgid "Share not inventoried. Click Scan to analyze this share."
msgstr "Condivisione non inventariata. Fai clic su Analizza per analizzarla."

msgctxt "ui"
msgid "Confirm disconnection"
msgstr "Conferma disconnessione"

msgctxt "ui"
msgid "Do you really want to disconnect the source {}?"
msgstr "Vuoi davvero disconnettere la sorgente {}?"

msgctxt "ui"
msgid "Known shares affected: {}. Newly discovered shares will also remain disconnected."
msgstr "Condivisioni note interessate: {}. Anche le condivisioni scoperte in seguito resteranno disconnesse."

msgctxt "ui"
msgid "The current scan will be stopped and pending operations cancelled."
msgstr "L’analisi in corso verrà interrotta e le operazioni in attesa annullate."

msgctxt "ui"
msgid "This source will be excluded from future scans until you explicitly reconnect it. Saved inventories will be kept."
msgstr "Questa sorgente sarà esclusa dalle analisi future finché non la riconnetterai esplicitamente. Gli inventari salvati saranno conservati."

msgctxt "ui"
msgid "Also disconnect the network connection in Windows"
msgstr "Disconnetti anche la connessione di rete in Windows"

msgctxt "ui"
msgid "Windows disconnection is unavailable for this source: its effects on other connections cannot be safely limited."
msgstr "La disconnessione Windows non è disponibile per questa sorgente: non è possibile limitarne in sicurezza gli effetti su altre connessioni."

msgctxt "ui"
msgid "Reconnect"
msgstr "Riconnetti"

msgctxt "ui"
msgid "Disconnect"
msgstr "Disconnetti"

msgctxt "rust"
msgid "Disconnected"
msgstr "Disconnesso"

msgctxt "rust"
msgid "This source is disconnected. Open + Add a source > Disconnected sources and click Reconnect before scanning."
msgstr "Questa sorgente è disconnessa. Apri + Aggiungi una sorgente > Sorgenti disconnesse e fai clic su Riconnetti prima della scansione."

msgctxt "rust"
msgid "Source reconnected. Click Scan to start a new analysis."
msgstr "Sorgente riconnessa. Fai clic su Analizza per avviare una nuova analisi."

msgctxt "rust"
msgid "Source disconnected. Saving this state…"
msgstr "Sorgente disconnessa. Salvataggio dello stato…"

msgctxt "rust"
msgid "Source disconnected and saved. Cancellation is requested; a pending system call may finish later."
msgstr "Sorgente disconnessa e stato salvato. Annullamento richiesto; una chiamata di sistema in attesa può terminare in seguito."

msgctxt "rust"
msgid "Source disconnected for this session, but saving failed. Reconnect and retry before closing the application."
msgstr "Sorgente disconnessa per questa sessione, ma il salvataggio non è riuscito. Riconnetti e riprova prima di chiudere l’applicazione."

msgctxt "rust"
msgid "Source disconnected in Bunny and Size. The Windows connection is still active."
msgstr "Sorgente disconnessa in Bunny and Size. La connessione Windows è ancora attiva."

msgctxt "rust"
msgid "Source disconnected in Bunny and Size and Windows."
msgstr "Sorgente disconnessa in Bunny and Size e Windows."

msgctxt "ui"
msgid "Disconnected"
msgstr "Disconnesso"

msgctxt "rust"
msgid "Disconnection failed. The source has not been changed."
msgstr "Disconnessione non riuscita. La sorgente non è stata modificata."

msgctxt "rust"
msgid "The source state could not be saved. It may differ after restart."
msgstr "Non è stato possibile salvare lo stato della sorgente. Potrebbe essere diverso dopo il riavvio."

msgctxt "rust"
msgid "Authentication required"
msgstr "Autenticazione necessaria"

msgctxt "rust"
msgid "Connection cancelled"
msgstr "Connessione annullata"

msgctxt "rust"
msgid "Windows session conflict"
msgstr "Conflitto di sessione Windows"

msgctxt "rust"
msgid "Connection failed"
msgstr "Connessione non riuscita"

msgctxt "rust"
msgid "A Windows source operation is already running. Wait for it to finish, then retry."
msgstr "È già in corso un’operazione Windows su una sorgente. Attendi che termini, quindi riprova."

msgctxt "rust"
msgid "Open this source in Windows File Explorer, sign in there, then click Reconnect again. Existing Windows sessions are preserved."
msgstr "Apri questa sorgente in Esplora file di Windows, accedi e fai di nuovo clic su Riconnetti. Le sessioni Windows esistenti vengono mantenute."

msgctxt "rust"
msgid "Checking access…"
msgstr "Verifica dell’accesso…"

msgctxt "rust"
msgid "Disconnected deliberately"
msgstr "Disconnessa volontariamente"

msgctxt "ui"
msgid "Waiting for the Ubuntu connection…"
msgstr "In attesa della connessione Ubuntu…"

msgctxt "ui"
msgid "Enter a server name, IP address or smb://server/, without a share."
msgstr "Inserisci un server, un indirizzo IP o smb://server/, senza condivisione."

msgctxt "ui"
msgid "Invalid path. Use smb://server/share, a UNC share, or an existing native mount or folder."
msgstr "Percorso non valido. Usa smb://server/condivisione, una condivisione UNC o un punto di montaggio o una cartella nativi esistenti."

msgctxt "ui"
msgid "Server address accepted. Search for shares or enter smb://server/share before adding it."
msgstr "Indirizzo accettato. Cerca le condivisioni o inserisci smb://server/condivisione prima di aggiungere."

msgctxt "ui"
msgid "Server reachable, but no file shares could be listed. Enter smb://server/share manually."
msgstr "Server raggiungibile, ma impossibile elencare le condivisioni. Inserisci smb://server/condivisione manualmente."

msgctxt "ui"
msgid "Authentication required. Use Connect with Ubuntu, sign in through the Files application, then retry."
msgstr "Autenticazione richiesta. Usa Connetti con Ubuntu, accedi tramite File e riprova."

msgctxt "ui"
msgid "Credentials rejected by Ubuntu or the server. Check your account and try again."
msgstr "Credenziali rifiutate da Ubuntu o dal server. Controlla l’account e riprova."

msgctxt "ui"
msgid "Ubuntu mount available for scanning. No scan has been started."
msgstr "Montaggio Ubuntu disponibile per l’analisi. Nessuna analisi avviata."

msgctxt "ui"
msgid "Shares could not be listed. Enter smb://server/share or an existing mount; connect in Files if needed."
msgstr "Impossibile elencare le condivisioni. Inserisci smb://server/condivisione o un montaggio esistente; connettiti in File se necessario."

msgctxt "ui"
msgid "Ubuntu SMB tools are unavailable. Connect to smb://server/share in Files, then choose its mounted folder."
msgstr "Strumenti SMB Ubuntu non disponibili. Connettiti a smb://server/condivisione in File e scegli la cartella montata."

msgctxt "ui"
msgid "Share listing denied. Connect with Ubuntu, then retry, or enter smb://server/share manually."
msgstr "Elenco condivisioni negato. Connettiti con Ubuntu e riprova o inserisci smb://server/condivisione manualmente."

msgctxt "ui"
msgid "Ubuntu connection requested. Finish signing in through Files, then retry. Scanning requires an accessible mounted folder."
msgstr "Connessione Ubuntu richiesta. Completa l’accesso in File e riprova. L’analisi richiede una cartella montata accessibile."

msgctxt "ui"
msgid "Server name, IP address or smb://server/share"
msgstr "Server, indirizzo IP o smb://server/condivisione"

msgctxt "ui"
msgid "Enter a server name, IP or smb://server/share. An existing SMB mount can also be used."
msgstr "Inserisci un server, IP o smb://server/condivisione. Puoi usare anche un montaggio SMB esistente."

msgctxt "ui"
msgid "Connect with Ubuntu"
msgstr "Connetti con Ubuntu"

msgctxt "ui"
msgid "The share list is limited. You can also enter smb://server/share manually."
msgstr "L’elenco è limitato. Puoi anche inserire smb://server/condivisione manualmente."

msgctxt "ui"
msgid "Adding or connecting a source never starts a scan. Ubuntu handles credentials; Bunny and Size does not store passwords."
msgstr "Aggiungere o connettere una sorgente non avvia mai un’analisi. Ubuntu gestisce le credenziali; Bunny and Size non salva password."

msgctxt "ui"
msgid "Also disconnect the mount in Ubuntu"
msgstr "Disconnetti anche il montaggio in Ubuntu"

msgctxt "ui"
msgid "The system mount stays connected. Only an exact user mount can be safely disconnected here; other applications may use this mount."
msgstr "Il montaggio di sistema resta connesso. Solo un montaggio utente identificato esattamente può essere disconnesso in sicurezza qui; altre applicazioni potrebbero usarlo."

msgctxt "rust"
msgid "Share discovery failed. Open the server in Files, then try again or enter a known share."
msgstr "Ricerca condivisioni non riuscita. Apri il server in File e riprova o inserisci una condivisione nota."

msgctxt "rust"
msgid "A desktop source operation is already running. Wait for it to finish, then retry."
msgstr "È già in corso un’operazione sulla sorgente del desktop. Attendi il termine e riprova."

msgctxt "rust"
msgid "Open this source in Files, connect it there, then click Reconnect again. A usable native mount is required for scanning."
msgstr "Apri questa sorgente in File, connettila e fai di nuovo clic su Riconnetti. L’analisi richiede un montaggio nativo utilizzabile."

msgctxt "rust"
msgid "Source disconnected in Bunny and Size and Ubuntu."
msgstr "Sorgente disconnessa in Bunny and Size e Ubuntu."

msgctxt "rust"
msgid "Source disconnected in Bunny and Size. The Ubuntu mount is still active."
msgstr "Sorgente disconnessa in Bunny and Size. Il montaggio Ubuntu resta attivo."

msgctxt "rust"
msgid "No accessible Ubuntu mount was found for this SMB share. Open it in Files, then click Reconnect. A successful connection does not start scanning."
msgstr "Non è stato trovato alcun punto di montaggio Ubuntu accessibile per questa condivisione SMB. Aprirla in File, poi fare clic su Riconnetti. Una connessione riuscita non avvia alcuna scansione."

msgctxt "ui"
msgid "Source reconnected. No scan has been started."
msgstr "Sorgente riconnessa. Nessuna scansione avviata."

msgctxt "ui"
msgid "Disconnected sources"
msgstr "Sorgenti disconnesse"

msgctxt "ui"
msgid "Reconnect a source to restore it to the active lists. No scan will be started."
msgstr "Riconnetti una sorgente per ripristinarla negli elenchi attivi. Nessuna scansione verrà avviata."

msgctxt "ui"
msgid "No disconnected sources."
msgstr "Nessuna sorgente disconnessa."

msgctxt "ui"
msgid "This source was disconnected. Click Reconnect to restore it. No scan will be started."
msgstr "Questa sorgente è stata disconnessa. Fai clic su Riconnetti per riattivarla. Non verrà avviata alcuna scansione."

msgctxt "ui"
msgid "This share is unavailable because its NAS server is disconnected. Reconnect the server first; individually disconnected shares will stay disconnected."
msgstr "Questa condivisione non è disponibile perché il server NAS è disconnesso. Riconnetti prima il server; le condivisioni disconnesse singolarmente rimarranno disconnesse."

msgctxt "rust"
msgid "This share is unavailable because its NAS server is disconnected. Reconnect the server first; individually disconnected shares will stay disconnected."
msgstr "Questa condivisione non è disponibile perché il server NAS è disconnesso. Riconnetti prima il server; le condivisioni disconnesse singolarmente rimarranno disconnesse."

msgctxt "ui"
msgid "In one folder or drive"
msgstr "In una cartella o unità"

msgctxt "ui"
msgid "Between A and B"
msgstr "Tra A e B"

msgctxt "ui"
msgid "Duplicate search scope"
msgstr "Ambito di ricerca dei duplicati"

msgctxt "ui"
msgid "Analyze A"
msgstr "Analizza A"

msgctxt "ui"
msgid "Analyze B"
msgstr "Analizza B"

msgctxt "ui"
msgid "Find duplicates (reads files)"
msgstr "Cerca duplicati (legge i file)"

msgctxt "rust"
msgid "At most 16 session inventories are retained for comparison. Save further inventories to use them."
msgstr "Per il confronto vengono conservati al massimo 16 inventari di sessione. Salva gli inventari aggiuntivi per utilizzarli."

msgctxt "rust"
msgid "Could not start search."
msgstr "Impossibile avviare la ricerca."

msgctxt "rust"
msgid "Disconnected by user"
msgstr "Disconnesso dall’utente"

msgctxt "rust"
msgid "Effective duplicate budgets: {} bytes read; {} bytes per file; {} errors; {} bytes temporary state total; {} roots maximum."
msgstr "Limiti effettivi dei duplicati: {} byte letti; {} byte per file; {} errori; {} byte totali di stato temporaneo; massimo {} radici."

msgctxt "rust"
msgid "Possible source aliases remain unverified. Results are incomplete."
msgstr "Restano possibili alias delle origini non verificati. I risultati sono incompleti."

msgctxt "rust"
msgid "Verified exact"
msgstr "Uguaglianza esatta verificata"

msgctxt "rust"
msgid "Another duplicate task is still closing. Retry shortly."
msgstr "Un’altra ricerca di duplicati è ancora in chiusura. Riprova tra poco."

msgctxt "rust"
msgid "Maximum pending duplicate tasks, including cancelled tasks awaiting the system: {}."
msgstr "Numero massimo di ricerche di duplicati in sospeso, incluse quelle annullate in attesa del sistema: {}."

msgctxt "rust"
msgid "Source continuity is unverified. Current file contents can be compared, but inventory coverage and independent copies are not proven."
msgstr "La continuità dell’origine non è verificata. È possibile confrontare il contenuto attuale dei file, ma la copertura dell’inventario e l’indipendenza delle copie non sono dimostrate."

msgctxt "rust"
msgid "Group {} · location {} ·"
msgstr "Gruppo {} · posizione {} ·"

msgctxt "rust"
msgid "Unverified sources: {}."
msgstr "Origini non verificate: {}."

msgctxt "rust"
msgid "This source differs from its recorded inventory. Analyze it separately before comparing."
msgstr "Questa origine è diversa dall’inventario registrato. Analizzala separatamente prima del confronto."

msgctxt "ui"
msgid "Folder or allowed root A"
msgstr "Cartella o radice autorizzata A"

msgctxt "ui"
msgid "Folder or allowed root B"
msgstr "Cartella o radice autorizzata B"

msgctxt "ui"
msgid "Cancellation requested. A system call already in progress may delay the stop."
msgstr "Annullamento richiesto. Una chiamata di sistema già in corso può ritardare l’arresto."

msgctxt "rust"
msgid "Cancelling…"
msgstr "Annullamento…"

msgctxt "rust"
msgid "Inventory absent"
